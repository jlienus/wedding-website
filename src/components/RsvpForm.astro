---
import config from '../data/wedding.config.json';
import { t, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;

const deadlineDisplay = locale === 'es' ? config.rsvp.deadlineDisplayEs : config.rsvp.deadlineDisplayEn;
const guestDeadlineISO = '2026-11-15T23:59:59-05:00';
const permanentLockISO = '2027-01-15T23:59:59-05:00';

const mealOptions = [
  { value: '', labelKey: 'rsvp.mealNone' },
  { value: 'chicken', labelKey: 'rsvp.mealChicken' },
  { value: 'beef', labelKey: 'rsvp.mealBeef' }
];

const entradaOptions = [
  { value: '', labelKey: 'rsvp.entradaNone' },
  { value: 'salpicon', labelKey: 'rsvp.entradaSalpicon' },
  { value: 'hojaldre', labelKey: 'rsvp.entradaHojaldre' },
  { value: 'causa', labelKey: 'rsvp.entradaCausa' }
];

const sorbetOptions = [
  { value: '', labelKey: 'rsvp.sorbetNone' },
  { value: 'maracuya', labelKey: 'rsvp.sorbetMaracuya' },
  { value: 'mandarina', labelKey: 'rsvp.sorbetMandarina' }
];

const postreOptions = [
  { value: '', labelKey: 'rsvp.postreNone' },
  { value: 'chocolate', labelKey: 'rsvp.postreChocolate' },
  { value: 'cheesecake', labelKey: 'rsvp.postreCheesecake' },
  { value: 'tiramisu', labelKey: 'rsvp.postreTiramisu' }
];

const stringKeys = [
  'rsvp.loading','rsvp.lookupTitle','rsvp.lookupHint','rsvp.lastNameLabel',
  'rsvp.findMe','rsvp.lookingUp',
  'rsvp.lookupNotFound','rsvp.lookupAmbiguous','rsvp.lookupRateLimited','rsvp.lookupNameTooShort','rsvp.lookupError',
  'rsvp.phoneLast4Label','rsvp.phoneLast4Hint','rsvp.phoneLast4Mismatch','rsvp.phoneLast4Invalid',
  'rsvp.lookupByPhoneLink','rsvp.phoneLookupTitle','rsvp.phoneLookupHint',
  'rsvp.phoneLabel','rsvp.phonePlaceholder','rsvp.phoneInvalid','rsvp.phoneNotFound','rsvp.phoneAmbiguous',
  'rsvp.backToNameLookup',
  'rsvp.formIntro','rsvp.formHelloPrefix','rsvp.notYou','rsvp.save','rsvp.saving',
  'rsvp.primaryYourRsvp','rsvp.additionalGuestsTitle','rsvp.additionalGuestsHint',
  'rsvp.previouslyDeclinedHint',
  'rsvp.addGuest','rsvp.removeGuest','rsvp.maxGuestsReached',
  'rsvp.guestNameLabel','rsvp.guestNamePlaceholder','rsvp.isKidLabel',
  'rsvp.attendingQuestion','rsvp.attendingYes','rsvp.attendingNo',
  'rsvp.mealLabel','rsvp.mealHint','rsvp.mealNone',
  'rsvp.mealChicken','rsvp.mealBeef',
  'rsvp.menuHeading','rsvp.menuHint',
  'rsvp.entradaLabel','rsvp.entradaNone',
  'rsvp.entradaSalpicon','rsvp.entradaHojaldre','rsvp.entradaCausa',
  'rsvp.sorbetLabel','rsvp.sorbetNone',
  'rsvp.sorbetMaracuya','rsvp.sorbetMandarina',
  'rsvp.postreLabel','rsvp.postreNone',
  'rsvp.postreChocolate','rsvp.postreCheesecake','rsvp.postreTiramisu',
  'rsvp.dietaryLabel','rsvp.dietaryPlaceholder','rsvp.songLabel','rsvp.songPlaceholder',
  'rsvp.notesLabel','rsvp.notesPlaceholder',
  'rsvp.submitError','rsvp.submitRateLimited','rsvp.submitClosed','rsvp.lateNotice',
  'rsvp.attendingAllRequired','rsvp.guestNameRequired',
  'rsvp.thanks','rsvp.thanksAttending','rsvp.thanksNotAttending','rsvp.thanksMixed','rsvp.edit',
  'rsvp.magicOk','rsvp.magicInvalid','rsvp.magicError','rsvp.magicMissing',
  'rsvp.privacySummary','rsvp.privacyBody','rsvp.heading'
];
const strings: Record<string, string> = {};
for (const k of stringKeys) {
  strings[k] = t(locale, k);
}

const initData = {
  locale,
  deadlineDisplay,
  guestDeadlineISO,
  permanentLockISO,
  maxAdditionalGuests: 20,
  entradaOptions: entradaOptions.map(o => ({ value: o.value, label: t(locale, o.labelKey) })),
  sorbetOptions: sorbetOptions.map(o => ({ value: o.value, label: t(locale, o.labelKey) })),
  mealOptions: mealOptions.map(o => ({ value: o.value, label: t(locale, o.labelKey) })),
  postreOptions: postreOptions.map(o => ({ value: o.value, label: t(locale, o.labelKey) })),
  strings
};
---

<section class="rsvp-form-wrap reveal" aria-labelledby="rsvp-form-heading">
  <h2 id="rsvp-form-heading" class="visually-hidden">{t(locale, 'rsvp.heading')}</h2>

  <div id="rsvp-magic-banner" class="rsvp-banner" role="status" aria-live="polite" hidden></div>

  <div id="rsvp-loading" class="rsvp-phase rsvp-phase--loading" role="status" aria-live="polite">
    <div class="rsvp-loader">
      <div class="rsvp-loader__orbit" aria-hidden="true">
        <span class="rsvp-loader__ring"></span>
        <span class="rsvp-loader__mark">✦</span>
      </div>
      <p class="rsvp-loader__text">{t(locale, 'rsvp.loading')}</p>
    </div>
  </div>

  <form id="rsvp-lookup-form" class="rsvp-phase rsvp-lookup" hidden novalidate>
    <h3 id="rsvp-lookup-heading">{t(locale, 'rsvp.lookupTitle')}</h3>
    <p class="rsvp-muted" id="rsvp-lookup-hint">{t(locale, 'rsvp.lookupHint')}</p>

    <div id="rsvp-lookup-name-fields" class="rsvp-fields">
      <label>
        <span class="rsvp-label">{t(locale, 'rsvp.lastNameLabel')}</span>
        <input name="lastName" type="text" required minlength="2" maxlength="50" autocomplete="family-name" />
      </label>
      <label id="rsvp-phone-last4-row" hidden>
        <span class="rsvp-label">{t(locale, 'rsvp.phoneLast4Label')}</span>
        <input name="phoneLast4" type="text" inputmode="numeric" pattern="[0-9]{4}" maxlength="4" autocomplete="off" />
        <small class="rsvp-muted">{t(locale, 'rsvp.phoneLast4Hint')}</small>
      </label>
    </div>

    <div id="rsvp-lookup-phone-fields" class="rsvp-fields" hidden>
      <label>
        <span class="rsvp-label">{t(locale, 'rsvp.phoneLabel')}</span>
        <input name="phone" type="tel" inputmode="tel" maxlength="20" autocomplete="tel" placeholder={t(locale, 'rsvp.phonePlaceholder')} />
      </label>
    </div>

    <div class="rsvp-actions">
      <button type="submit" class="btn btn--gold" data-label-default={t(locale, 'rsvp.findMe')} data-label-busy={t(locale, 'rsvp.lookingUp')}>{t(locale, 'rsvp.findMe')}</button>
    </div>
    <div id="rsvp-lookup-error" class="rsvp-error" role="alert" aria-live="polite" hidden></div>
    <div class="rsvp-lookup-toggle">
      <button type="button" id="rsvp-lookup-toggle-btn" class="rsvp-link">{t(locale, 'rsvp.lookupByPhoneLink')}</button>
    </div>
  </form>

  <form id="rsvp-form" class="rsvp-phase rsvp-form" hidden novalidate>
    <div class="rsvp-form-header">
      <h3 id="rsvp-greeting"></h3>
      <p class="rsvp-muted">{t(locale, 'rsvp.formIntro')}</p>
      <button type="button" id="rsvp-not-you" class="rsvp-link">{t(locale, 'rsvp.notYou')}</button>
    </div>

    <h4 class="rsvp-section-heading" data-bind="primaryYourRsvp"></h4>
    <div id="rsvp-primary-card"></div>

    <div class="rsvp-additional">
      <div class="rsvp-additional-header">
        <h4 class="rsvp-section-heading">{t(locale, 'rsvp.additionalGuestsTitle')}</h4>
        <p class="rsvp-muted rsvp-additional-hint">{t(locale, 'rsvp.additionalGuestsHint')}</p>
      </div>
      <div id="rsvp-guests" class="rsvp-guests"></div>
      <p id="rsvp-declined-hint" class="rsvp-muted rsvp-declined-hint" hidden>{t(locale, 'rsvp.previouslyDeclinedHint')}</p>
      <div class="rsvp-add-guest-row">
        <button type="button" id="rsvp-add-guest" class="btn btn--ghost btn--small">
          + <span data-bind="addGuest"></span>
        </button>
        <span id="rsvp-add-guest-hint" class="rsvp-muted rsvp-add-guest-hint" hidden></span>
      </div>
    </div>

    <details class="rsvp-privacy">
      <summary>{t(locale, 'rsvp.privacySummary')}</summary>
      <p>{t(locale, 'rsvp.privacyBody')}</p>
    </details>
    <div class="rsvp-actions">
      <button type="submit" class="btn btn--gold" data-label-default={t(locale, 'rsvp.save')} data-label-busy={t(locale, 'rsvp.saving')}>{t(locale, 'rsvp.save')}</button>
    </div>
    <div id="rsvp-submit-error" class="rsvp-error" role="alert" aria-live="polite" hidden></div>
  </form>

  <div id="rsvp-confirmation" class="rsvp-phase rsvp-confirmation" hidden>
    <div class="rsvp-confirm-card">
      <h3>{t(locale, 'rsvp.thanks')}</h3>
      <div class="rsvp-confirm-flourish" aria-hidden="true">
        <span></span><strong>✦</strong><span></span>
      </div>
      <p id="rsvp-confirm-summary"></p>
      <div class="rsvp-actions">
        <button type="button" id="rsvp-edit" class="btn btn--ghost">{t(locale, 'rsvp.edit')}</button>
      </div>
    </div>
  </div>

  <!--
    Template for the attendee card (used for both primary and additional guests).
    Field visibility is toggled at render time:
      - Primary cards hide the .guest-name-row and .guest-remove-row.
      - Additional-guest cards hide .rsvp-attending (no per-guest Y/N — being
        in the list means attending) and show .rsvp-attending-fields always.
      - Notes lives in .rsvp-primary-notes so it stays visible for the primary
        even when they choose "not attending" (lets them send a regret note).
  -->
  <template id="rsvp-attendee-card">
    <fieldset class="rsvp-member">
      <div class="guest-name-row" hidden>
        <label class="rsvp-field rsvp-field--name">
          <span class="rsvp-label" data-bind="guestNameLabel"></span>
          <input type="text" name="guestName" maxlength="100" data-placeholder="guestName" required />
        </label>
        <label class="rsvp-kid-toggle">
          <input type="checkbox" name="isKid" />
          <span data-bind="isKidLabel"></span>
        </label>
      </div>
      <legend class="rsvp-member-name"></legend>
      <div class="rsvp-attending">
        <span class="rsvp-label" data-bind="attendingQuestion"></span>
        <div class="rsvp-radio-group" role="radiogroup">
          <label class="rsvp-radio"><input type="radio" name="attending" value="yes" /> <span data-bind="attendingYes"></span></label>
          <label class="rsvp-radio"><input type="radio" name="attending" value="no" /> <span data-bind="attendingNo"></span></label>
        </div>
      </div>
      <div class="rsvp-attending-fields" hidden>
        <div class="rsvp-menu-block">
          <div class="rsvp-menu-heading"><span data-bind="menuHeading"></span></div>
          <small class="rsvp-muted rsvp-menu-hint" data-bind="menuHint"></small>
          <div class="rsvp-menu-grid">
            <label class="rsvp-field">
              <span class="rsvp-label" data-bind="entradaLabel"></span>
              <select name="entradaChoice" data-bind="entradaSelect"></select>
            </label>
            <label class="rsvp-field">
              <span class="rsvp-label" data-bind="sorbetLabel"></span>
              <select name="sorbetChoice" data-bind="sorbetSelect"></select>
            </label>
            <label class="rsvp-field">
              <span class="rsvp-label" data-bind="mealLabel"></span>
              <select name="mealChoice" data-bind="mealSelect"></select>
            </label>
            <label class="rsvp-field">
              <span class="rsvp-label" data-bind="postreLabel"></span>
              <select name="postreChoice" data-bind="postreSelect"></select>
            </label>
          </div>
        </div>
        <label class="rsvp-field">
          <span class="rsvp-label" data-bind="dietaryLabel"></span>
          <input type="text" name="dietary" maxlength="500" data-placeholder="dietary" />
        </label>
        <label class="rsvp-field">
          <span class="rsvp-label" data-bind="songLabel"></span>
          <input type="text" name="songRequest" maxlength="500" data-placeholder="song" />
        </label>
      </div>
      <div class="rsvp-primary-notes" hidden>
        <label class="rsvp-field rsvp-field--notes">
          <span class="rsvp-label" data-bind="notesLabel"></span>
          <textarea name="notes" maxlength="800" rows="2" data-placeholder="notes"></textarea>
        </label>
      </div>
      <div class="guest-remove-row" hidden>
        <button type="button" class="rsvp-link rsvp-remove-guest" data-bind="removeGuest"></button>
      </div>
    </fieldset>
  </template>

  <script type="application/json" id="rsvp-init-data" set:html={JSON.stringify(initData).replace(/</g, '\\u003c').replace(/-->/g, '--\\u003e').replace(/\u2028/g, '\\u2028').replace(/\u2029/g, '\\u2029')}></script>
</section>

<script>
(() => {
  const root = document.querySelector('.rsvp-form-wrap') as HTMLElement | null;
  if (!root) return;
  const dataNode = root.querySelector('#rsvp-init-data');
  if (!dataNode) return;
  const INIT = JSON.parse(dataNode.textContent || '{}');
  const S: Record<string, string> = INIT.strings || {};
  const LOCALE: string = INIT.locale || 'en';
  const ENTRADA_OPTIONS: Array<{ value: string; label: string }> = INIT.entradaOptions || [];
  const SORBET_OPTIONS: Array<{ value: string; label: string }> = INIT.sorbetOptions || [];
  const MEAL_OPTIONS: Array<{ value: string; label: string }> = INIT.mealOptions || [];
  const POSTRE_OPTIONS: Array<{ value: string; label: string }> = INIT.postreOptions || [];
  const COURSE_SELECT_BINDINGS: Record<string, Array<{ value: string; label: string }>> = {
    entradaSelect: ENTRADA_OPTIONS,
    sorbetSelect: SORBET_OPTIONS,
    mealSelect: MEAL_OPTIONS,
    postreSelect: POSTRE_OPTIONS
  };
  const MAX_GUESTS: number = INIT.maxAdditionalGuests || 20;
  const SCHEMA_VERSION = 1;

  const $ = (sel: string): HTMLElement | null => root.querySelector(sel);
  const phases = {
    loading: $('#rsvp-loading'),
    lookup: $('#rsvp-lookup-form'),
    form: $('#rsvp-form'),
    confirmation: $('#rsvp-confirmation')
  };

  function show(phase: 'loading' | 'lookup' | 'form' | 'confirmation') {
    for (const [name, el] of Object.entries(phases)) {
      if (!el) continue;
      el.hidden = name !== phase;
    }
  }
  function showError(el: HTMLElement | null, msg: string) {
    if (!el) return;
    el.textContent = msg;
    el.hidden = false;
  }
  function clearError(el: HTMLElement | null) {
    if (!el) return;
    el.textContent = '';
    el.hidden = true;
  }
  function setBusy(btn: HTMLButtonElement | null, busy: boolean) {
    if (!btn) return;
    btn.disabled = busy;
    const def = btn.getAttribute('data-label-default') || btn.textContent || '';
    const bz = btn.getAttribute('data-label-busy') || def;
    btn.textContent = busy ? bz : def;
  }

  function showMagicBanner() {
    const params = new URLSearchParams(location.search);
    const magic = params.get('magic');
    if (!magic) return;
    const banner = $('#rsvp-magic-banner');
    if (!banner) return;
    const map: Record<string, { msg: string; tone: string }> = {
      ok:       { msg: S['rsvp.magicOk']      || '', tone: 'ok' },
      invalid:  { msg: S['rsvp.magicInvalid'] || '', tone: 'warn' },
      error:    { msg: S['rsvp.magicError']   || '', tone: 'warn' },
      missing:  { msg: S['rsvp.magicMissing'] || '', tone: 'warn' }
    };
    const entry = map[magic];
    if (!entry || !entry.msg) return;
    banner.textContent = entry.msg;
    banner.dataset.tone = entry.tone;
    banner.hidden = false;
    const url = new URL(location.href);
    url.searchParams.delete('magic');
    history.replaceState({}, '', url.pathname + (url.search || '') + url.hash);
  }

  function randomGuestId(): string {
    if (typeof crypto !== 'undefined' && crypto.getRandomValues) {
      const buf = new Uint8Array(6);
      crypto.getRandomValues(buf);
      return 'g_' + Array.from(buf).map(b => b.toString(16).padStart(2, '0')).join('');
    }
    return 'g_' + Math.random().toString(16).slice(2, 14);
  }

  function emptyPrimary() {
    return { attending: null, entradaChoice: '', sorbetChoice: '', mealChoice: '', postreChoice: '', dietary: '', songRequest: '', notes: '' };
  }

  type Invite = {
    inviteId: string;
    primaryFirstName: string;
    primaryLastName: string;
    locale: string;
    hasPhone: boolean;
    payload: any;
    responded: boolean;
    respondedAt: string;
    respondedLate?: boolean;
  };

  let INVITE: Invite | null = null;

  async function init() {
    showMagicBanner();
    show('loading');
    try {
      const res = await fetch('/api/rsvp/get', { credentials: 'same-origin' });
      if (!res.ok) { show('lookup'); return; }
      const data = await res.json();
      if (data && data.authenticated && data.invite) {
        INVITE = data.invite;
        if (INVITE.responded) {
          const payload = INVITE.payload || { primary: emptyPrimary(), additionalGuests: [] };
          const primary = payload.primary || emptyPrimary();
          const guests = Array.isArray(payload.additionalGuests) ? payload.additionalGuests : [];
          renderConfirmation(!!INVITE.respondedLate, guests.length, primary, guests);
        } else {
          renderForm();
        }
        return;
      }
    } catch (_e) { /* fall through */ }
    show('lookup');
  }

  // Bind static label text (data-bind="X" -> S['rsvp.X']) on a node.
  function bindStaticLabels(node: ParentNode) {
    node.querySelectorAll('[data-bind]').forEach((el) => {
      const key = (el as HTMLElement).dataset.bind || '';
      if (!key) return;
      const courseOptions = COURSE_SELECT_BINDINGS[key];
      if (courseOptions) {
        const sel = el as HTMLSelectElement;
        sel.innerHTML = '';
        for (const opt of courseOptions) {
          const o = document.createElement('option');
          o.value = opt.value;
          o.textContent = opt.label;
          sel.appendChild(o);
        }
      } else {
        (el as HTMLElement).textContent = S[`rsvp.${key}`] || '';
      }
    });
    node.querySelectorAll('[data-placeholder]').forEach((el) => {
      const key = (el as HTMLElement).dataset.placeholder || '';
      const map: Record<string, string> = {
        dietary: S['rsvp.dietaryPlaceholder'] || '',
        song: S['rsvp.songPlaceholder'] || '',
        notes: S['rsvp.notesPlaceholder'] || '',
        guestName: S['rsvp.guestNamePlaceholder'] || ''
      };
      (el as HTMLInputElement | HTMLTextAreaElement).placeholder = map[key] || '';
    });
  }

  // Build one attendee card (primary or additional guest). The two kinds
  // diverge in three ways:
  //   - primary: shows attending radio (Y/N), gates meal/dietary/song on Y,
  //              shows notes always; hides name input + remove button.
  //   - guest:   no attending radio (being in the list IS the answer);
  //              meal/dietary/song always shown; shows name input + remove;
  //              notes hidden.
  function buildAttendeeCard(
    kind: 'primary' | 'guest',
    data: any,
    opts: { guestId?: string; primaryName?: string } = {}
  ): HTMLFieldSetElement {
    const tpl = root!.querySelector('#rsvp-attendee-card') as HTMLTemplateElement;
    const node = tpl.content.cloneNode(true) as DocumentFragment;
    const fieldset = node.querySelector('fieldset') as HTMLFieldSetElement;
    fieldset.classList.add(`rsvp-member--${kind}`);

    bindStaticLabels(fieldset);

    const attendingBlock = fieldset.querySelector('.rsvp-attending') as HTMLElement | null;
    const attendingFields = fieldset.querySelector('.rsvp-attending-fields') as HTMLElement | null;
    const notesBlock = fieldset.querySelector('.rsvp-primary-notes') as HTMLElement | null;

    if (kind === 'primary') {
      // Scope radio names so primary's yes/no doesn't collide with anything.
      fieldset.dataset.scope = 'primary';
      fieldset.querySelectorAll('input[type="radio"][name="attending"]').forEach((r) => {
        (r as HTMLInputElement).name = 'attending-primary';
      });
      const nameEl = fieldset.querySelector('.rsvp-member-name') as HTMLElement;
      nameEl.textContent = opts.primaryName || '';
      if (notesBlock) notesBlock.hidden = false;
    } else {
      // Guests: drop the attending radio entirely. Show name + remove.
      if (attendingBlock) attendingBlock.remove();
      if (attendingFields) attendingFields.hidden = false;
      const guestId = opts.guestId || randomGuestId();
      fieldset.dataset.scope = guestId;
      fieldset.dataset.guestId = guestId;
      (fieldset.querySelector('.guest-name-row') as HTMLElement).hidden = false;
      (fieldset.querySelector('.guest-remove-row') as HTMLElement).hidden = false;
      (fieldset.querySelector('.rsvp-member-name') as HTMLElement).hidden = true;
      const nameInput = fieldset.querySelector('input[name="guestName"]') as HTMLInputElement;
      if (data && typeof data.name === 'string') nameInput.value = data.name;
      const isKidInput = fieldset.querySelector('input[name="isKid"]') as HTMLInputElement;
      if (data && data.isKid) isKidInput.checked = true;
      const removeBtn = fieldset.querySelector('.rsvp-remove-guest') as HTMLButtonElement;
      removeBtn.addEventListener('click', () => {
        fieldset.remove();
        updateAddGuestButton();
      });
    }

    // Pre-fill attendee fields from saved data.
    if (data) {
      if (kind === 'primary') {
        if (data.attending === true) {
          const yes = fieldset.querySelector('input[type="radio"][value="yes"]') as HTMLInputElement;
          if (yes) yes.checked = true;
        } else if (data.attending === false) {
          const no = fieldset.querySelector('input[type="radio"][value="no"]') as HTMLInputElement;
          if (no) no.checked = true;
        }
      }
      const restoreSelect = (name: string, options: Array<{ value: string; label: string }>) => {
        const sel = fieldset.querySelector(`select[name="${name}"]`) as HTMLSelectElement | null;
        if (!sel) return;
        const v = data[name];
        if (!v) return;
        sel.value = options.some(o => o.value === v) ? v : '';
      };
      restoreSelect('entradaChoice', ENTRADA_OPTIONS);
      restoreSelect('sorbetChoice', SORBET_OPTIONS);
      restoreSelect('mealChoice', MEAL_OPTIONS);
      restoreSelect('postreChoice', POSTRE_OPTIONS);
      const fld = (n: string) => fieldset.querySelector(`[name="${n}"]`) as HTMLInputElement | HTMLTextAreaElement | null;
      const dietary = fld('dietary'); if (dietary && data.dietary) dietary.value = data.dietary;
      const song = fld('songRequest'); if (song && data.songRequest) song.value = data.songRequest;
      if (kind === 'primary') {
        const notes = fld('notes'); if (notes && data.notes) notes.value = data.notes;
      }
    }

    if (kind === 'primary') {
      // Primary's Yes/No drives both its own meal fields AND the entire
      // additional-guests section visibility (handled in updatePrimaryGated).
      fieldset.querySelectorAll('input[type="radio"][name="attending-primary"]').forEach((inp) => {
        inp.addEventListener('change', updatePrimaryGated);
      });
    }

    return fieldset;
  }

  // Read primary's current attending choice off the form. Returns null when
  // unanswered, true when "yes" is checked, false when "no" is checked.
  function getPrimaryAttending(): boolean | null {
    const primaryFs = $('#rsvp-primary-card')?.querySelector('fieldset') as HTMLFieldSetElement | null;
    if (!primaryFs) return null;
    const yes = (primaryFs.querySelector('input[type="radio"][value="yes"]') as HTMLInputElement | null)?.checked;
    const no = (primaryFs.querySelector('input[type="radio"][value="no"]') as HTMLInputElement | null)?.checked;
    if (yes) return true;
    if (no) return false;
    return null;
  }

  // Sync everything that depends on the primary's attending answer:
  //   - primary's meal/dietary/song fields (shown only on Yes)
  //   - the entire additional-guests section (shown only on Yes)
  // Notes for the primary stay visible either way (regret messages on No).
  function updatePrimaryGated() {
    const attending = getPrimaryAttending();
    const primaryFs = $('#rsvp-primary-card')?.querySelector('fieldset') as HTMLFieldSetElement | null;
    if (primaryFs) {
      const fields = primaryFs.querySelector('.rsvp-attending-fields') as HTMLElement | null;
      if (fields) fields.hidden = attending !== true;
    }
    const additional = root!.querySelector('.rsvp-additional') as HTMLElement | null;
    if (additional) additional.hidden = attending !== true;
  }

  function updateAddGuestButton() {
    const btn = $('#rsvp-add-guest') as HTMLButtonElement | null;
    const hint = $('#rsvp-add-guest-hint');
    const guestsBox = $('#rsvp-guests');
    if (!btn || !guestsBox) return;
    const count = guestsBox.querySelectorAll('.rsvp-member--guest').length;
    if (count >= MAX_GUESTS) {
      btn.disabled = true;
      if (hint) {
        hint.textContent = (S['rsvp.maxGuestsReached'] || '').replace('{n}', String(MAX_GUESTS));
        hint.hidden = false;
      }
    } else {
      btn.disabled = false;
      if (hint) hint.hidden = true;
    }
  }

  function renderForm() {
    if (!INVITE) { show('lookup'); return; }
    const greetingEl = $('#rsvp-greeting');
    if (greetingEl) {
      const first = INVITE.primaryFirstName || '';
      greetingEl.textContent = first
        ? `${S['rsvp.formHelloPrefix']} ${first}!`
        : (S['rsvp.heading'] || '');
    }
    // Bind static labels in the form chrome (section headings, add-guest btn).
    const formNode = phases.form;
    if (formNode) bindStaticLabels(formNode);

    const payload = INVITE.payload || { primary: emptyPrimary(), additionalGuests: [] };
    const primary = payload.primary || emptyPrimary();
    const savedGuests = Array.isArray(payload.additionalGuests) ? payload.additionalGuests : [];
    // In the simplified model, being in the additional-guests list means
    // attending. Saved guests with attending===false are dropped from the UI
    // so the user doesn't see a "coming" card for someone they already
    // declined. We surface a small one-time hint when this happens so they
    // can add the guest back if plans changed.
    const activeGuests = savedGuests.filter((g: any) => g && g.attending !== false);
    const declinedCount = savedGuests.length - activeGuests.length;

    const primaryBox = $('#rsvp-primary-card');
    const guestsBox = $('#rsvp-guests');
    if (!primaryBox || !guestsBox) return;
    primaryBox.innerHTML = '';
    guestsBox.innerHTML = '';

    const primaryName = `${INVITE.primaryFirstName || ''} ${INVITE.primaryLastName || ''}`.trim();
    primaryBox.appendChild(buildAttendeeCard('primary', primary, { primaryName }));

    for (const g of activeGuests) {
      guestsBox.appendChild(buildAttendeeCard('guest', g, { guestId: g.id || randomGuestId() }));
    }
    const declinedHint = $('#rsvp-declined-hint');
    if (declinedHint) declinedHint.hidden = declinedCount === 0;
    updateAddGuestButton();
    updatePrimaryGated();
    clearError($('#rsvp-submit-error'));
    show('form');
  }

  // --- Lookup ---
  // The lookup phase supports two top-level modes (name vs. phone) and one
  // sub-state (last-name + phone-4 disambiguation, revealed only when the
  // server tells us multiple invites share a surname).
  type LookupMode = 'name' | 'phone';
  let lookupMode: LookupMode = 'name';
  let phone4Required = false;

  const lookupForm = phases.lookup as HTMLFormElement | null;
  const lookupNameFields = $('#rsvp-lookup-name-fields') as HTMLElement | null;
  const lookupPhoneFields = $('#rsvp-lookup-phone-fields') as HTMLElement | null;
  const phone4Row = $('#rsvp-phone-last4-row') as HTMLElement | null;
  const lookupHeading = $('#rsvp-lookup-heading') as HTMLElement | null;
  const lookupHint = $('#rsvp-lookup-hint') as HTMLElement | null;
  const lookupToggleBtn = $('#rsvp-lookup-toggle-btn') as HTMLButtonElement | null;
  const lastNameInput = lookupForm?.querySelector('input[name="lastName"]') as HTMLInputElement | null;
  const phone4Input = lookupForm?.querySelector('input[name="phoneLast4"]') as HTMLInputElement | null;
  const phoneInput = lookupForm?.querySelector('input[name="phone"]') as HTMLInputElement | null;

  function setPhone4Required(required: boolean) {
    phone4Required = required;
    if (!phone4Row) return;
    phone4Row.hidden = !required;
    if (!required && phone4Input) phone4Input.value = '';
    if (required && phone4Input) {
      // Defer focus a tick so the layout reveal doesn't fight the focus.
      requestAnimationFrame(() => phone4Input.focus());
    }
  }

  function setLookupMode(mode: LookupMode) {
    lookupMode = mode;
    clearError($('#rsvp-lookup-error'));
    setPhone4Required(false);
    if (lookupNameFields) lookupNameFields.hidden = (mode === 'phone');
    if (lookupPhoneFields) lookupPhoneFields.hidden = (mode === 'name');
    if (lookupHeading) {
      lookupHeading.textContent = mode === 'phone'
        ? (S['rsvp.phoneLookupTitle'] || '')
        : (S['rsvp.lookupTitle'] || '');
    }
    if (lookupHint) {
      lookupHint.textContent = mode === 'phone'
        ? (S['rsvp.phoneLookupHint'] || '')
        : (S['rsvp.lookupHint'] || '');
    }
    if (lookupToggleBtn) {
      lookupToggleBtn.textContent = mode === 'phone'
        ? (S['rsvp.backToNameLookup'] || '')
        : (S['rsvp.lookupByPhoneLink'] || '');
    }
    const focusEl = mode === 'phone' ? phoneInput : lastNameInput;
    if (focusEl) requestAnimationFrame(() => focusEl.focus());
  }

  // Changing the last name invalidates any prior disambig context — drop it
  // so the next submit goes back to a fresh name-only lookup.
  if (lastNameInput) {
    lastNameInput.addEventListener('input', () => {
      if (phone4Required) {
        setPhone4Required(false);
        clearError($('#rsvp-lookup-error'));
      }
    });
  }

  // Format the phone fallback input as the user types: (XXX) XXX-XXXX.
  // The server normalizes to E.164 server-side, so the format here is purely
  // a UX guard — keeps the field tidy and reduces "is my number valid?"
  // anxiety. Pasting works too (digits extracted, leading "1" stripped).
  function formatUsPhone(raw: string): string {
    // Drop anything after an extension marker first so "555-1234 ext 99" or
    // "555-1234 x99" doesn't bleed the extension digits into the main number.
    const trimmed = (raw || '').replace(/\s*(?:ext\.?|x|#|,|;)\s*\d+.*$/i, '');
    let digits = trimmed.replace(/\D/g, '');
    // Strip a US country-code 1 prefix even when the total digit count is
    // unusual (handles short partial paste like "12026" and over-long input).
    if (digits.length >= 11 && digits.startsWith('1')) digits = digits.slice(1);
    digits = digits.slice(0, 10);
    if (digits.length === 0) return '';
    if (digits.length <= 3) return `(${digits}`;
    if (digits.length <= 6) return `(${digits.slice(0, 3)}) ${digits.slice(3)}`;
    return `(${digits.slice(0, 3)}) ${digits.slice(3, 6)} - ${digits.slice(6, 10)}`;
  }
  if (phoneInput) {
    phoneInput.addEventListener('input', () => {
      const before = phoneInput.value;
      const formatted = formatUsPhone(before);
      if (formatted !== before) {
        phoneInput.value = formatted;
        // Always park the caret at the end after reformatting — simplest UX
        // and good enough for a single short input.
        try { phoneInput.setSelectionRange(formatted.length, formatted.length); } catch {}
      }
    });
  }
  // Phone-last-4 input: digits only, max 4. Keeps the value clean so the
  // server's length === 4 check never trips on stray characters.
  if (phone4Input) {
    phone4Input.addEventListener('input', () => {
      const cleaned = (phone4Input.value || '').replace(/\D/g, '').slice(0, 4);
      if (cleaned !== phone4Input.value) phone4Input.value = cleaned;
    });
  }

  if (lookupToggleBtn) {
    lookupToggleBtn.addEventListener('click', () => {
      const next: LookupMode = lookupMode === 'name' ? 'phone' : 'name';
      window.appTelemetry?.trackEvent('rsvp_lookup_mode_switched', { to: next });
      setLookupMode(next);
    });
  }

  if (lookupForm) {
    lookupForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError($('#rsvp-lookup-error'));
      const btn = lookupForm.querySelector('button[type="submit"]') as HTMLButtonElement;
      const fd = new FormData(lookupForm);

      let body: Record<string, string> | null = null;
      let validationError: string | null = null;
      const submitMode: 'lastName' | 'lastName+phone4' | 'phone' =
        lookupMode === 'phone'
          ? 'phone'
          : (phone4Required ? 'lastName+phone4' : 'lastName');

      if (lookupMode === 'phone') {
        const phone = String(fd.get('phone') || '').trim();
        const digits = phone.replace(/\D/g, '');
        if (digits.length < 10) {
          validationError = S['rsvp.phoneInvalid'] || '';
        } else {
          body = { phone };
        }
      } else {
        const lastName = String(fd.get('lastName') || '').trim();
        if (lastName.length < 2) {
          validationError = S['rsvp.lookupNameTooShort'] || '';
        } else {
          body = { lastName };
          if (phone4Required) {
            const phone4 = String(fd.get('phoneLast4') || '').replace(/\D/g, '');
            if (phone4.length !== 4) {
              validationError = S['rsvp.phoneLast4Invalid'] || '';
            } else {
              body.phoneLast4 = phone4;
            }
          }
        }
      }

      if (validationError || !body) {
        showError($('#rsvp-lookup-error'), validationError || (S['rsvp.lookupError'] || ''));
        window.appTelemetry?.trackEvent('rsvp_lookup_validation_failed', { mode: submitMode });
        return;
      }

      window.appTelemetry?.trackEvent('rsvp_lookup_submitted', { locale: LOCALE, mode: submitMode });
      setBusy(btn, true);
      try {
        const res = await fetch('/api/rsvp/lookup', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        if (res.status === 429) {
          showError($('#rsvp-lookup-error'), S['rsvp.lookupRateLimited']);
          window.appTelemetry?.trackEvent('rsvp_lookup_failed', { reason: 'rate_limited', status: 429, mode: submitMode });
          return;
        }
        if (!res.ok) {
          showError($('#rsvp-lookup-error'), S['rsvp.lookupError']);
          window.appTelemetry?.trackEvent('rsvp_lookup_failed', { reason: 'http_error', status: res.status, mode: submitMode });
          return;
        }
        const data = await res.json();
        if (!data.found) {
          if (data.ambiguous && data.requiresPhoneLast4 && lookupMode === 'name') {
            // The server is asking us to disambiguate via phone-4.
            const wasAlreadyAsking = phone4Required;
            if (!wasAlreadyAsking) {
              // First-time prompt: reveal the input, let the inline hint do
              // the talking — no banner error needed.
              window.appTelemetry?.trackEvent('rsvp_lookup_disambig_requested', { mode: submitMode });
              setPhone4Required(true);
            } else {
              // Re-prompt after a wrong phone-4: the inline hint stays but
              // we explicitly tell the user the phone didn't match.
              window.appTelemetry?.trackEvent('rsvp_lookup_failed', { reason: 'phone4_mismatch', mode: submitMode });
              if (phone4Input) phone4Input.value = '';
              showError($('#rsvp-lookup-error'), S['rsvp.phoneLast4Mismatch']);
              if (phone4Input) requestAnimationFrame(() => phone4Input.focus());
            }
            return;
          }
          if (data.ambiguous) {
            const msg = lookupMode === 'phone' ? S['rsvp.phoneAmbiguous'] : S['rsvp.lookupAmbiguous'];
            showError($('#rsvp-lookup-error'), msg);
            window.appTelemetry?.trackEvent('rsvp_lookup_failed', { reason: 'ambiguous', mode: submitMode });
            return;
          }
          const msg = lookupMode === 'phone' ? S['rsvp.phoneNotFound'] : S['rsvp.lookupNotFound'];
          showError($('#rsvp-lookup-error'), msg);
          window.appTelemetry?.trackEvent('rsvp_lookup_failed', { reason: 'not_found', mode: submitMode });
          return;
        }
        window.appTelemetry?.trackEvent('rsvp_lookup_success', {
          mode: submitMode,
          partySize: (data.invite?.guests?.length ?? 0) + 1
        });
        INVITE = data.invite;
        try { localStorage.setItem('rsvp.lastFirst', INVITE?.primaryFirstName || ''); } catch {}
        if (INVITE && INVITE.responded) {
          const payload = INVITE.payload || { primary: emptyPrimary(), additionalGuests: [] };
          const primary = payload.primary || emptyPrimary();
          const guests = Array.isArray(payload.additionalGuests) ? payload.additionalGuests : [];
          renderConfirmation(!!INVITE.respondedLate, guests.length, primary, guests);
        } else {
          renderForm();
        }
      } catch (_e) {
        showError($('#rsvp-lookup-error'), S['rsvp.lookupError']);
        window.appTelemetry?.trackEvent('rsvp_lookup_failed', { reason: 'network_error', mode: submitMode });
      } finally {
        setBusy(btn, false);
      }
    });
  }

  // --- Not you ---
  const notYouBtn = $('#rsvp-not-you');
  if (notYouBtn) {
    notYouBtn.addEventListener('click', async () => {
      try { await fetch('/api/rsvp/logout', { method: 'POST', credentials: 'same-origin' }); } catch {}
      try { localStorage.removeItem('rsvp.lastFirst'); } catch {}
      INVITE = null;
      (lookupForm as HTMLFormElement | null)?.reset();
      clearError($('#rsvp-lookup-error'));
      setLookupMode('name');
      show('lookup');
    });
  }

  // --- Edit ---
  const editBtn = $('#rsvp-edit');
  if (editBtn) {
    editBtn.addEventListener('click', () => {
      if (INVITE) renderForm();
      else show('lookup');
    });
  }

  // --- Add guest ---
  const addGuestBtn = $('#rsvp-add-guest') as HTMLButtonElement | null;
  if (addGuestBtn) {
    addGuestBtn.addEventListener('click', () => {
      const guestsBox = $('#rsvp-guests');
      if (!guestsBox) return;
      const count = guestsBox.querySelectorAll('.rsvp-member--guest').length;
      if (count >= MAX_GUESTS) return;
      const newGuest = { id: randomGuestId(), name: '', isKid: false, attending: null, entradaChoice: '', sorbetChoice: '', mealChoice: '', postreChoice: '', dietary: '', songRequest: '' };
      guestsBox.appendChild(buildAttendeeCard('guest', newGuest, { guestId: newGuest.id }));
      updateAddGuestButton();
      // Focus the new name input for snappy entry
      const last = guestsBox.querySelector('.rsvp-member--guest:last-child input[name="guestName"]') as HTMLInputElement | null;
      if (last) last.focus();
    });
  }

  // --- Submit ---
  // collectAttendee derives the per-attendee payload shape from the card.
  // For guests, attending is hardcoded to true — they only exist in the
  // list because the user added them, and the new UX uses "remove" instead
  // of a per-row Yes/No radio. For the primary, attending is read from the
  // radio (tri-state: true|false|null while undecided).
  function collectAttendee(fs: HTMLFieldSetElement, kind: 'primary' | 'guest'): any {
    const get = (n: string): string => (fs.querySelector(`[name="${n}"]`) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null)?.value || '';
    if (kind === 'primary') {
      const yes = (fs.querySelector('input[type="radio"][value="yes"]') as HTMLInputElement | null)?.checked;
      const no = (fs.querySelector('input[type="radio"][value="no"]') as HTMLInputElement | null)?.checked;
      let attending: boolean | null = null;
      if (yes) attending = true; else if (no) attending = false;
      return {
        attending,
        entradaChoice: attending === true ? get('entradaChoice') : '',
        sorbetChoice: attending === true ? get('sorbetChoice') : '',
        mealChoice: attending === true ? get('mealChoice') : '',
        postreChoice: attending === true ? get('postreChoice') : '',
        dietary: attending === true ? get('dietary') : '',
        songRequest: attending === true ? get('songRequest') : '',
        notes: get('notes')
      };
    }
    // Guest.
    return {
      id: fs.dataset.guestId || randomGuestId(),
      name: get('guestName').trim(),
      isKid: !!(fs.querySelector('input[name="isKid"]') as HTMLInputElement | null)?.checked,
      attending: true,
      entradaChoice: get('entradaChoice'),
      sorbetChoice: get('sorbetChoice'),
      mealChoice: get('mealChoice'),
      postreChoice: get('postreChoice'),
      dietary: get('dietary'),
      songRequest: get('songRequest')
    };
  }

  const submitForm = phases.form as HTMLFormElement | null;
  if (submitForm) {
    submitForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearError($('#rsvp-submit-error'));
      const btn = submitForm.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (!INVITE) return;

      const primaryFs = $('#rsvp-primary-card')!.querySelector('fieldset') as HTMLFieldSetElement | null;
      if (!primaryFs) return;
      const primary = collectAttendee(primaryFs, 'primary');

      // Primary must answer Yes or No before we let the form go through.
      if (primary.attending !== true && primary.attending !== false) {
        showError($('#rsvp-submit-error'), S['rsvp.attendingAllRequired']);
        return;
      }

      // Collect additional guests ONLY when primary is attending. If primary
      // declined, the whole party is declining and the DOM rows (kept around
      // for the No -> Yes toggle-back case) are ignored entirely.
      let additionalGuests: any[] = [];
      if (primary.attending === true) {
        const guestFieldsets = Array.from($('#rsvp-guests')!.querySelectorAll('fieldset')) as HTMLFieldSetElement[];
        const collected = guestFieldsets.map(fs => collectAttendee(fs, 'guest'));
        // Drop totally-empty cards silently — a user who clicks "Add guest"
        // by mistake and never types anything shouldn't be blocked. A
        // half-filled card (name present but blank, or no name but a meal
        // chosen) still fails the name guard below so we don't lose data.
        const isEmpty = (g: any) => !g.name && !g.entradaChoice && !g.sorbetChoice && !g.mealChoice && !g.postreChoice && !g.dietary && !g.songRequest && !g.isKid;
        additionalGuests = collected.filter(g => !isEmpty(g));
        const missingNames = additionalGuests.filter(g => !g.name);
        if (missingNames.length) {
          showError($('#rsvp-submit-error'), S['rsvp.guestNameRequired']);
          return;
        }
      }

      const payload = {
        schemaVersion: SCHEMA_VERSION,
        primary,
        additionalGuests
      };

      setBusy(btn, true);
      window.appTelemetry?.trackEvent('rsvp_submit_started', {
        locale: LOCALE,
        primaryAttending: primary.attending,
        partySize: additionalGuests.length + 1
      });
      try {
        const res = await fetch('/api/rsvp/submit', {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ payload })
        });
        if (res.status === 429) {
          showError($('#rsvp-submit-error'), S['rsvp.submitRateLimited']);
          window.appTelemetry?.trackEvent('rsvp_submit_failed', { reason: 'rate_limited', status: 429 });
          return;
        }
        if (res.status === 410) {
          // Distinguish "permanently closed" from "invite vanished" — body has
          // { error: 'rsvp_closed' } vs { error: 'invite_not_found' }.
          let body: any = null;
          try { body = await res.json(); } catch {}
          if (body && body.error === 'invite_not_found') {
            INVITE = null;
            try { localStorage.removeItem('rsvp.lastFirst'); } catch {}
            (lookupForm as HTMLFormElement | null)?.reset();
            show('lookup');
            showError($('#rsvp-lookup-error'), S['rsvp.lookupNotFound']);
            window.appTelemetry?.trackEvent('rsvp_submit_failed', { reason: 'invite_not_found', status: 410 });
            return;
          }
          showError($('#rsvp-submit-error'), S['rsvp.submitClosed']);
          window.appTelemetry?.trackEvent('rsvp_submit_failed', { reason: 'rsvp_closed', status: 410 });
          return;
        }
        if (!res.ok) {
          showError($('#rsvp-submit-error'), S['rsvp.submitError']);
          window.appTelemetry?.trackEvent('rsvp_submit_failed', { reason: 'http_error', status: res.status });
          return;
        }
        const data = await res.json();
        // Update local snapshot so Edit shows fresh values.
        if (INVITE && data && data.payload) {
          INVITE.payload = data.payload;
          INVITE.responded = true;
        }
        window.appTelemetry?.trackEvent('rsvp_submit_success', {
          locale: LOCALE,
          primaryAttending: primary.attending,
          partySize: additionalGuests.length + 1,
          attendingCount: primary.attending === true ? additionalGuests.length + 1 : 0,
          late: !!(data && data.late)
        });
        renderConfirmation(!!(data && data.late), additionalGuests.length, primary, additionalGuests);
      } catch (_e) {
        showError($('#rsvp-submit-error'), S['rsvp.submitError']);
        window.appTelemetry?.trackEvent('rsvp_submit_failed', { reason: 'network_error' });
      } finally {
        setBusy(btn, false);
      }
    });
  }

  function renderConfirmation(late: boolean, _guestCount: number, primary: any, guests: any[]) {
    const summaryEl = $('#rsvp-confirm-summary');
    if (summaryEl) {
      const all = [primary, ...guests];
      const total = all.length;
      const attendingCount = all.filter(a => a.attending === true).length;
      let summaryText = '';
      if (attendingCount === total && total > 0) summaryText = S['rsvp.thanksAttending'];
      else if (attendingCount === 0) summaryText = S['rsvp.thanksNotAttending'];
      else summaryText = S['rsvp.thanksMixed'];
      if (late) summaryText = `${S['rsvp.lateNotice']} ${summaryText}`;
      summaryEl.textContent = summaryText;
    }
    show('confirmation');
  }

  init();
})();
</script>

<style>
  .rsvp-form-wrap {
    max-width: 44rem;
    margin: 0 auto;
    padding: 0 var(--space-3);
  }
  .rsvp-banner {
    margin: 0 0 var(--space-3);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md, 8px);
    background: rgba(201, 169, 97, 0.12);
    border-left: 4px solid var(--color-gold);
    color: var(--color-text);
  }
  .rsvp-banner[data-tone="warn"] {
    background: rgba(200, 100, 60, 0.08);
    border-left-color: #c8643c;
  }
  .rsvp-phase { margin: 0; }
  .rsvp-phase[hidden] { display: none !important; }
  .rsvp-phase--loading { text-align: center; padding: var(--space-5) 0; }

  .rsvp-loader {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-3);
    min-height: 10rem;
    /* Delay reveal so the spinner doesn't flash for fast responses */
    animation: rsvp-loader-fadein 0.45s ease-out 0.25s both;
  }
  .rsvp-loader__orbit {
    position: relative;
    width: 3.5rem;
    height: 3.5rem;
    display: grid;
    place-items: center;
  }
  .rsvp-loader__ring {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--color-gold-light, #ebd7a1);
    border-top-color: var(--color-gold-deep, #a8842f);
    border-right-color: var(--color-gold, #d4af37);
    opacity: 0.85;
    animation: rsvp-loader-spin 1.4s linear infinite;
  }
  .rsvp-loader__mark {
    font-family: var(--font-display, 'Cormorant Garamond', serif);
    font-size: 1.5rem;
    line-height: 1;
    color: var(--color-gold-deep, #a8842f);
    animation: rsvp-loader-pulse 2.2s ease-in-out infinite;
  }
  .rsvp-loader__text {
    margin: 0;
    font-family: var(--font-display, 'Cormorant Garamond', serif);
    font-style: italic;
    font-size: 1.1rem;
    letter-spacing: 0.02em;
    color: var(--color-text-muted, #6b6259);
    text-align: center;
  }
  @keyframes rsvp-loader-spin {
    to { transform: rotate(360deg); }
  }
  @keyframes rsvp-loader-pulse {
    0%, 100% { transform: scale(1); opacity: 0.85; }
    50%      { transform: scale(1.08); opacity: 1; }
  }
  @keyframes rsvp-loader-fadein {
    from { opacity: 0; }
    to   { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rsvp-loader { animation: none; opacity: 1; }
    .rsvp-loader__ring {
      animation: none;
      border-color: var(--color-gold-light, #ebd7a1);
