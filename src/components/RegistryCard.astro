---
import config from '../data/wedding.config.json';
import { t, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const amazon = config.registry?.amazon ?? {};
const pending = !amazon.url || amazon.url === 'AMAZON_REGISTRY_URL_GOES_HERE';
---

<article class="registry-card reveal">
  <p class="logo">Amazon</p>
  <p class="lede">{t(locale, 'registry.cardLede')}</p>
  {pending ? (
    <span class="btn disabled" aria-disabled="true">{t(locale, 'common.comingSoon')}</span>
  ) : (
    <a class="btn btn--gold" href={amazon.url} target="_blank" rel="noopener noreferrer">{t(locale, 'registry.viewRegistry')}</a>
  )}
  <p class="note">{t(locale, 'registry.openNote')}</p>
</article>

<style>
  .registry-card {
    position: relative;
    max-width: 34rem;
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
    text-align: center;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--gradient-surface);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
  }
  .registry-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--gradient-gold-fill);
  }
  .logo {
    font-family: var(--font-display);
    font-size: 2.6rem;
    background: linear-gradient(135deg, var(--color-gold-deep) 0%, var(--color-gold) 50%, var(--color-gold-deep) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: var(--color-gold-deep);
    margin-bottom: var(--space-2);
  }
  .lede {
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--color-text);
    margin: 0 auto var(--space-4);
    max-width: 28rem;
  }
  .disabled { pointer-events: none; opacity: 0.5; filter: grayscale(1); }
  .note { margin-top: var(--space-3); color: var(--color-text-muted); font-size: var(--fs-small); font-style: italic; }
</style>
