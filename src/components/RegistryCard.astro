---
import config from '../data/wedding.config.json';
import { t, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const amazon = config.registry?.amazon ?? {};
const pending = !amazon.url || amazon.url === 'AMAZON_REGISTRY_URL_GOES_HERE';
---

<article class="registry-card reveal">
  <p class="logo">Amazon</p>
  <h2>{t(locale, 'registry.title')}</h2>
  {pending ? (
    <span class="btn disabled" aria-disabled="true">{t(locale, 'common.comingSoon')}</span>
  ) : (
    <a class="btn btn--gold" href={amazon.url} target="_blank" rel="noopener noreferrer">{t(locale, 'registry.viewRegistry')}</a>
  )}
  <p class="note">{t(locale, 'registry.moreSoon')}</p>
</article>

<style>
  .registry-card { max-width: 34rem; margin: 0 auto; padding: var(--space-4); text-align: center; border: 1px solid var(--color-rule); border-radius: var(--radius-lg); background: rgba(255,255,255,0.6); box-shadow: var(--shadow-sm); }
  .logo { font-family: var(--font-display); font-size: 2.4rem; color: var(--color-gold); }
  .disabled { pointer-events: none; opacity: 0.5; filter: grayscale(1); }
  .note { margin-top: var(--space-2); color: var(--color-text-muted); font-size: var(--fs-small); }
</style>
