---
import menu from '../data/menu.json';
import { t, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const isEs = locale === 'es';
const intro = isEs ? menu.caterer.introEs : menu.caterer.introEn;
const beverages = menu.beverages;
const beverageLines = isEs ? beverages.linesEs : beverages.linesEn;
const footnote = isEs ? menu.footnoteEs : menu.footnoteEn;
---

<article class="menu-card reveal" aria-labelledby="menu-heading">
  <header class="menu-card__header">
    <p class="eyebrow">{t(locale, 'menu.eyebrow')}</p>
    <h3 id="menu-heading">{t(locale, 'menu.heading')}</h3>
    <p class="caterer">{menu.caterer.name}</p>
    <p class="intro">{intro}</p>
  </header>

  <div class="menu-ornament" aria-hidden="true">⊹</div>

  <ol class="menu-courses">
    {menu.courses.map((course) => {
      const label = isEs ? course.labelEs : course.labelEn;
      const sides = isEs ? course.sidesEs : course.sidesEn;
      return (
        <li class="menu-course">
          <p class="menu-course__label"><span>{label}</span></p>
          <ul class="menu-course__options">
            {course.options.map((opt) => (
              <li>{isEs ? opt.es : opt.en}</li>
            ))}
          </ul>
          {sides && <p class="menu-course__sides">{sides}</p>}
        </li>
      );
    })}

    <li class="menu-course menu-course--beverages">
      <p class="menu-course__label"><span>{isEs ? beverages.labelEs : beverages.labelEn}</span></p>
      <ul class="menu-course__options menu-course__options--beverages">
        {beverageLines.map((line) => <li>{line}</li>)}
      </ul>
    </li>
  </ol>

  <p class="menu-footnote"><em>{footnote}</em></p>
</article>

<style>
  .menu-card {
    position: relative;
    margin: var(--space-4) auto 0;
    max-width: 44rem;
    padding: var(--space-5) var(--space-4) var(--space-5);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--gradient-surface);
    box-shadow: var(--shadow-soft);
  }
  .menu-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    background: var(--gradient-gold-fill);
  }

  .menu-card__header { text-align: center; }
  .menu-card__header .eyebrow { margin-bottom: var(--space-1); }
  .menu-card__header h3 {
    color: var(--color-gold-deep);
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 3.4vw, 2.45rem);
    margin: 0 0 var(--space-2);
    letter-spacing: 0.01em;
  }
  .menu-card__header .caterer {
    color: var(--color-text-muted);
    font-style: italic;
    letter-spacing: 0.04em;
    margin: 0 0 var(--space-3);
    font-size: var(--fs-small);
  }
  .menu-card__header .intro {
    max-width: 34rem;
    margin: 0 auto;
    color: var(--color-text);
  }

  .menu-ornament {
    text-align: center;
    color: var(--color-gold);
    font-size: 1.1rem;
    margin: var(--space-4) 0 var(--space-3);
    letter-spacing: 0.4em;
    opacity: 0.85;
  }

  .menu-courses {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-5);
    text-align: center;
  }
  .menu-course { padding: 0; }
  .menu-course--beverages { padding-top: var(--space-3); border-top: 1px solid var(--color-rule); }

  .menu-course__label {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-3);
    color: var(--color-gold-deep);
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }
  .menu-course__label::before,
  .menu-course__label::after {
    content: '';
    flex: 0 1 3.5rem;
    height: 1px;
    background: linear-gradient(to right, transparent, var(--color-gold) 50%, transparent);
    opacity: 0.7;
  }
  .menu-course__label span { white-space: nowrap; }

  .menu-course__options {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .menu-course__options li {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.1rem, 1.8vw, 1.3rem);
    line-height: 1.45;
    color: var(--color-text);
  }
  .menu-course__options--beverages li {
    font-size: clamp(0.95rem, 1.4vw, 1.05rem);
    font-style: normal;
    font-family: var(--font-body);
    color: var(--color-text);
    line-height: 1.55;
  }

  .menu-course__sides {
    margin: var(--space-2) auto 0;
    max-width: 26rem;
    font-size: var(--fs-small);
    font-style: italic;
    color: var(--color-text-muted);
  }

  .menu-footnote {
    margin: var(--space-5) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-rule);
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    text-align: center;
  }

  @media (min-width: 760px) {
    .menu-card { padding: var(--space-6) var(--space-5) var(--space-5); }
  }
</style>
