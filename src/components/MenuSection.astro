---
import menu from '../data/menu.json';
import { t, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;
const isEs = locale === 'es';
const intro = isEs ? menu.caterer.introEs : menu.caterer.introEn;
const beverages = menu.beverages;
const beverageLines = isEs ? beverages.linesEs : beverages.linesEn;
const footnote = isEs ? menu.footnoteEs : menu.footnoteEn;
---

<article class="menu-card reveal" aria-labelledby="menu-heading">
  <header class="menu-card__header">
    <p class="eyebrow">{t(locale, 'menu.eyebrow')}</p>
    <h3 id="menu-heading">{t(locale, 'menu.heading')}</h3>
    <p class="caterer">{menu.caterer.name}</p>
    <p class="intro">{intro}</p>
  </header>

  <ol class="menu-courses">
    {menu.courses.map((course, idx) => {
      const label = isEs ? course.labelEs : course.labelEn;
      const note = isEs ? course.noteEs : course.noteEn;
      const sides = isEs ? course.sidesEs : course.sidesEn;
      return (
        <li class="menu-course">
          <div class="menu-course__head">
            <span class="course-number">{String(idx + 1).padStart(2, '0')}</span>
            <div>
              <h4>{label}</h4>
              {note && <p class="course-note">{note}</p>}
            </div>
          </div>
          <ul class="course-options">
            {course.options.map((opt) => (
              <li>{isEs ? opt.es : opt.en}</li>
            ))}
          </ul>
          {sides && <p class="course-sides">{sides}</p>}
        </li>
      );
    })}
  </ol>

  <section class="menu-beverages">
    <h4>{isEs ? beverages.labelEs : beverages.labelEn}</h4>
    <ul>
      {beverageLines.map((line) => <li>{line}</li>)}
    </ul>
  </section>

  <p class="menu-footnote"><em>{footnote}</em></p>
</article>

<style>
  .menu-card {
    margin-top: var(--space-4);
    padding: var(--space-5) var(--space-4);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--gradient-surface);
    box-shadow: var(--shadow-soft);
    position: relative;
  }
  .menu-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    background: var(--gradient-gold-fill);
  }
  .menu-card__header { text-align: center; }
  .menu-card__header .eyebrow { margin-bottom: var(--space-1); }
  .menu-card__header h3 {
    color: var(--color-gold-deep);
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    margin: 0 0 var(--space-2);
  }
  .menu-card__header .caterer {
    color: var(--color-text-muted);
    font-style: italic;
    letter-spacing: 0.04em;
    margin: 0 0 var(--space-3);
  }
  .menu-card__header .intro {
    max-width: 38rem;
    margin: 0 auto;
    color: var(--color-text);
  }

  .menu-courses {
    list-style: none;
    padding: 0;
    margin: var(--space-5) 0 0;
    display: grid;
    gap: var(--space-4);
  }
  .menu-course {
    padding-top: var(--space-3);
    border-top: 1px dashed var(--color-rule);
  }
  .menu-course:first-child { border-top: none; padding-top: 0; }

  .menu-course__head { display: flex; align-items: baseline; gap: var(--space-3); margin-bottom: var(--space-2); }
  .menu-course__head h4 {
    margin: 0;
    color: var(--color-gold-deep);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
  }
  .course-number {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    color: var(--color-gold);
    border: 1px solid var(--color-gold);
    border-radius: 999px;
    padding: 0.25rem 0.6rem;
    flex-shrink: 0;
  }
  .course-note {
    margin: 0.15rem 0 0;
    font-size: var(--fs-small);
    font-style: italic;
    color: var(--color-text-muted);
  }
  .course-options {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-1);
  }
  .course-options li {
    padding: 0.4rem 0.9rem;
    border-left: 2px solid var(--color-gold-light);
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.4);
  }
  .course-sides {
    margin: var(--space-2) 0 0;
    font-size: var(--fs-small);
    color: var(--color-text-muted);
    font-style: italic;
  }

  .menu-beverages {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-rule);
  }
  .menu-beverages h4 {
    margin: 0 0 var(--space-2);
    color: var(--color-gold-deep);
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2.2vw, 1.45rem);
    text-align: center;
  }
  .menu-beverages ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-1);
  }
  .menu-beverages li {
    padding: 0.4rem 0.9rem;
    border-left: 2px solid var(--color-gold-light);
    color: var(--color-text);
    background: rgba(255, 255, 255, 0.4);
  }

  .menu-footnote {
    margin: var(--space-4) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-rule);
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    text-align: center;
  }

  @media (min-width: 760px) {
    .menu-card { padding: var(--space-5); }
    .menu-courses { gap: var(--space-5); }
  }
</style>
