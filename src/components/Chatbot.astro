---
import { t, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;

const ui = locale === 'es' ? {
  buttonLabel: 'Asistente de boda',
  open: 'Abrir asistente de boda',
  close: 'Cerrar asistente',
  title: 'Asistente de John y Diana',
  subtitle: 'Pregúntame sobre la boda, el viaje o Quito',
  placeholder: 'Escribe tu pregunta…',
  send: 'Enviar',
  greeting: 'Imanalla — hola. Soy el asistente de la boda de John y Diana. ¿En qué puedo ayudarte? Puedo responder sobre el día de la boda, el viaje a Quito, hospedaje, RSVP y más.',
  errorGeneric: 'Lo siento, algo salió mal. Por favor intenta de nuevo o escribe a rsvp@johnanddianaswedding.com.',
  errorRate: 'Has hecho varias preguntas seguidas. Por favor espera un momento e intenta de nuevo.',
  retry: 'Reintentar',
  clear: 'Borrar conversación',
  poweredBy: 'Respuestas con IA · Verifica detalles con la pareja para temas importantes.'
} : {
  buttonLabel: 'Wedding Helper',
  open: 'Open wedding helper',
  close: 'Close wedding helper',
  title: 'John & Diana\u2019s Wedding Helper',
  subtitle: 'Ask about the wedding, your trip, or Quito',
  placeholder: 'Type your question…',
  send: 'Send',
  greeting: 'Hi — I\u2019m the helper for John & Diana\u2019s wedding. Ask me about the wedding day, travel to Quito, hotels, RSVP, and more. How can I help?',
  errorGeneric: 'Sorry, something went wrong. Please try again, or email rsvp@johnanddianaswedding.com.',
  errorRate: 'You\u2019ve asked several questions in a row. Please wait a moment and try again.',
  retry: 'Retry',
  clear: 'Clear chat',
  poweredBy: 'AI-assisted answers · Double-check important details with the couple.'
};

const suggestions = locale === 'es' ? [
  '¿A qué hora es la ceremonia?',
  '¿Dónde debería hospedarme?',
  '¿Cómo es el clima en marzo?'
] : [
  'What time is the ceremony?',
  'Where should I stay?',
  'What\u2019s the weather like in March?'
];
---

<div
  class="chatbot"
  data-chatbot
  data-locale={locale}
  data-greeting={ui.greeting}
  data-error-generic={ui.errorGeneric}
  data-error-rate={ui.errorRate}
>
  <button
    type="button"
    class="chatbot__launcher"
    aria-label={ui.open}
    aria-expanded="false"
    aria-controls="chatbot-panel"
    data-launcher
  >
    <svg class="chatbot__launcher-icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
      <path d="M4 5a3 3 0 0 1 3-3h10a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3h-5l-4 4v-4H7a3 3 0 0 1-3-3V5Z" fill="currentColor"></path>
    </svg>
    <span class="chatbot__launcher-label">{ui.buttonLabel}</span>
  </button>

  <section
    class="chatbot__panel"
    id="chatbot-panel"
    role="dialog"
    aria-modal="false"
    aria-labelledby="chatbot-title"
    hidden
    data-panel
  >
    <header class="chatbot__header">
      <div>
        <p class="chatbot__title" id="chatbot-title">{ui.title}</p>
        <p class="chatbot__subtitle">{ui.subtitle}</p>
      </div>
      <button type="button" class="chatbot__close" aria-label={ui.close} data-close>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
      </button>
    </header>

    <ol class="chatbot__messages" data-messages aria-live="polite" aria-relevant="additions"></ol>

    <div class="chatbot__suggestions" data-suggestions>
      {suggestions.map((s) => (
        <button type="button" class="chatbot__suggestion" data-suggestion={s}>{s}</button>
      ))}
    </div>

    <form class="chatbot__form" data-form autocomplete="off">
      <label class="sr-only" for="chatbot-input">{ui.placeholder}</label>
      <textarea
        id="chatbot-input"
        class="chatbot__input"
        placeholder={ui.placeholder}
        rows="1"
        maxlength="800"
        data-input
        required
      ></textarea>
      <button type="submit" class="chatbot__send" data-send>
        <span class="chatbot__send-label">{ui.send}</span>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M3 21l18-9L3 3l4 7 9 2-9 2-4 7Z" fill="currentColor"></path></svg>
      </button>
    </form>

    <footer class="chatbot__footer">
      <button type="button" class="chatbot__link" data-clear>{ui.clear}</button>
      <span class="chatbot__meta">{ui.poweredBy}</span>
    </footer>
  </section>
</div>

<script>
  (() => {
    const root = document.querySelector('[data-chatbot]');
    if (!root) return;
    const locale = root.dataset.locale;
    const greeting = root.dataset.greeting;
    const errorGeneric = root.dataset.errorGeneric;
    const errorRate = root.dataset.errorRate;
    const launcher = root.querySelector('[data-launcher]');
    const panel = root.querySelector('[data-panel]');
    const closeBtn = root.querySelector('[data-close]');
    const messagesEl = root.querySelector('[data-messages]');
    const form = root.querySelector('[data-form]');
    const input = root.querySelector('[data-input]');
    const sendBtn = root.querySelector('[data-send]');
    const clearBtn = root.querySelector('[data-clear]');
    const suggestionsWrap = root.querySelector('[data-suggestions]');

    const STORAGE_KEY = 'wc-chat-v1-' + locale;
    let history = [];
    let busy = false;

    function loadHistory() {
      try {
        const raw = sessionStorage.getItem(STORAGE_KEY);
        if (!raw) return [];
        const parsed = JSON.parse(raw);
        if (!Array.isArray(parsed)) return [];
        return parsed.filter((m) => m && (m.role === 'user' || m.role === 'assistant') && typeof m.content === 'string');
      } catch { return []; }
    }
    function saveHistory() {
      try { sessionStorage.setItem(STORAGE_KEY, JSON.stringify(history.slice(-20))); } catch {}
    }

    function escapeHtml(s) {
      return s.replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c]));
    }
    function linkify(s) {
      const esc = escapeHtml(s);
      return esc
        .replace(/(https?:\/\/[^\s<]+)/g, '<a href="$1" target="_blank" rel="noopener noreferrer">$1</a>')
        .replace(/(^|\s)(\/[a-z0-9/_-]+)(?=\s|$)/gi, '$1<a href="$2">$2</a>')
        .replace(/([\w.+-]+@[\w-]+\.[\w.-]+)/g, '<a href="mailto:$1">$1</a>')
        .replace(/\n/g, '<br>');
    }

    function appendMessage(role, content, opts) {
      const li = document.createElement('li');
      li.className = 'chatbot__msg chatbot__msg--' + role;
      const bubble = document.createElement('div');
      bubble.className = 'chatbot__bubble';
      if (opts && opts.typing) {
        bubble.classList.add('chatbot__bubble--typing');
        bubble.innerHTML = '<span></span><span></span><span></span>';
      } else {
        bubble.innerHTML = linkify(content);
      }
      li.appendChild(bubble);
      messagesEl.appendChild(li);
      messagesEl.scrollTop = messagesEl.scrollHeight;
      return li;
    }

    function renderAll() {
      messagesEl.innerHTML = '';
      if (history.length === 0) {
        appendMessage('assistant', greeting);
      } else {
        for (const m of history) appendMessage(m.role, m.content);
      }
    }

    function setBusy(b) {
      busy = b;
      sendBtn.disabled = b;
      input.disabled = b;
      if (b) {
        suggestionsWrap.setAttribute('hidden', '');
      } else {
        if (history.length === 0) suggestionsWrap.removeAttribute('hidden');
        else suggestionsWrap.setAttribute('hidden', '');
      }
    }

    async function sendMessage(text) {
      const trimmed = text.trim().slice(0, 800);
      if (!trimmed || busy) return;
      history.push({ role: 'user', content: trimmed });
      appendMessage('user', trimmed);
      saveHistory();
      input.value = '';
      input.style.height = 'auto';
      setBusy(true);
      const typingNode = appendMessage('assistant', '', { typing: true });

      let payload;
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 30000);
      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'omit',
          cache: 'no-store',
          signal: controller.signal,
          body: JSON.stringify({
            message: trimmed,
            locale,
            history: history.slice(-12, -1)
          })
        });
        payload = await res.json().catch(() => ({}));
        typingNode.remove();
        if (res.status === 429) {
          appendMessage('assistant', errorRate);
        } else if (!res.ok) {
          const fallback = typeof payload.reply === 'string' ? String(payload.reply).slice(0, 4000) : errorGeneric;
          appendMessage('assistant', fallback);
        } else if (payload && typeof payload.reply === 'string') {
          const reply = String(payload.reply).slice(0, 4000);
          history.push({ role: 'assistant', content: reply });
          appendMessage('assistant', reply);
          saveHistory();
        } else {
          appendMessage('assistant', errorGeneric);
        }
      } catch (e) {
        typingNode.remove();
        appendMessage('assistant', errorGeneric);
      } finally {
        clearTimeout(timeoutId);
        setBusy(false);
        input.focus();
      }
    }

    function openPanel() {
      panel.hidden = false;
      launcher.setAttribute('aria-expanded', 'true');
      root.classList.add('chatbot--open');
      requestAnimationFrame(() => input.focus());
    }
    function closePanel() {
      panel.hidden = true;
      launcher.setAttribute('aria-expanded', 'false');
      root.classList.remove('chatbot--open');
    }

    launcher.addEventListener('click', () => {
      if (root.classList.contains('chatbot--open')) closePanel(); else openPanel();
    });
    closeBtn.addEventListener('click', closePanel);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && root.classList.contains('chatbot--open')) closePanel();
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      sendMessage(input.value);
    });
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && !e.shiftKey) {
        e.preventDefault();
        sendMessage(input.value);
      }
    });
    input.addEventListener('input', () => {
      input.style.height = 'auto';
      input.style.height = Math.min(input.scrollHeight, 140) + 'px';
    });

    suggestionsWrap.addEventListener('click', (e) => {
      const btn = e.target && e.target.closest && e.target.closest('[data-suggestion]');
      if (!btn) return;
      sendMessage(btn.getAttribute('data-suggestion'));
    });

    clearBtn.addEventListener('click', () => {
      history = [];
      saveHistory();
      renderAll();
      setBusy(false);
    });

    history = loadHistory();
    renderAll();
  })();
</script>

<style>
  .chatbot { position: fixed; right: clamp(0.75rem, 2vw, 1.5rem); bottom: clamp(0.75rem, 2vw, 1.5rem); z-index: 60; font-family: var(--font-body); }

  .chatbot__launcher {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.7rem 1.1rem;
    border: 1px solid var(--color-gold-deep);
    border-radius: 999px;
    background: var(--gradient-gold-fill);
    background-size: 200% 200%;
    background-position: 0% 50%;
    color: var(--color-surface);
    font-family: var(--font-body);
    font-size: var(--fs-small);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    cursor: pointer;
    box-shadow: var(--shadow-md);
    transition: background-position var(--transition), box-shadow var(--transition), transform var(--transition);
  }
  .chatbot__launcher:hover, .chatbot__launcher:focus-visible { background-position: 100% 50%; box-shadow: var(--shadow-soft); transform: translateY(-1px); outline: none; }
  .chatbot__launcher-icon { flex-shrink: 0; }
  .chatbot--open .chatbot__launcher { display: none; }

  @media (max-width: 480px) {
    .chatbot__launcher-label { display: none; }
    .chatbot__launcher { padding: 0.85rem; }
  }

  .chatbot__panel {
    position: fixed;
    right: clamp(0.5rem, 2vw, 1.5rem);
    bottom: clamp(0.5rem, 2vw, 1.5rem);
    width: min(22rem, calc(100vw - 1rem));
    max-height: min(34rem, calc(100vh - 1rem));
    display: none;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid rgba(212, 175, 55, 0.35);
    border-radius: var(--radius-lg);
    box-shadow: 0 18px 60px rgba(168, 132, 47, 0.18), 0 8px 24px rgba(42, 37, 32, 0.10);
    overflow: hidden;
  }
  .chatbot__panel:not([hidden]) {
    display: flex;
    animation: chatbot-rise 220ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @media (max-width: 520px) {
    .chatbot__panel {
      width: calc(100vw - 0.75rem);
      right: 0.375rem;
      bottom: 0.375rem;
      max-height: calc(100vh - 0.75rem);
    }
  }
  @keyframes chatbot-rise { from { opacity: 0; transform: translateY(8px) scale(0.98); } to { opacity: 1; transform: none; } }

  .chatbot__header {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    padding: 0.85rem 1rem 0.75rem;
    border-bottom: 1px solid rgba(212, 175, 55, 0.2);
    background: var(--gradient-surface);
  }
  .chatbot__title { margin: 0; font-family: var(--font-display); font-size: 1.2rem; line-height: 1.15; color: var(--color-text); font-weight: 500; }
  .chatbot__subtitle { margin: 0.15rem 0 0; font-size: var(--fs-tiny); letter-spacing: 0.06em; color: var(--color-text-muted); }
  .chatbot__close { margin-left: auto; width: 2rem; height: 2rem; display: grid; place-content: center; border: 0; border-radius: 999px; background: transparent; color: var(--color-text-muted); cursor: pointer; transition: background var(--transition), color var(--transition); }
  .chatbot__close:hover, .chatbot__close:focus-visible { background: var(--color-surface-pearl); color: var(--color-gold-deep); outline: none; }

  .chatbot__messages { list-style: none; margin: 0; padding: 0.85rem 0.9rem; display: flex; flex-direction: column; gap: 0.55rem; overflow-y: auto; flex: 1 1 auto; background: var(--color-bg); scroll-behavior: smooth; }
  .chatbot__msg { display: flex; }
  .chatbot__msg--user { justify-content: flex-end; }
  .chatbot__msg--assistant { justify-content: flex-start; }
  .chatbot__bubble {
    max-width: 85%;
    padding: 0.6rem 0.85rem;
    border-radius: 14px;
    font-size: var(--fs-small);
    line-height: 1.45;
    word-wrap: break-word;
    box-shadow: 0 1px 2px rgba(42, 37, 32, 0.05);
  }
  .chatbot__msg--assistant .chatbot__bubble { background: var(--color-surface); border: 1px solid rgba(212, 175, 55, 0.22); color: var(--color-text); border-bottom-left-radius: 4px; }
  .chatbot__msg--user .chatbot__bubble { background: var(--gradient-gold-fill); background-size: 200% 200%; background-position: 0% 50%; color: var(--color-surface); border-bottom-right-radius: 4px; }
  .chatbot__bubble a { color: inherit; border-bottom: 1px solid currentColor; }
  .chatbot__bubble--typing { display: inline-flex; gap: 4px; align-items: center; padding: 0.75rem 1rem; }
  .chatbot__bubble--typing span { width: 6px; height: 6px; border-radius: 50%; background: var(--color-gold-deep); opacity: 0.35; animation: chatbot-dot 1.2s infinite ease-in-out; }
  .chatbot__bubble--typing span:nth-child(2) { animation-delay: 0.15s; }
  .chatbot__bubble--typing span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes chatbot-dot { 0%, 80%, 100% { opacity: 0.3; transform: translateY(0); } 40% { opacity: 1; transform: translateY(-2px); } }

  .chatbot__suggestions { display: flex; flex-wrap: wrap; gap: 0.35rem; padding: 0 0.9rem 0.65rem; }
  .chatbot__suggestions[hidden] { display: none; }
  .chatbot__suggestion {
    border: 1px solid rgba(212, 175, 55, 0.35);
    background: var(--color-surface);
    color: var(--color-text);
    font-size: var(--fs-tiny);
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    cursor: pointer;
    transition: border-color var(--transition), color var(--transition), background var(--transition);
  }
  .chatbot__suggestion:hover, .chatbot__suggestion:focus-visible { border-color: var(--color-gold-deep); color: var(--color-gold-deep); background: var(--color-bg-shimmer); outline: none; }

  .chatbot__form { display: flex; gap: 0.5rem; align-items: flex-end; padding: 0.65rem 0.9rem 0.5rem; border-top: 1px solid rgba(212, 175, 55, 0.18); background: var(--color-surface); }
  .chatbot__input {
    flex: 1 1 auto;
    resize: none;
    border: 1px solid var(--color-rule-silver);
    border-radius: 12px;
    padding: 0.55rem 0.7rem;
    font-family: inherit;
    font-size: var(--fs-small);
    line-height: 1.4;
    background: var(--color-bg);
    color: var(--color-text);
    max-height: 140px;
    transition: border-color var(--transition);
  }
  .chatbot__input:focus { outline: none; border-color: var(--color-gold-deep); }
  .chatbot__send {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    border: 1px solid var(--color-gold-deep);
    background: var(--gradient-gold-fill);
    background-size: 200% 200%;
    background-position: 0% 50%;
    color: var(--color-surface);
    padding: 0.55rem 0.85rem;
    border-radius: 10px;
    font-size: var(--fs-tiny);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    transition: background-position var(--transition), box-shadow var(--transition);
  }
  .chatbot__send:hover, .chatbot__send:focus-visible { background-position: 100% 50%; box-shadow: var(--shadow-sm); outline: none; }
  .chatbot__send:disabled { opacity: 0.6; cursor: not-allowed; }
  .chatbot__send-label { display: none; }
  @media (min-width: 380px) { .chatbot__send-label { display: inline; } }

  .chatbot__footer { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; padding: 0.35rem 0.9rem 0.65rem; background: var(--color-surface); }
  .chatbot__link { border: 0; background: transparent; color: var(--color-text-muted); font-size: 0.75rem; cursor: pointer; padding: 0.15rem 0; text-decoration: underline dotted; text-underline-offset: 3px; }
  .chatbot__link:hover, .chatbot__link:focus-visible { color: var(--color-gold-deep); outline: none; }
  .chatbot__meta { font-size: 0.65rem; color: var(--color-text-soft); letter-spacing: 0.04em; text-align: right; }

  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }

  @media (prefers-reduced-motion: reduce) {
    .chatbot__panel:not([hidden]) { animation: none; }
    .chatbot__bubble--typing span { animation: none; opacity: 0.5; }
  }
</style>
