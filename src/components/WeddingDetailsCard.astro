---
import config from '../data/wedding.config.json';
import { t, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const date = locale === 'es' ? config.wedding.dateDisplayEs : config.wedding.dateDisplayEn;
const { ceremony, reception } = config.venues;
---

<article class="details-card reveal">
  <p class="eyebrow">{t(locale, 'home.detailsEyebrow')}</p>
  <h2>{date}</h2>
  <div class="detail-grid">
    <section>
      <h3>{t(locale, 'home.ceremony')}</h3>
      <p>{ceremony.name}</p>
      <p class="time">{config.wedding.ceremonyTimeDisplay}</p>
      <a href={ceremony.mapsUrl} target="_blank" rel="noopener noreferrer">{t(locale, 'common.viewOnMap')}</a>
    </section>
    <section>
      <h3>{t(locale, 'home.reception')}</h3>
      <p>{reception.name}</p>
      <p class="time">{config.wedding.receptionTimeDisplay}</p>
      <a href={reception.mapsUrl} target="_blank" rel="noopener noreferrer">{t(locale, 'common.viewOnMap')}</a>
    </section>
  </div>
  <p class="note">{t(locale, 'home.shortWalkBetween')}</p>
</article>

<style>
  .details-card {
    position: relative;
    max-width: 48rem;
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--gradient-surface);
    box-shadow: var(--shadow-soft);
    text-align: center;
  }
  .details-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    background: var(--gradient-gold-fill);
  }
  h2 {
    color: var(--color-gold-deep);
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    margin-top: var(--space-2);
  }
  .detail-grid { display: grid; gap: var(--space-3); margin-top: var(--space-4); }
  h3 {
    font-size: 0.85rem;
    margin-bottom: var(--space-1);
    color: var(--color-gold-deep);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-family: var(--font-body);
    font-weight: 600;
  }
  section p { margin: 0.25rem 0; }
  section p:first-of-type { font-family: var(--font-display); font-size: 1.25rem; color: var(--color-text); }
  .time { color: var(--color-text-muted); font-weight: 500; font-style: italic; }
  .note {
    margin: var(--space-3) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-rule);
    color: var(--color-text-muted);
    font-size: var(--fs-small);
    font-style: italic;
  }
  @media (min-width: 700px) { .detail-grid { grid-template-columns: 1fr 1fr; } .detail-grid section { padding: 0 var(--space-2); } .detail-grid section + section { border-left: 1px solid var(--color-rule); } }
</style>
