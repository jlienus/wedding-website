---
import config from '../data/wedding.config.json';
import { t, type Locale } from '../lib/i18n';

type Venue = Record<string, any>;
interface Props { venue: Venue; photoUrlBase?: string; locale?: Locale }
const { venue = {}, photoUrlBase = '/images/', locale = 'en' } = Astro.props;
const id = String(venue.id ?? venue.key ?? venue.type ?? '').toLowerCase();
const venueConfig = id.includes('reception') ? config.venues.reception : id.includes('ceremony') ? config.venues.ceremony : undefined;
const name = venue.name ?? venueConfig?.name ?? t(locale, 'venues.unnamed');
const address = venue.address ?? venueConfig?.address ?? [venueConfig?.addressLine1, venueConfig?.addressLine2, venueConfig?.city, venueConfig?.country].filter(Boolean).join(', ');
const mapsUrl = venue.mapsUrl ?? venueConfig?.mapsUrl ?? '';
const blurb = locale === 'es' ? (venue.blurbEs ?? venue.blurb) : (venue.blurbEn ?? venue.blurb);
const tips = (locale === 'es' ? (venue.tipsEs ?? venue.tips) : (venue.tipsEn ?? venue.tips)) ?? [];
const photoSlot = venue.photoSlot ?? venue.photo ?? 'venue-placeholder.jpg';
const caption = venue.caption ?? name;
---

<article class="venue-card reveal">
  <figure>
    <img src={`${photoUrlBase}${photoSlot}`} alt={caption} loading="lazy" onerror="this.style.display='none'; this.closest('figure')?.classList.add('image-missing');" />
    {caption && <figcaption>{caption}</figcaption>}
  </figure>
  <div class="content">
    <h2>{name}</h2>
    {address && <p class="address">{address}</p>}
    {blurb && <p>{blurb}</p>}
    {Array.isArray(tips) && tips.length > 0 && (
      <ul>
        {tips.map((tip: string) => <li>{tip}</li>)}
      </ul>
    )}
    {mapsUrl && <a class="map-link" href={mapsUrl} target="_blank" rel="noopener noreferrer">{t(locale, 'common.openInGoogleMaps')}</a>}
  </div>
</article>

<style>
  .venue-card { display: grid; gap: var(--space-3); overflow: hidden; border: 1px solid var(--color-rule); border-radius: var(--radius-lg); background: rgba(255,255,255,0.58); box-shadow: var(--shadow-sm); }
  figure { position: relative; min-height: 18rem; margin: 0; background: linear-gradient(135deg, var(--color-bg), rgba(201,169,97,0.3)); }
  img { width: 100%; height: 100%; min-height: 18rem; object-fit: cover; }
  figcaption { position: absolute; left: var(--space-2); bottom: var(--space-2); padding: 0.25rem 0.65rem; border-radius: 999px; background: rgba(0,0,0,0.48); color: white; font-size: var(--fs-tiny); }
  .content { padding: 0 var(--space-3) var(--space-3); }
  h2 { color: var(--color-gold-deep); }
  .address { color: var(--color-text-muted); font-size: var(--fs-small); }
  ul { padding-left: 1.2rem; color: var(--color-text-muted); }
  .map-link { display: inline-block; margin-top: var(--space-2); }
  @media (min-width: 760px) { .venue-card { grid-template-columns: minmax(16rem, 0.9fr) 1.1fr; } .content { padding: var(--space-3) var(--space-3) var(--space-3) 0; } }
</style>

