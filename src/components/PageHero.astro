---
interface Props {
  photoSlot: string;
  imageAlt: string;
  variant?: 'default' | 'showcase';
}
const { photoSlot, imageAlt, variant = 'default' } = Astro.props;
---

<section class:list={['page-hero', `page-hero--${variant}`]} aria-label={imageAlt}>
  <picture>
    <img src={`/images/${photoSlot}`} alt={imageAlt} loading="eager" decoding="async" onerror="this.style.display='none'; this.closest('.page-hero')?.classList.add('image-missing');" />
  </picture>
  <noscript><img src={`/images/${photoSlot}`} alt={imageAlt} /></noscript>
  <div class="page-hero-inner container container--narrow reveal">
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    left: 50%;
    right: 50%;
    width: 100vw;
    margin-left: -50vw;
    margin-right: -50vw;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(ellipse at 50% 30%, var(--color-bg-shimmer) 0%, var(--color-bg) 55%, var(--color-surface-pearl) 100%);
  }
  picture,
  .page-hero > picture img { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; }
  .page-hero > picture img {
    object-fit: cover;
    opacity: 0.22;
    filter: saturate(0.78) brightness(1.28) contrast(0.88);
    mix-blend-mode: luminosity;
  }
  .page-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 78% 62% at 50% 55%,
        rgba(252, 251, 247, 0.90) 0%,
        rgba(252, 251, 247, 0.72) 42%,
        rgba(252, 251, 247, 0.38) 75%,
        transparent 100%),
      linear-gradient(180deg, rgba(255, 254, 251, 0.6) 0%, transparent 22%, transparent 78%, rgba(252, 251, 247, 0.75) 100%);
    pointer-events: none;
  }
  .page-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 0%, transparent 65%, rgba(212, 175, 55, 0.05) 100%);
    pointer-events: none;
  }
  .page-hero-inner {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: clamp(var(--space-4), 6vh, var(--space-5)) var(--space-3);
  }
  .page-hero-inner :global(.eyebrow) {
    text-shadow: 0 1px 12px rgba(252, 251, 247, 0.9), 0 0 24px rgba(252, 251, 247, 0.55);
  }
  .page-hero-inner :global(h1) {
    text-shadow: 0 1px 14px rgba(252, 251, 247, 0.9), 0 0 22px rgba(252, 251, 247, 0.6);
  }
  .page-hero-inner :global(p) {
    text-shadow: 0 1px 10px rgba(252, 251, 247, 0.85);
  }

  /* Showcase variant: for personal photos that deserve to be seen, not
     used as ambient texture. Taller band, lighter fade, position-biased
     to keep portrait-source subjects in frame on wide aspect ratios. */
  .page-hero--showcase { min-height: clamp(440px, 62vh, 620px); }
  .page-hero--showcase > picture img {
    opacity: 0.68;
    filter: saturate(0.96) brightness(1.06) contrast(0.96);
    mix-blend-mode: normal;
    object-position: center 45%;
  }
  .page-hero--showcase::before {
    background:
      radial-gradient(ellipse 62% 42% at 50% 33%,
        rgba(252, 251, 247, 0.88) 0%,
        rgba(252, 251, 247, 0.68) 35%,
        rgba(252, 251, 247, 0.40) 65%,
        rgba(252, 251, 247, 0.14) 85%,
        transparent 100%),
      linear-gradient(180deg,
        rgba(255, 254, 251, 0.55) 0%,
        rgba(255, 254, 251, 0.30) 15%,
        rgba(255, 254, 251, 0.10) 30%,
        transparent 45%,
        transparent 72%,
        rgba(252, 251, 247, 0.72) 100%);
  }
  /* Showcase eyebrow: use full-strength text color (not muted) so the
     small-caps line reads against the bright photo. Pure CSS — falls
     back gracefully if a page doesn't pass an .eyebrow into the slot.

     Letters get a tight 8-direction 1px ivory paint outline so each
     character keeps a crisp edge over busy parts of the photo (e.g.
     "Imanalla" sitting over the volcano silhouette). The earlier blurry
     glow alone wasn't enough — the wide halos bleed in opposite
     directions when the photo has both highlights and shadows behind
     adjacent letters. The 8-direction stack guarantees every letter has
     a continuous 1px white edge, then two softer glows add ambient lift. */
  .page-hero--showcase .page-hero-inner :global(.eyebrow) {
    color: var(--color-text);
    text-shadow:
      -1px -1px 0 rgba(252, 251, 247, 0.95),
       0   -1px 0 rgba(252, 251, 247, 0.95),
       1px -1px 0 rgba(252, 251, 247, 0.95),
       1px  0   0 rgba(252, 251, 247, 0.95),
       1px  1px 0 rgba(252, 251, 247, 0.95),
       0    1px 0 rgba(252, 251, 247, 0.95),
      -1px  1px 0 rgba(252, 251, 247, 0.95),
      -1px  0   0 rgba(252, 251, 247, 0.95),
       0    0   8px rgba(252, 251, 247, 0.9),
       0    0   18px rgba(252, 251, 247, 0.75);
  }
  .page-hero--showcase .page-hero-inner :global(h1),
  .page-hero--showcase .page-hero-inner :global(p) {
    text-shadow:
      0 0 1px rgba(42, 37, 32, 0.35),
      0 1px 2px rgba(252, 251, 247, 0.95),
      0 2px 14px rgba(252, 251, 247, 0.95),
      0 0 28px rgba(252, 251, 247, 0.85);
  }
</style>
