---
import { t, type Locale } from '../lib/i18n';

interface Props { locale: Locale }
const { locale } = Astro.props;

const travelHref = locale === 'es' ? '/es/viajes' : '/travel';
const rsvpHref = locale === 'es' ? '/es/rsvp' : '/rsvp';
---

<section class="hero-cta" aria-label={t(locale, 'nav.rsvp')}>
  <div class="hero-cta__inner">
    <a class="btn btn--gold" href={rsvpHref}>{t(locale, 'nav.rsvp')}</a>
    <a class="btn btn--ghost" href={travelHref}>{t(locale, 'nav.travel')}</a>
  </div>
</section>

<style>
  .hero-cta {
    background: var(--gradient-surface);
    border-top: 1px solid rgba(212, 175, 55, 0.18);
    border-bottom: 1px solid rgba(212, 175, 55, 0.18);
    padding: var(--space-3) var(--space-3);
    box-shadow: var(--shadow-sm);
  }
  .hero-cta__inner {
    max-width: var(--container-default);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }
</style>
