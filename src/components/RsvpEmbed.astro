---
import config from '../data/wedding.config.json';
import { t, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const embedUrl = config.rsvp?.embedUrl ?? '';
const fallbackUrl = config.rsvp?.fallbackUrl ?? '';
const pending = !embedUrl || embedUrl === 'RSVPIFY_EMBED_URL_GOES_HERE';
const fallbackIsPlaceholder = !fallbackUrl || fallbackUrl === 'RSVPIFY_PUBLIC_URL_GOES_HERE';
const contactEmail = (config.rsvp as any)?.contactEmail ?? '';
const fallbackHref = !fallbackIsPlaceholder ? fallbackUrl : (contactEmail ? `mailto:${contactEmail}` : '');
---

<section class="rsvp-embed reveal">
  {pending ? (
    <article class="placeholder">
      <h2>{t(locale, 'rsvp.setupPendingTitle')}</h2>
      <p>{t(locale, 'rsvp.setupPendingBody')}</p>
      {fallbackHref && <a class="btn btn--gold" href={fallbackHref}>{t(locale, 'rsvp.fallbackLink')}</a>}
    </article>
  ) : (
    <>
      <iframe src={embedUrl} loading="lazy" title="RSVP" style="width:100%; min-height:900px; border:0;"></iframe>
      <noscript><a href={!fallbackIsPlaceholder ? fallbackUrl : embedUrl}>{t(locale, 'rsvp.fallbackLink')}</a></noscript>
    </>
  )}
</section>

<style>
  .rsvp-embed { max-width: 58rem; margin: 0 auto; }
  .placeholder {
    position: relative;
    padding: var(--space-5) var(--space-4);
    text-align: center;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--gradient-surface);
    box-shadow: var(--shadow-soft);
    overflow: hidden;
  }
  .placeholder::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--gradient-gold-fill);
  }
  .placeholder h2 { color: var(--color-gold-deep); margin-top: var(--space-2); }
  .placeholder .btn { margin-top: var(--space-2); }
</style>

