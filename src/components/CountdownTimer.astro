---
import { weddingMoment } from '../lib/dates';
import { t, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const labels = {
  days: t(locale, 'common.days'),
  hours: t(locale, 'common.hours'),
  minutes: t(locale, 'common.minutes'),
  seconds: t(locale, 'common.seconds'),
  past: t(locale, 'common.weddingPast'),
};
---

<section class="countdown reveal" data-countdown data-target={weddingMoment().toISOString()} data-past={labels.past} aria-live="polite">
  <div class="unit"><strong data-days>0</strong><span>{labels.days}</span></div>
  <div class="unit"><strong data-hours>0</strong><span>{labels.hours}</span></div>
  <div class="unit"><strong data-minutes>0</strong><span>{labels.minutes}</span></div>
  <div class="unit"><strong data-seconds>0</strong><span>{labels.seconds}</span></div>
</section>

<script is:inline>
  document.querySelectorAll('[data-countdown]').forEach((root) => {
    const target = new Date(root.dataset.target).getTime();
    const set = (selector, value) => { const el = root.querySelector(selector); if (el) el.textContent = String(value).padStart(2, '0'); };
    const tick = () => {
      const diff = target - Date.now();
      if (diff <= 0) { root.textContent = root.dataset.past || ''; return; }
      const total = Math.floor(diff / 1000);
      set('[data-days]', Math.floor(total / 86400));
      set('[data-hours]', Math.floor((total % 86400) / 3600));
      set('[data-minutes]', Math.floor((total % 3600) / 60));
      set('[data-seconds]', total % 60);
    };
    tick();
    setInterval(tick, 1000);
  });
</script>

<style>
  .countdown { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-2); max-width: 42rem; margin: var(--space-4) auto; }
  .unit { padding: var(--space-2); text-align: center; border: 1px solid var(--color-rule); border-radius: var(--radius-lg); background: rgba(255,255,255,0.58); box-shadow: var(--shadow-sm); }
  strong { display: block; font-family: var(--font-display); font-size: clamp(2.2rem, 7vw, 4rem); color: var(--color-gold); line-height: 1; }
  span { display: block; margin-top: 0.4rem; font-size: var(--fs-tiny); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted); }
  @media (min-width: 640px) { .countdown { grid-template-columns: repeat(4, 1fr); } }
</style>
