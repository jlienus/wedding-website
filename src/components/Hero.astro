---
import config from '../data/wedding.config.json';
import { t, type Locale } from '../lib/i18n';

interface Props { locale: Locale; photoSlot?: string }
const { locale, photoSlot = 'hero.jpg' } = Astro.props;
const date = locale === 'es' ? config.wedding.dateDisplayEs : config.wedding.dateDisplayEn;
const savedate = t(locale, 'hero.savedate');
const savedateLine = savedate === 'hero.savedate' ? date : `${savedate} ${date}`;
const cityVenue = `${config.venues.reception.city}, ${config.venues.reception.country} · ${config.venues.reception.name}`;
const travelHref = locale === 'es' ? '/es/viajes' : '/travel';
const rsvpHref = locale === 'es' ? '/es/rsvp' : '/rsvp';
---

<section class="hero" aria-label={config.couple.displayCombined}>
  <picture>
    <img src={`/images/${photoSlot}`} alt={t(locale, 'hero.imageAlt')} loading="eager" decoding="async" onerror="this.style.display='none'; this.closest('.hero')?.classList.add('image-missing');" />
  </picture>
  <noscript><img src={`/images/${photoSlot}`} alt={t(locale, 'hero.imageAlt')} /></noscript>
  <div class="hero-overlay reveal">
    <p class="eyebrow">{t(locale, 'heritage.header')}</p>
    <h1>{config.couple.monogram}</h1>
    <p class="save-date">{savedateLine}</p>
    <p class="subtitle">{cityVenue}</p>
    <div class="actions">
      <a class="btn btn--gold" href={rsvpHref}>{t(locale, 'nav.rsvp')}</a>
      <a class="btn" href={travelHref}>{t(locale, 'nav.travel')}</a>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; left: 50%; right: 50%; width: 100vw; min-height: 88vh; margin-left: -50vw; margin-right: -50vw; display: grid; place-items: center; overflow: hidden; background: linear-gradient(135deg, var(--color-bg), rgba(201,169,97,0.34)); }
  picture, .hero > picture img { position: absolute; inset: 0; width: 100%; height: 100%; max-width: none; }
  .hero > picture img { object-fit: cover; filter: saturate(0.95) brightness(0.82); }
  .hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(0,0,0,0.22), rgba(0,0,0,0.38)); }
  .hero-overlay { position: relative; z-index: 1; max-width: 56rem; padding: var(--space-5) var(--space-3); text-align: center; color: white; text-shadow: 0 2px 18px rgba(0,0,0,0.42); }
  .eyebrow { color: rgba(255,255,255,0.86); }
  h1 { font-size: clamp(4rem, 10vw, 6rem); letter-spacing: 0.18em; margin-bottom: var(--space-2); }
  .save-date { font-family: var(--font-display); font-size: clamp(1.6rem, 3vw, 2.25rem); line-height: var(--lh-snug); }
  .subtitle { font-size: var(--fs-small); letter-spacing: 0.08em; text-transform: uppercase; }
  .actions { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2); margin-top: var(--space-4); }
  .actions .btn { color: white; border-color: white; text-shadow: none; }
  .actions .btn:hover { background: white; color: var(--color-text); }
  .actions .btn--gold { color: white; background: var(--color-gold); border-color: var(--color-gold); }
</style>
