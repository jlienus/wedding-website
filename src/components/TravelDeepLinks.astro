---
import travelLinks from '../data/travel-links.json';
import { t, type Locale } from '../lib/i18n';
interface Props { locale: Locale }
const { locale } = Astro.props;
const links = travelLinks as any;
const flights = Array.isArray(links.flights) ? links.flights : Array.isArray(links.flightProviders) ? links.flightProviders : [];
const hotels = Array.isArray(links.hotels) ? links.hotels : Array.isArray(links.hotelProviders) ? links.hotelProviders : [];
const itemNote = (item: any) => locale === 'es' ? (item.noteEs ?? item.descriptionEs ?? item.note ?? '') : (item.noteEn ?? item.descriptionEn ?? item.note ?? '');
const itemUrl = (item: any) => item.url ?? item.href ?? '#';
---

<section class="deep-links reveal">
  <div class="group">
    <h2>{t(locale, 'travel.flights')}</h2>
    <div class="cards">
      {flights.length ? flights.map((item: any) => (
        <a class="provider-card" href={itemUrl(item)} target="_blank" rel="noopener noreferrer">
          <h3>{item.providerName ?? item.name ?? item.provider}</h3>
          {itemNote(item) && <p>{itemNote(item)}</p>}
          <span class="cta">{t(locale, 'common.search')} →</span>
        </a>
      )) : <p>{t(locale, 'common.moreSoon')}</p>}
    </div>
  </div>
  <div class="group">
    <h2>{t(locale, 'travel.hotels')}</h2>
    <div class="cards">
      {hotels.length ? hotels.map((item: any) => (
        <a class="provider-card" href={itemUrl(item)} target="_blank" rel="noopener noreferrer">
          <h3>{item.providerName ?? item.name ?? item.provider}</h3>
          {itemNote(item) && <p>{itemNote(item)}</p>}
          <span class="cta">{t(locale, 'common.search')} →</span>
        </a>
      )) : <p>{t(locale, 'common.moreSoon')}</p>}
    </div>
  </div>
</section>

<style>
  .deep-links { display: grid; gap: var(--space-4); }
  .group { display: grid; gap: var(--space-2); }
  .cards { display: grid; gap: var(--space-2); }
  .provider-card {
    display: block;
    padding: var(--space-3);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--gradient-surface);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
  }
  .provider-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-gold);
    box-shadow: var(--shadow-md);
  }
  .provider-card h3 { margin-bottom: 0.35rem; color: var(--color-gold-deep); font-size: 1.25rem; }
  .provider-card p { color: var(--color-text-muted); }
  .cta { font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--color-gold-deep); font-size: var(--fs-tiny); }
  @media (min-width: 720px) { .cards { grid-template-columns: repeat(3, 1fr); } }
</style>


