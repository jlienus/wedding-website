---
import type { Locale } from '../lib/i18n';

interface Props { currentLocale: Locale; currentPath: string }
const { currentLocale, currentPath } = Astro.props;
const normalizedPath = currentPath.replace(/\/$/, '') || '/';
const enToEs: Record<string, string> = {
  '/': '/es',
  '/our-story': '/es/nuestra-historia',
  '/venues': '/es/lugares',
  '/itinerary': '/es/itinerario',
  '/travel': '/es/viajes',
  '/rsvp': '/es/rsvp',
  '/registry': '/es/regalos',
  '/faq': '/es/preguntas',
};
const esToEn = Object.fromEntries(Object.entries(enToEs).map(([en, es]) => [es, en]));
const enHref = currentLocale === 'en' ? normalizedPath : esToEn[normalizedPath] ?? '/';
const esHref = currentLocale === 'es' ? normalizedPath : enToEs[normalizedPath] ?? '/es';
---

<div class="lang-switch" aria-label="Language switcher" data-current={currentLocale}>
  <a href={enHref} aria-current={currentLocale === 'en' ? 'true' : undefined} class:list={{ current: currentLocale === 'en' }} data-target-locale="en">EN</a>
  <a href={esHref} aria-current={currentLocale === 'es' ? 'true' : undefined} class:list={{ current: currentLocale === 'es' }} data-target-locale="es">ES</a>
</div>

<script>
  // Fire a telemetry event before the link navigates. AI SDK uses sendBeacon
  // under the hood so the event lands even when the page is about to unload.
  document.querySelectorAll('.lang-switch a[data-target-locale]').forEach((a) => {
    a.addEventListener('click', () => {
      const link = a as HTMLAnchorElement;
      const wrap = link.closest('.lang-switch') as HTMLElement | null;
      const from = wrap?.dataset.current ?? 'unknown';
      const to = link.dataset.targetLocale ?? 'unknown';
      if (from !== to) {
        window.appTelemetry?.trackEvent('language_switched', { from, to });
      }
    });
  });
</script>

<style>
  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.2rem;
    border: 1px solid var(--color-silver);
    border-radius: 999px;
    background: var(--color-surface);
    box-shadow: var(--shadow-sm);
  }
  a {
    border: 0;
    border-radius: 999px;
    padding: 0.32rem 0.6rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    transition: all var(--transition);
  }
  a:hover { color: var(--color-gold-deep); }
  a.current {
    background: var(--gradient-gold-fill);
    color: var(--color-surface);
    font-weight: 700;
  }
</style>
