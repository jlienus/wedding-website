---
interface Labels {
  close: string;
  prev: string;
  next: string;
  counterTemplate: string;
  openHint: string;
}
interface Props {
  slots: string[];
  altPrefix?: string;
  labels?: Labels;
}
const {
  slots = [],
  altPrefix = 'Wedding photo',
  labels = {
    close: 'Close',
    prev: 'Previous photo',
    next: 'Next photo',
    counterTemplate: '{current} of {total}',
    openHint: 'click to enlarge',
  },
} = Astro.props;
---

<div class="gallery reveal" data-lightbox-gallery>
  {slots.map((slot, i) => (
    <figure>
      <button type="button" class="gallery-thumb" data-index={i} aria-label={`${altPrefix} ${i + 1}, ${labels.openHint}`}>
        <img src={`/images/${slot}`} alt={`${altPrefix} ${i + 1}`} loading="lazy" />
      </button>
    </figure>
  ))}
</div>

<dialog class="lightbox" data-lightbox aria-label={altPrefix} data-counter-template={labels.counterTemplate}>
  <button type="button" class="lightbox-btn lightbox-close" data-action="close" aria-label={labels.close}>
    <svg viewBox="0 0 24 24" width="1.25em" height="1.25em" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
      <line x1="6" y1="6" x2="18" y2="18" />
      <line x1="6" y1="18" x2="18" y2="6" />
    </svg>
  </button>
  <button type="button" class="lightbox-btn lightbox-prev" data-action="prev" aria-label={labels.prev}>
    <svg viewBox="0 0 24 24" width="1.25em" height="1.25em" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="15 6 9 12 15 18" />
    </svg>
  </button>
  <img class="lightbox-image" alt="" />
  <button type="button" class="lightbox-btn lightbox-next" data-action="next" aria-label={labels.next}>
    <svg viewBox="0 0 24 24" width="1.25em" height="1.25em" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <polyline points="9 6 15 12 9 18" />
    </svg>
  </button>
  <p class="lightbox-counter" aria-live="polite"></p>
</dialog>

<style>
  .gallery { display: grid; grid-template-columns: 1fr; gap: var(--space-2); }
  figure {
    overflow: hidden;
    margin: 0;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--color-silver-light), var(--color-bg), var(--color-gold-light));
    box-shadow: var(--shadow-sm);
  }
  .gallery-thumb {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    border-radius: inherit;
    overflow: hidden;
    -webkit-tap-highlight-color: transparent;
  }
  .gallery-thumb:focus-visible {
    outline: 2px solid var(--color-gold-deep);
    outline-offset: 3px;
  }
  img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; transition: transform 600ms ease; display: block; }
  figure:hover img { transform: scale(1.035); }
  @media (min-width: 620px) { .gallery { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 960px) { .gallery { grid-template-columns: repeat(3, 1fr); } }

  .lightbox {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    overflow: hidden;
    color: var(--color-bg);
  }
  .lightbox:not([open]) { display: none; }
  .lightbox::backdrop {
    background: rgba(80, 80, 80, 0.85);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
  }
  .lightbox-image {
    position: absolute;
    inset: 0;
    margin: auto;
    max-width: calc(100vw - 7rem);
    max-height: calc(100vh - 7rem);
    width: auto;
    height: auto;
    aspect-ratio: auto;
    object-fit: contain;
    border-radius: var(--radius-md);
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.45);
    transition: none;
  }
  .lightbox-image:hover { transform: none; }
  .lightbox-btn {
    position: absolute;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    border-radius: 50%;
    border: 1px solid rgba(252, 251, 247, 0.32);
    background: rgba(252, 251, 247, 0.92);
    color: var(--color-gold-deep);
    cursor: pointer;
    transition: background 200ms ease, transform 200ms ease, box-shadow 200ms ease;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.3);
    -webkit-tap-highlight-color: transparent;
  }
  .lightbox-btn:hover,
  .lightbox-btn:focus-visible {
    background: var(--color-bg);
    outline: none;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.42), 0 0 0 2px rgba(212, 175, 55, 0.45);
  }
  .lightbox-close { top: 1.5rem; right: 1.5rem; }
  .lightbox-prev { top: 50%; left: 1.5rem; transform: translateY(-50%); }
  .lightbox-next { top: 50%; right: 1.5rem; transform: translateY(-50%); }
  .lightbox-prev:hover,
  .lightbox-prev:focus-visible { transform: translateY(-50%) scale(1.05); }
  .lightbox-next:hover,
  .lightbox-next:focus-visible { transform: translateY(-50%) scale(1.05); }
  .lightbox-close:hover,
  .lightbox-close:focus-visible { transform: scale(1.05); }
  .lightbox-counter {
    position: absolute;
    bottom: 1.25rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    padding: 0.25rem 0.85rem;
    color: rgba(252, 251, 247, 0.92);
    background: rgba(20, 18, 14, 0.55);
    border-radius: 999px;
    font-size: var(--fs-small);
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  @media (max-width: 600px) {
    .lightbox-image { max-width: calc(100vw - 1rem); max-height: calc(100vh - 8rem); }
    .lightbox-btn { width: 2.5rem; height: 2.5rem; }
    .lightbox-close { top: 0.75rem; right: 0.75rem; }
    .lightbox-prev { left: 0.5rem; }
    .lightbox-next { right: 0.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox-btn { transition: none; }
    img { transition: none; }
    figure:hover img { transform: none; }
  }
</style>

<script>
  (() => {
    const gallery = document.querySelector('[data-lightbox-gallery]');
    const dialog = document.querySelector('[data-lightbox]') as HTMLDialogElement | null;
    if (!gallery || !dialog) return;

    const img = dialog.querySelector('.lightbox-image') as HTMLImageElement | null;
    const counter = dialog.querySelector('.lightbox-counter') as HTMLParagraphElement | null;
    const closeBtn = dialog.querySelector('[data-action="close"]');
    const prevBtn = dialog.querySelector('[data-action="prev"]');
    const nextBtn = dialog.querySelector('[data-action="next"]');
    const counterTemplate = dialog.dataset.counterTemplate || '{current} of {total}';
    if (!img || !counter || !closeBtn || !prevBtn || !nextBtn) return;

    const thumbs = Array.from(gallery.querySelectorAll('.gallery-thumb')) as HTMLButtonElement[];
    const slides = thumbs.map((btn) => {
      const thumbImg = btn.querySelector('img') as HTMLImageElement;
      return { src: thumbImg.src, alt: thumbImg.alt };
    });
    if (slides.length === 0) return;

    let current = 0;
    let lastTrigger: HTMLElement | null = null;

    const show = (i: number) => {
      current = (i + slides.length) % slides.length;
      const { src, alt } = slides[current];
      img.src = src;
      img.alt = alt;
      counter.textContent = counterTemplate
        .replace('{current}', String(current + 1))
        .replace('{total}', String(slides.length));
      // Preload neighbors so left/right feels instant
      [(current + 1) % slides.length, (current - 1 + slides.length) % slides.length].forEach((idx) => {
        const pre = new Image();
        pre.src = slides[idx].src;
      });
    };

    const open = (i: number, trigger: HTMLElement) => {
      lastTrigger = trigger;
      show(i);
      if (typeof dialog.showModal === 'function') {
        dialog.showModal();
      } else {
        dialog.setAttribute('open', '');
      }
      document.documentElement.style.overflow = 'hidden';
    };

    const cleanup = () => {
      document.documentElement.style.overflow = '';
      if (lastTrigger && typeof lastTrigger.focus === 'function') {
        lastTrigger.focus();
      }
      lastTrigger = null;
    };

    const close = () => {
      if (typeof dialog.close === 'function' && dialog.open) {
        dialog.close();
      } else {
        dialog.removeAttribute('open');
      }
      cleanup();
    };

    thumbs.forEach((btn, i) => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        open(i, btn);
      });
    });

    prevBtn.addEventListener('click', () => show(current - 1));
    nextBtn.addEventListener('click', () => show(current + 1));
    closeBtn.addEventListener('click', () => close());

    // Backdrop click — only when the click hits the dialog element directly
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) close();
    });

    dialog.addEventListener('close', cleanup);

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        show(current - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        show(current + 1);
      }
    });

    // Touch swipe support for mobile
    let touchStartX = 0;
    let touchStartY = 0;
    dialog.addEventListener(
      'touchstart',
      (e) => {
        touchStartX = e.changedTouches[0].screenX;
        touchStartY = e.changedTouches[0].screenY;
      },
      { passive: true }
    );
    dialog.addEventListener(
      'touchend',
      (e) => {
        const dx = e.changedTouches[0].screenX - touchStartX;
        const dy = e.changedTouches[0].screenY - touchStartY;
        if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy)) {
          if (dx < 0) show(current + 1);
          else show(current - 1);
        }
      },
      { passive: true }
    );
  })();
</script>
