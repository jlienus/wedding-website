---
import Base from '../layouts/Base.astro';
import RsvpEmbed from '../components/RsvpEmbed.astro';
import { t, type Locale } from '../lib/i18n';

const locale: Locale = 'en';
---

<Base title={t(locale, 'rsvp.heading') + ' · John & Diana'} description={t(locale, 'rsvp.intro')} lang={locale}>
  <main>
    <section class="section container container--narrow reveal" style="text-align:center;">
      <p class="eyebrow">{t(locale, 'nav.rsvp')}</p>
      <h1>{t(locale, 'rsvp.heading')}</h1>
      <p>{t(locale, 'rsvp.intro')}</p>
    </section>
    <aside class="container container--narrow reveal" style="text-align:center; padding: var(--space-3); border-left: 4px solid var(--color-gold); background: rgba(201,169,97,0.08); margin: var(--space-3) auto;">{t(locale, 'rsvp.deadlineCallout')}</aside>
    <section class="section"><RsvpEmbed locale={locale} /></section>
    <p class="container container--narrow reveal" style="text-align:center;">{t(locale, 'rsvp.contactIssues')}</p>
  </main>
</Base>

