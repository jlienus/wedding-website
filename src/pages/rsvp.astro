---
import Base from '../layouts/Base.astro';
import RsvpForm from '../components/RsvpForm.astro';
import PageHero from '../components/PageHero.astro';
import { t, type Locale } from '../lib/i18n';

const locale: Locale = 'en';
---

<Base title={t(locale, 'rsvp.heading') + ' · John & Diana'} description={t(locale, 'rsvp.intro')} lang={locale}>
  <main>
    <PageHero photoSlot="rsvp-hero.jpg" imageAlt={t(locale, 'rsvp.heroAlt')}>
      <p class="eyebrow">{t(locale, 'nav.rsvp')}</p>
      <h1>{t(locale, 'rsvp.heading')}</h1>
      <p>{t(locale, 'rsvp.intro')}</p>
    </PageHero>
    <aside class="container container--narrow reveal rsvp-deadline-callout">
      <p>{t(locale, 'rsvp.deadlineCallout')}</p>
      <p class="rsvp-deadline-callout__note">{t(locale, 'rsvp.editAnytimeNote')}</p>
    </aside>
    <section class="section"><RsvpForm locale={locale} /></section>
    <p class="container container--narrow reveal" style="text-align:center;">{t(locale, 'rsvp.contactIssues')}</p>
  </main>
</Base>


