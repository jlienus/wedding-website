---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import HeroCta from '../../components/HeroCta.astro';
import CountdownTimer from '../../components/CountdownTimer.astro';
import WeddingDetailsCard from '../../components/WeddingDetailsCard.astro';
import HeritageSection from '../../components/HeritageSection.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import { t, type Locale } from '../../lib/i18n';

const locale: Locale = 'es';
---

<Base title="John & Diana · March 13, 2027" description={t(locale, 'home.welcomeBlurb')} lang={locale}>
  <Hero locale={locale} />
  <HeroCta locale={locale} />
  <main>
    <section class="section container container--narrow reveal">
      <CountdownTimer locale={locale} />
    </section>
    <SectionDivider />
    <section class="section container reveal">
      <p class="eyebrow">{t(locale, 'home.detailsEyebrow')}</p>
      <h1 class="reveal">{t(locale, 'home.welcomeTitle')}</h1>
      <p class="reveal">{t(locale, 'home.welcomeBlurb')}</p>
    </section>
    <section class="section container reveal">
      <h2 class="reveal" style="text-align:center;">{t(locale, 'home.keyDetailsTitle')}</h2>
      <p class="reveal" style="text-align:center;">{t(locale, 'home.keyDetailsIntro')}</p>
      <WeddingDetailsCard locale={locale} />
    </section>
    <SectionDivider ornament="⚭" />
    <HeritageSection locale={locale} />
    <SectionDivider />
    <section class="section container reveal" style="text-align:center;">
      <h2>{t(locale, 'home.travelTitle')}</h2>
      <div class="cta-row">
        <a class="btn btn--gold" href="/es/itinerario">{t(locale, 'nav.itinerary')}</a>
        <a class="btn" href="/es/viajes">{t(locale, 'nav.travel')}</a>
      </div>
    </section>
  </main>
</Base>

<style>
  .cta-row { display: flex; flex-wrap: wrap; justify-content: center; gap: var(--space-2); }
</style>

