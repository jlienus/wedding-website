---
import Base from '../../layouts/Base.astro';
import PhotoGallery from '../../components/PhotoGallery.astro';
import HeritageSection from '../../components/HeritageSection.astro';
import OurStoryTimeline from '../../components/OurStoryTimeline.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import PageAnchors from '../../components/PageAnchors.astro';
import { t, type Locale } from '../../lib/i18n';

const locale: Locale = 'es';
const anchorLinks = [
  { href: '#how-we-met', label: t(locale, 'ourStory.anchorHowWeMet') },
  { href: '#journey', label: t(locale, 'ourStory.anchorJourney') },
  { href: '#moments', label: t(locale, 'ourStory.anchorMoments') },
  { href: '#heritage', label: t(locale, 'ourStory.anchorHeritage') },
];
const storyParagraphs = ['howWeMetP1', 'howWeMetP2', 'howWeMetP3', 'howWeMetP4', 'howWeMetP5'];
---

<Base title={t(locale, 'nav.ourStory') + ' · John & Diana'} description={t(locale, 'ourStory.howWeMetDescription')} lang={locale}>
  <main>
    <section class="section container container--narrow reveal" style="text-align:center;">
      <p class="eyebrow">{t(locale, 'heritage.header')}</p>
      <h1>{t(locale, 'ourStory.heading')}</h1>
      <PageAnchors locale={locale} links={anchorLinks} />
    </section>
    <section id="how-we-met" class="section container container--narrow reveal anchor-target">
      <h2 style="text-align:center;">{t(locale, 'ourStory.howWeMetHeading')}</h2>
      {storyParagraphs.map((key) => (
        <p>{t(locale, `ourStory.${key}`)}</p>
      ))}
      <p class="story-closing" style="font-style: italic; text-align: center; color: var(--color-text-muted); margin-top: var(--space-4);">{t(locale, 'ourStory.howWeMetClosing')}</p>
    </section>
    <SectionDivider />
    <section id="journey" class="section container anchor-target">
      <OurStoryTimeline locale={locale} />
    </section>
    <SectionDivider />
    <section id="moments" class="section container reveal anchor-target">
      <h2 style="text-align:center;">{t(locale, 'ourStory.galleryHeading')}</h2>
      <PhotoGallery slots={['couple-gallery-1.jpg','couple-gallery-2.jpg','couple-gallery-3.jpg','couple-gallery-4.jpg','couple-gallery-5.jpg','couple-gallery-6.jpg']} altPrefix={locale === 'es' ? 'Foto de John y Diana' : 'John and Diana photo'} />
    </section>
    <SectionDivider ornament="⚭" />
    <div id="heritage" class="anchor-target">
      <HeritageSection locale={locale} />
    </div>
  </main>
</Base>

