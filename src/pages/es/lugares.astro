---
import Base from '../../layouts/Base.astro';
import VenueCard from '../../components/VenueCard.astro';
import PhotoPair from '../../components/PhotoPair.astro';
import MenuSection from '../../components/MenuSection.astro';
import CocktailMenu from '../../components/CocktailMenu.astro';
import SectionDivider from '../../components/SectionDivider.astro';
import PageAnchors from '../../components/PageAnchors.astro';
import PageHero from '../../components/PageHero.astro';
import { t, type Locale } from '../../lib/i18n';
import venues from '../../data/venues.json';
import config from '../../data/wedding.config.json';

const locale: Locale = 'es';
const hashtag = config.social.hashtag;

const ceremonyPhotos = [
  {
    src: '/images/basilica-aisle.jpg',
    altEn: t('en', 'venues.aisleAlt'),
    altEs: t(locale, 'venues.aisleAlt'),
    captionEn: t('en', 'venues.aisleCaption'),
    captionEs: t(locale, 'venues.aisleCaption'),
  },
  {
    src: '/images/basilica-nave.jpg',
    altEn: t('en', 'venues.naveAlt'),
    altEs: t(locale, 'venues.naveAlt'),
    captionEn: t('en', 'venues.naveCaption'),
    captionEs: t(locale, 'venues.naveCaption'),
  },
  {
    src: '/images/basilica-rose-window.jpg',
    altEn: t('en', 'venues.roseWindowAlt'),
    altEs: t(locale, 'venues.roseWindowAlt'),
    captionEn: t('en', 'venues.roseWindowCaption'),
    captionEs: t(locale, 'venues.roseWindowCaption'),
  },
];

const receptionPhotos = [
  {
    src: '/images/reception-ballroom.jpg',
    altEn: t('en', 'venues.ballroomAlt'),
    altEs: t(locale, 'venues.ballroomAlt'),
    captionEn: t('en', 'venues.ballroomCaption'),
    captionEs: t(locale, 'venues.ballroomCaption'),
  },
  {
    src: '/images/reception-table.jpg',
    altEn: t('en', 'venues.tableAlt'),
    altEs: t(locale, 'venues.tableAlt'),
    captionEn: t('en', 'venues.tableCaption'),
    captionEs: t(locale, 'venues.tableCaption'),
  },
];

const anchorLinks = [
  { href: '#ceremony', label: t(locale, 'venues.ceremonyHeading') },
  { href: '#reception', label: t(locale, 'venues.receptionHeading') },
  { href: '#dining', label: t(locale, 'venues.anchorDining') },
];
---

<Base title={t(locale, 'venues.heading') + ' · John & Diana'} description={t(locale, 'venues.walkingText')} lang={locale}>
  <main>
    <PageHero photoSlot="basilica-rose-window.jpg" imageAlt={t(locale, 'venues.roseWindowAlt')}>
      <p class="eyebrow">{t(locale, 'home.detailsEyebrow')}</p>
      <h1>{t(locale, 'venues.heading')}</h1>
      <p>{t(locale, 'venues.walkingText')}</p>
      <PageAnchors locale={locale} links={anchorLinks} ariaLabel={t(locale, 'venues.onThisPage')} />
    </PageHero>
    <section id="ceremony" class="section container reveal anchor-target">
      <h2>{t(locale, 'venues.ceremonyHeading')}</h2>
      <VenueCard venue={venues.ceremony} locale={locale} />
      <PhotoPair photos={ceremonyPhotos} locale={locale} />
    </section>
    <SectionDivider />
    <section id="reception" class="section container reveal anchor-target">
      <h2>{t(locale, 'venues.receptionHeading')}</h2>
      <VenueCard venue={venues.reception} locale={locale} />
      <PhotoPair photos={receptionPhotos} locale={locale} />
      <div id="dining" class="anchor-target">
        <CocktailMenu locale={locale} />
        <MenuSection locale={locale} />
      </div>
    </section>
    <section class="section container container--narrow reveal">
      <aside class="hashtag-callout">
        <p class="hashtag-label">📸 {t(locale, 'venues.hashtagCalloutHeading')}</p>
        <p class="hashtag-tag">{hashtag}</p>
        <p class="hashtag-body">{t(locale, 'venues.hashtagCalloutBody')}</p>
      </aside>
    </section>
    <p class="container container--narrow reveal" style="text-align:center; color: var(--color-text-muted);"><em>{t(locale, 'venues.shuttleDisclaimer')}</em></p>
  </main>
</Base>

<style>
  .hashtag-callout {
    margin: 0 auto;
    padding: var(--space-4) var(--space-3);
    text-align: center;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--gradient-surface);
    box-shadow: var(--shadow-sm);
  }
  .hashtag-label { font-size: var(--fs-tiny); letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-gold-deep); margin: 0; }
  .hashtag-tag { font-family: var(--font-display); font-size: clamp(1.5rem, 3.5vw, 2.25rem); color: var(--color-gold-deep); margin: var(--space-2) 0; letter-spacing: 0.02em; }
  .hashtag-body { color: var(--color-text-muted); margin: 0; font-style: italic; }
</style>


