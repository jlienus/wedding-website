    .admin-modal-body input[type="text"], .admin-modal-body select, .admin-modal-body textarea {
      width: 100%; box-sizing: border-box;
      padding: 0.45rem 0.6rem;
      border: 1px solid var(--color-rule, #d6cdb6);
      border-radius: var(--radius-sm, 4px);
      font: inherit;
    }
    .admin-payload-json { font-family: ui-monospace, Menlo, Consolas, monospace; font-size: 0.85rem; white-space: pre; min-height: 14rem; }
  </style>
