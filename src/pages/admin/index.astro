    .admin-event-badge {
      display: inline-block;
      padding: 0.1rem 0.5rem;
      border-radius: 999px;
      font-size: 0.7rem;
      font-weight: 600;
      font-family: ui-monospace, Menlo, Consolas, monospace;
      white-space: nowrap;
      letter-spacing: 0.02em;
    }
    .admin-event-badge--rsvp   { background: rgba(80, 160, 80, 0.14); color: #2a6a2c; }
    .admin-event-badge--admin  { background: rgba(201, 169, 97, 0.20); color: #8a6a2c; }
    .admin-event-badge--deploy { background: rgba(60, 120, 200, 0.14); color: #2a4a8a; }
    .admin-event-badge--backup { background: rgba(120, 80, 160, 0.14); color: #5a2a8a; }
    .admin-event-badge--cron   { background: rgba(0, 0, 0, 0.06);     color: #4a4a4a; }
    .admin-event-badge--sms    { background: rgba(200, 60, 60, 0.12); color: #8a2c2c; }
    .admin-event-badge--other  { background: rgba(0, 0, 0, 0.06);     color: #4a4a4a; }
    .admin-event-actor {
      color: var(--color-text-muted, #6b6b6b);
      font-size: 0.8rem;
      white-space: nowrap;
    }
    .admin-event-summary { color: #333; }
    @media (max-width: 40rem) {
      .admin-event {
        grid-template-columns: auto 1fr;
        row-gap: 0.2rem;
      }
      .admin-event-time { grid-column: 1; grid-row: 1; }
      .admin-event-badge { grid-column: 2; grid-row: 1; justify-self: start; }
      .admin-event-actor { grid-column: 1 / -1; grid-row: 2; }
      .admin-event-summary { grid-column: 1 / -1; grid-row: 3; }
    }

    /* Modal */
    .admin-modal { position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; padding: var(--space-3); }
    .admin-modal[hidden] { display: none !important; }
    .admin-modal-backdrop { position: absolute; inset: 0; background: rgba(0,0,0,0.5); }
    .admin-modal-panel {
      position: relative;
      background: #fff;
      border-radius: var(--radius-lg, 12px);
      max-width: 40rem;
      width: 100%;
      max-height: calc(100vh - 4rem);
      overflow: auto;
      box-shadow: 0 10px 30px rgba(0,0,0,0.25);
    }
    .admin-modal-header { display:flex; justify-content:space-between; align-items:center; padding: var(--space-3); border-bottom: 1px solid var(--color-rule, #eee); }
    .admin-modal-header h3 { margin: 0; color: var(--color-gold-deep, #8a6a2c); }
    .admin-modal-close { background:none; border:0; font-size: 1.6rem; line-height: 1; cursor: pointer; padding: 0 0.5rem; color: #888; }
    .admin-modal-close:hover { color: #000; }
    .admin-modal-body { padding: var(--space-3); display:flex; flex-direction: column; gap: var(--space-2); }
    .admin-modal-actions { display:flex; justify-content: flex-end; gap: 0.5rem; margin-top: var(--space-2); }
    .admin-form-row { display: block; }
