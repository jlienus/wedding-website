---
import Base from '../../layouts/Base.astro';
import { t, type Locale } from '../../lib/i18n';
import {
  entradaOptions,
  sorbetOptions,
  mealOptions,
  postreOptions,
  guestTypeOptions
} from '../../lib/rsvp-options';
const locale: Locale = 'en';
---

<Base title="RSVP Admin · John & Diana" description="RSVP administration dashboard" lang={locale}>

  <!--
    Sign-in chooser. Shown when the caller has no admin auth at all
    (no GitHub SWA principal AND no admin_session cookie). Hidden by
    default; revealed by the script after /api/mgmt/admin-whoami says
    authed:false. Two parallel paths: built-in GitHub (the existing
    primary admin path) and email magic-link (so Diana can sign in
    without needing a GitHub account).
  -->
  <main id="admin-gate" class="admin admin-gate" hidden>
    <section class="container container--narrow">
      <header class="admin-gate-header">
        <h1>Admin sign-in</h1>
      </header>

      <div id="admin-gate-status" class="admin-status admin-gate-status" role="status" aria-live="polite" hidden></div>

      <article class="admin-card admin-gate-card">
        <form id="admin-email-form" class="admin-gate-form" novalidate>
          <label class="admin-form-row">
            <span class="admin-label">Email</span>
            <input
              id="admin-email-input"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              maxlength="254"
              required
              placeholder="you@example.com"
            />
          </label>
          <button id="admin-email-submit" type="submit" class="btn btn--gold">Email me a sign-in link</button>
          <div id="admin-email-status" class="admin-status admin-gate-email-status" role="status" aria-live="polite"></div>
        </form>

        <div class="admin-gate-divider" aria-hidden="true"><span>or</span></div>

        <a id="admin-github-signin" class="btn btn--ghost" href="/.auth/login/github?post_login_redirect_uri=/admin">Sign in with GitHub</a>
      </article>
    </section>
  </main>

  <main id="admin-app" class="admin" hidden>
    <section class="container">
      <header class="admin-header">
        <h1>RSVP Admin</h1>
        <div class="admin-user">
          <span id="admin-user-label">…</span>
          <a id="admin-logout-link" href="/.auth/logout?post_logout_redirect_uri=/" class="rsvp-link">Log out</a>
        </div>
      </header>

      <div id="admin-error" class="admin-error" role="alert" hidden></div>

      <section class="admin-card admin-controls">
        <h2>Reminders</h2>
        <div class="admin-row">
          <label class="admin-toggle">
            <input type="checkbox" id="reminders-enabled" />
            <span>Monthly reminder texts enabled</span>
          </label>
          <span id="reminders-stop" class="admin-muted"></span>
        </div>
        <div class="admin-row admin-row--actions">
          <button id="btn-send-test" class="btn btn--ghost btn--small">Send test SMS</button>
          <span class="admin-muted">Sends a test message to a phone you specify. Useful to verify ACS provisioning.</span>
        </div>
        <div id="settings-status" class="admin-status"></div>
      </section>

      <section class="admin-card">
        <div class="admin-card-header">
          <h2>Overall</h2>
          <div class="admin-card-actions">
            <button id="btn-export-csv" class="btn btn--ghost btn--small" disabled title="Aggregate counts only — no names, phones, or free-text answers.">Export summary CSV</button>
          </div>
        </div>
        <div id="admin-overall" class="admin-stats">
          <span class="admin-loader" role="status" aria-live="polite">
            <span class="admin-loader__ring" aria-hidden="true"></span>
            <span class="admin-loader__text">Loading summary…</span>
          </span>
        </div>
      </section>

      <section class="admin-card">
        <div class="admin-card-header">
          <h2>Invitations</h2>
          <div class="admin-card-actions">
            <button id="btn-create-invite" class="btn btn--gold btn--small">+ New invitation</button>
            <button id="btn-refresh" class="btn btn--ghost btn--small">Refresh</button>
          </div>
        </div>
        <div class="admin-table-wrap">
          <table id="admin-table" class="admin-table">
            <thead>
              <tr>
                <th>Primary invitee</th>
                <th>Responded</th>
                <th>Headcount</th>
                <th>Phone · Locale</th>
                <th>Last reminder</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="admin-tbody">
              <tr><td colspan="6" class="admin-loading">
                <span class="admin-loader" role="status" aria-live="polite">
                  <span class="admin-loader__ring" aria-hidden="true"></span>
                  <span class="admin-loader__text">Loading invitations…</span>
                </span>
              </td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="admin-card">
        <div class="admin-card-header">
          <h2>Bulk import invitations</h2>
        </div>
        <p class="admin-muted bulk-help">
          Upload a CSV with columns <strong>First name</strong>, <strong>Last name</strong>, <strong>Phone</strong>
          (optional <strong>Locale</strong>: <code>en</code> or <code>es</code>).
          Names that match an existing invitation get their phone/locale updated —
          <strong>existing RSVP responses are preserved</strong>. Unmatched names create new invitations.
          Name lookup is case-insensitive; rows with duplicate first+last on the existing list are skipped (resolve manually).
        </p>
        <div class="admin-row bulk-controls">
          <input type="file" id="bulk-file" accept=".csv,text/csv,text/plain" />
          <button type="button" id="bulk-preview-btn" class="btn btn--ghost btn--small" disabled>Preview against server</button>
          <button type="button" id="bulk-apply-btn" class="btn btn--gold btn--small" disabled>Apply changes</button>
          <button type="button" id="bulk-clear-btn" class="btn btn--ghost btn--small" hidden>Clear</button>
        </div>
        <div id="bulk-status" class="admin-status"></div>
        <div id="bulk-preview-wrap" hidden>
          <div id="bulk-summary" class="bulk-summary"></div>
          <div class="admin-table-wrap">
            <table class="admin-table bulk-preview-table">
              <thead>
                <tr>
                  <th>#</th>
                  <th>First name</th>
                  <th>Last name</th>
                  <th>Phone</th>
                  <th>Locale</th>
                  <th>Action</th>
                </tr>
              </thead>
              <tbody id="bulk-preview-tbody"></tbody>
            </table>
          </div>
        </div>
      </section>

      <section class="admin-card">
        <div class="admin-card-header">
          <h2>Recent activity</h2>
          <span id="events-count" class="admin-muted"></span>
        </div>
        <div class="admin-events-filters" role="group" aria-label="Filter events">
          <input
            id="events-search"
            type="search"
            class="admin-events-search"
            placeholder="Search type, actor, or summary…"
            aria-label="Search events"
            autocomplete="off"
            spellcheck="false"
          />
          <div class="admin-events-cats" role="group" aria-label="Filter by category">
            <label class="admin-cat-toggle admin-cat-toggle--rsvp">
              <input type="checkbox" data-cat="rsvp" checked /><span>RSVP</span>
            </label>
            <label class="admin-cat-toggle admin-cat-toggle--admin">
              <input type="checkbox" data-cat="admin" checked /><span>Admin</span>
            </label>
            <label class="admin-cat-toggle admin-cat-toggle--deploy">
              <input type="checkbox" data-cat="deploy" checked /><span>Deploy</span>
            </label>
            <label class="admin-cat-toggle admin-cat-toggle--backup">
              <input type="checkbox" data-cat="backup" checked /><span>Backup</span>
            </label>
            <label class="admin-cat-toggle admin-cat-toggle--cron">
              <input type="checkbox" data-cat="cron" checked /><span>Cron</span>
            </label>
            <label class="admin-cat-toggle admin-cat-toggle--sms">
              <input type="checkbox" data-cat="sms" checked /><span>SMS</span>
            </label>
            <label class="admin-cat-toggle admin-cat-toggle--other">
              <input type="checkbox" data-cat="other" checked /><span>Other</span>
            </label>
          </div>
          <button type="button" id="events-reset" class="btn btn--ghost btn--small">Reset filters</button>
        </div>
        <div class="admin-events-wrap">
          <ul id="admin-events" class="admin-events">
            <li class="admin-events-empty">
              <span class="admin-loader" role="status" aria-live="polite">
                <span class="admin-loader__ring" aria-hidden="true"></span>
                <span class="admin-loader__text">Loading recent activity…</span>
              </span>
            </li>
          </ul>
        </div>
      </section>

    </section>
  </main>

  <!-- Edit / create modal -->
  <div id="admin-modal" class="admin-modal" hidden>
    <div class="admin-modal-backdrop" data-modal-close></div>
    <div class="admin-modal-panel" role="dialog" aria-modal="true" aria-labelledby="admin-modal-title">
      <header class="admin-modal-header">
        <h3 id="admin-modal-title">Invitation</h3>
        <button type="button" class="admin-modal-close" data-modal-close aria-label="Close">×</button>
      </header>
      <form id="admin-modal-form" class="admin-modal-body" novalidate>
        <div class="admin-form-row admin-form-row--two">
          <label>
            <span class="admin-label">First name</span>
            <input type="text" name="primaryFirstName" maxlength="80" required />
          </label>
          <label>
            <span class="admin-label">Last name</span>
            <input type="text" name="primaryLastName" maxlength="80" required />
          </label>
        </div>
        <div class="admin-form-row admin-form-row--two">
          <label>
            <span class="admin-label">Phone (E.164 or 10-digit US)</span>
            <input type="text" name="phone" maxlength="32" />
          </label>
          <label>
            <span class="admin-label">Locale</span>
            <select name="locale">
              <option value="en">English (en)</option>
              <option value="es">Español (es)</option>
            </select>
          </label>
        </div>
        <label class="admin-form-row">
          <span class="admin-label">Admin notes (internal)</span>
          <textarea name="adminNotes" maxlength="500" rows="2"></textarea>
        </label>
        <fieldset class="admin-form-row admin-form-row--checks">
          <label class="admin-inline"><input type="checkbox" name="optedOutOfSms" /> <span>Opted out of SMS</span></label>
          <label class="admin-inline"><input type="checkbox" name="clearHardFail" /> <span>Clear SMS hard-fail flag</span></label>
        </fieldset>
        <section class="admin-form-row" id="admin-payload-row" aria-label="RSVP responses" hidden>
          <span class="admin-label">RSVP responses</span>
          <small class="admin-muted admin-rsvp-help">
            Edits here update what each attendee answered.
            "Not attending" or "Not yet answered" automatically clears that person's meal picks on save.
            Removing a guest discards their answers permanently.
          </small>

          <fieldset class="admin-attendee admin-attendee--primary">
            <legend class="admin-attendee-legend">Primary invitee <span class="admin-muted" data-primary-name-display></span></legend>
            <div class="admin-attendee-grid">
              <label>
                <span class="admin-label">Attending</span>
                <select data-field="attending" data-attendee="primary">
                  <option value="">— Not yet answered</option>
                  <option value="yes">Yes</option>
                  <option value="no">No</option>
                </select>
              </label>
            </div>
            <div class="admin-meal-block" data-attending-block hidden>
              <div class="admin-meal-grid">
                <label>
                  <span class="admin-label">{t(locale, 'rsvp.entradaLabel')}</span>
                  <select data-field="entradaChoice" data-attendee="primary">
                    {entradaOptions.map((opt) => (
                      <option value={opt.value}>{t(locale, opt.labelKey)}</option>
                    ))}
                  </select>
                </label>
                <label>
                  <span class="admin-label">{t(locale, 'rsvp.sorbetLabel')}</span>
                  <select data-field="sorbetChoice" data-attendee="primary">
                    {sorbetOptions.map((opt) => (
                      <option value={opt.value}>{t(locale, opt.labelKey)}</option>
                    ))}
                  </select>
                </label>
                <label>
                  <span class="admin-label">{t(locale, 'rsvp.mealLabel')}</span>
                  <select data-field="mealChoice" data-attendee="primary">
                    {mealOptions.map((opt) => (
                      <option value={opt.value}>{t(locale, opt.labelKey)}</option>
                    ))}
                  </select>
                </label>
                <label>
                  <span class="admin-label">{t(locale, 'rsvp.postreLabel')}</span>
                  <select data-field="postreChoice" data-attendee="primary">
                    {postreOptions.map((opt) => (
                      <option value={opt.value}>{t(locale, opt.labelKey)}</option>
                    ))}
                  </select>
                </label>
                <label class="admin-meal-grid-full">
                  <span class="admin-label">Allergies / dietary notes</span>
                  <input type="text" data-field="dietary" data-attendee="primary" maxlength="500" />
                </label>
                <label class="admin-meal-grid-full">
                  <span class="admin-label">Song request</span>
                  <input type="text" data-field="songRequest" data-attendee="primary" maxlength="500" />
                </label>
              </div>
            </div>
            <label class="admin-form-row admin-attendee-notes">
              <span class="admin-label">Notes from this guest</span>
              <textarea data-field="notes" data-attendee="primary" maxlength="800" rows="2"></textarea>
            </label>
          </fieldset>

          <div class="admin-guests-section">
            <header class="admin-guests-header">
              <h4 class="admin-guests-heading">Additional guests <span class="admin-muted" data-guest-count></span></h4>
              <button type="button" id="admin-add-guest" class="btn btn--ghost btn--small">+ Add guest</button>
            </header>
            <div id="admin-guests-list" class="admin-guests-list"></div>
            <p id="admin-guests-empty" class="admin-muted admin-guests-empty" hidden>No additional guests on this invitation.</p>
            <p id="admin-guests-max" class="admin-muted admin-guests-empty" hidden>Maximum of 20 guests reached.</p>
          </div>
        </section>
        <div id="admin-modal-error" class="admin-error" role="alert" hidden></div>
        <div class="admin-modal-actions">
          <button type="button" class="btn btn--ghost" data-modal-close>Cancel</button>
          <button type="submit" class="btn btn--gold" id="admin-modal-save">Save</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Guest card template — cloned by admin-add-guest, populated by openModal -->
  <template id="admin-guest-card-template">
    <fieldset class="admin-attendee admin-attendee--guest" data-guest-card>
      <input type="hidden" data-guest-id />
      <header class="admin-attendee-header">
        <legend class="admin-attendee-legend">Guest <span class="admin-muted" data-guest-name-display></span></legend>
        <button type="button" class="admin-attendee-remove rsvp-link" data-guest-remove>Remove guest</button>
      </header>
      <div class="admin-attendee-grid">
        <label>
          <span class="admin-label">Name</span>
          <input type="text" data-field="name" maxlength="100" />
        </label>
        <label>
          <span class="admin-label">Adult or child</span>
          <select data-field="guestType">
            {guestTypeOptions.filter((o) => o.value !== '').map((opt) => (
              <option value={opt.value}>{t(locale, opt.labelKey)}</option>
            ))}
          </select>
        </label>
        <label>
          <span class="admin-label">Attending</span>
          <select data-field="attending">
            <option value="">— Not yet answered</option>
            <option value="yes">Yes</option>
            <option value="no">No</option>
          </select>
        </label>
      </div>
      <div class="admin-meal-block" data-attending-block hidden>
        <div class="admin-meal-grid">
          <label>
            <span class="admin-label">{t(locale, 'rsvp.entradaLabel')}</span>
            <select data-field="entradaChoice">
              {entradaOptions.map((opt) => (
                <option value={opt.value}>{t(locale, opt.labelKey)}</option>
              ))}
            </select>
          </label>
          <label>
            <span class="admin-label">{t(locale, 'rsvp.sorbetLabel')}</span>
            <select data-field="sorbetChoice">
              {sorbetOptions.map((opt) => (
                <option value={opt.value}>{t(locale, opt.labelKey)}</option>
              ))}
            </select>
          </label>
          <label>
            <span class="admin-label">{t(locale, 'rsvp.mealLabel')}</span>
            <select data-field="mealChoice">
              {mealOptions.map((opt) => (
                <option value={opt.value}>{t(locale, opt.labelKey)}</option>
              ))}
            </select>
          </label>
          <label>
            <span class="admin-label">{t(locale, 'rsvp.postreLabel')}</span>
            <select data-field="postreChoice">
              {postreOptions.map((opt) => (
                <option value={opt.value}>{t(locale, opt.labelKey)}</option>
              ))}
            </select>
          </label>
          <label class="admin-meal-grid-full">
            <span class="admin-label">Allergies / dietary notes</span>
            <input type="text" data-field="dietary" maxlength="500" />
          </label>
          <label class="admin-meal-grid-full">
            <span class="admin-label">Song request</span>
            <input type="text" data-field="songRequest" maxlength="500" />
          </label>
        </div>
      </div>
    </fieldset>
  </template>

  <!-- Diff preview overlay — shown on Save when payload changed -->
  <div id="admin-diff-modal" class="admin-modal admin-diff-modal" hidden>
    <div class="admin-modal-backdrop" data-diff-close></div>
    <div class="admin-modal-panel" role="dialog" aria-modal="true" aria-labelledby="admin-diff-title">
      <header class="admin-modal-header">
        <h3 id="admin-diff-title">Review RSVP changes</h3>
        <button type="button" class="admin-modal-close" data-diff-close aria-label="Close">×</button>
      </header>
      <div class="admin-modal-body">
        <p class="admin-muted admin-diff-intro">Here's what will change when you save. Removed answers are permanent.</p>
        <ul id="admin-diff-list" class="admin-diff-list"></ul>
        <div class="admin-modal-actions">
          <button type="button" class="btn btn--ghost" data-diff-close>Back to edit</button>
          <button type="button" class="btn btn--gold" id="admin-diff-confirm">Confirm &amp; save</button>
        </div>
      </div>
    </div>
  </div>

  <script>
    (() => {
      const errorEl = document.getElementById('admin-error') as HTMLDivElement | null;
      const userLabel = document.getElementById('admin-user-label') as HTMLSpanElement | null;
      const remindersChk = document.getElementById('reminders-enabled') as HTMLInputElement | null;
      const settingsStatus = document.getElementById('settings-status') as HTMLDivElement | null;
      const overallEl = document.getElementById('admin-overall') as HTMLDivElement | null;
      const tbody = document.getElementById('admin-tbody') as HTMLTableSectionElement | null;
      const remindersStopEl = document.getElementById('reminders-stop') as HTMLSpanElement | null;
      const modalEl = document.getElementById('admin-modal') as HTMLDivElement | null;
      const modalTitleEl = document.getElementById('admin-modal-title') as HTMLHeadingElement | null;
      const modalForm = document.getElementById('admin-modal-form') as HTMLFormElement | null;
      const modalErrorEl = document.getElementById('admin-modal-error') as HTMLDivElement | null;
      const modalSaveBtn = document.getElementById('admin-modal-save') as HTMLButtonElement | null;
      const payloadRow = document.getElementById('admin-payload-row') as HTMLElement | null;
      const exportBtn = document.getElementById('btn-export-csv') as HTMLButtonElement | null;

      // ---- RSVP structured-edit helpers ----
      //
      // Replaces the legacy "raw JSON payload textarea" workflow. The admin
      // edits each attendee field through a structured form; we build the
      // payload object from the DOM at submit time. Keeps guest IDs stable
      // via hidden inputs, shows a diff preview before persisting, and
      // gracefully renders any unknown legacy choice values that may exist
      // in older saved payloads.

      const SCHEMA_VERSION = 1;
      const ADMIN_MAX_GUESTS = 20;

      const MEAL_FIELDS_ADMIN = ['entradaChoice', 'sorbetChoice', 'mealChoice', 'postreChoice'] as const;
      type MealField = typeof MEAL_FIELDS_ADMIN[number];

      // Human labels for diff preview — match the public RSVP form labels.
      const FIELD_HUMAN_LABEL: Record<string, string> = {
        attending: 'attending',
        entradaChoice: 'appetizer',
        sorbetChoice: 'sorbet',
        mealChoice: 'main',
        postreChoice: 'dessert',
        dietary: 'allergies/dietary',
        songRequest: 'song request',
        notes: 'notes',
        name: 'name',
        guestType: 'adult/child'
      };

      const CHOICE_DISPLAY: Record<string, Record<string, string>> = {
        entradaChoice: { salpicon: 'seafood salpicón', hojaldre: 'beef puff pastry', causa: 'causa limeña' },
        sorbetChoice: { maracuya: 'passion fruit', mandarina: 'mandarin & mint' },
        mealChoice: { chicken: 'chicken cordon bleu', beef: 'beef tenderloin' },
        postreChoice: { chocolate: 'chocolate dome', cheesecake: 'red-berry cheesecake', tiramisu: 'tiramisu' }
      };

      function displayChoice(field: string, value: string): string {
        if (!value) return '—';
        return (CHOICE_DISPLAY[field] && CHOICE_DISPLAY[field][value]) || value;
      }
      function displayAttending(v: boolean | null): string {
        if (v === true) return 'Yes';
        if (v === false) return 'No';
        return '—';
      }
      function attendingFromSelect(v: string): boolean | null {
        if (v === 'yes') return true;
        if (v === 'no') return false;
        return null;
      }
      function attendingToSelect(v: boolean | null): string {
        if (v === true) return 'yes';
        if (v === false) return 'no';
        return '';
      }

      function randomGuestId(): string {
        // Matches the server's `g_<rand>` shape so the round-trip is stable.
        let s = '';
        const alpha = 'abcdefghijklmnopqrstuvwxyz0123456789';
        for (let i = 0; i < 8; i++) s += alpha[Math.floor(Math.random() * alpha.length)];
        return 'g_' + s;
      }

      function rsvpSection(): HTMLElement | null {
        return payloadRow as unknown as HTMLElement | null;
      }
      function primaryAttendeeRoot(): HTMLElement | null {
        return rsvpSection()?.querySelector('.admin-attendee--primary') as HTMLElement | null;
      }
      function guestList(): HTMLDivElement | null {
        return document.getElementById('admin-guests-list') as HTMLDivElement | null;
      }
      function guestCards(): HTMLElement[] {
        const list = guestList();
        return list ? Array.from(list.querySelectorAll('[data-guest-card]')) as HTMLElement[] : [];
      }

      // Set a <select>'s value, gracefully handling unknown legacy values by
      // injecting a disabled "⚠ Unknown: x" option. Returns true if the value
      // was unknown (caller may want to surface a hint to the admin). Strips
      // any prior unknown-legacy option from this select first so successive
      // openModal calls don't accumulate placeholders.
      function setSelectValueSafely(select: HTMLSelectElement | null, value: string): boolean {
        if (!select) return false;
        Array.from(select.querySelectorAll('option[data-unknown-legacy]')).forEach((el) => el.remove());
        const v = value || '';
        const known = Array.from(select.options).some((o) => o.value === v);
        if (!known) {
          const opt = document.createElement('option');
          opt.value = v;
          opt.textContent = `⚠ Unknown legacy value: ${v}`;
          opt.disabled = true;
          opt.dataset.unknownLegacy = 'true';
          select.insertBefore(opt, select.firstChild || null);
        }
        select.value = v;
        return !known;
      }

      // Show/hide the meal block based on the attending select. Values are
      // preserved in the hidden DOM so flipping yes→no→yes restores picks.
      function toggleMealBlockFor(attendeeRoot: HTMLElement | null) {
        if (!attendeeRoot) return;
        const attending = attendeeRoot.querySelector('select[data-field="attending"]') as HTMLSelectElement | null;
        const block = attendeeRoot.querySelector('[data-attending-block]') as HTMLElement | null;
        if (!block) return;
        block.hidden = attending?.value !== 'yes';
      }

      function wireAttendingToggle(attendeeRoot: HTMLElement | null) {
        if (!attendeeRoot) return;
        const attending = attendeeRoot.querySelector('select[data-field="attending"]') as HTMLSelectElement | null;
        attending?.addEventListener('change', () => toggleMealBlockFor(attendeeRoot));
      }

      function setPrimaryNameDisplay(name: string) {
        const el = document.querySelector('[data-primary-name-display]') as HTMLElement | null;
        if (el) el.textContent = name ? `· ${name}` : '';
      }

      function updateGuestCountDisplay() {
        const cards = guestCards();
        const countEl = document.querySelector('[data-guest-count]') as HTMLElement | null;
        const emptyEl = document.getElementById('admin-guests-empty') as HTMLElement | null;
        const maxEl = document.getElementById('admin-guests-max') as HTMLElement | null;
        const addBtn = document.getElementById('admin-add-guest') as HTMLButtonElement | null;
        if (countEl) countEl.textContent = cards.length === 0 ? '' : `(${cards.length})`;
        if (emptyEl) emptyEl.hidden = cards.length !== 0;
        if (maxEl) maxEl.hidden = cards.length < ADMIN_MAX_GUESTS;
        if (addBtn) addBtn.disabled = cards.length >= ADMIN_MAX_GUESTS;
        // Refresh the live name display on each card so the legend matches input
        for (const card of cards) {
          const nameInput = card.querySelector('input[data-field="name"]') as HTMLInputElement | null;
          const display = card.querySelector('[data-guest-name-display]') as HTMLElement | null;
          if (display) display.textContent = nameInput?.value ? `· ${nameInput.value}` : '';
        }
      }

      function attendeeHasMeaningfulData(card: HTMLElement): boolean {
        const name = (card.querySelector('input[data-field="name"]') as HTMLInputElement | null)?.value.trim() || '';
        if (name) return true;
        const attending = (card.querySelector('select[data-field="attending"]') as HTMLSelectElement | null)?.value || '';
        if (attending) return true;
        for (const fld of MEAL_FIELDS_ADMIN) {
          const v = (card.querySelector(`select[data-field="${fld}"]`) as HTMLSelectElement | null)?.value || '';
          if (v) return true;
        }
        const dietary = (card.querySelector('input[data-field="dietary"]') as HTMLInputElement | null)?.value.trim() || '';
        if (dietary) return true;
        const song = (card.querySelector('input[data-field="songRequest"]') as HTMLInputElement | null)?.value.trim() || '';
        if (song) return true;
        return false;
      }

      function buildGuestCard(guestData: any | null, isExisting: boolean): HTMLElement | null {
        const tpl = document.getElementById('admin-guest-card-template') as HTMLTemplateElement | null;
        if (!tpl) return null;
        const node = tpl.content.firstElementChild?.cloneNode(true) as HTMLElement | null;
        if (!node) return null;

        if (isExisting) node.dataset.existingGuest = 'true';

        const idInput = node.querySelector('input[data-guest-id]') as HTMLInputElement | null;
        if (idInput) idInput.value = (isExisting && guestData?.id) ? guestData.id : randomGuestId();

        // For new (blank) guest cards, default the attending+type selects to
        // empty so the admin must make an explicit choice rather than silently
        // creating an attending=null/adult guest by accident.
        const nameInput = node.querySelector('input[data-field="name"]') as HTMLInputElement | null;
        if (nameInput) nameInput.value = guestData?.name || '';

        const typeSelect = node.querySelector('select[data-field="guestType"]') as HTMLSelectElement | null;
        if (typeSelect) {
          // guestTypeOptions in admin filter out the blank — keep the saved
          // boolean isKid back-compat: true → child, false → adult, undefined → adult default.
          if (guestData && typeof guestData.isKid === 'boolean') {
            typeSelect.value = guestData.isKid ? 'child' : 'adult';
          } else {
            typeSelect.value = 'adult';
          }
        }

        const attendingSelect = node.querySelector('select[data-field="attending"]') as HTMLSelectElement | null;
        if (attendingSelect) attendingSelect.value = attendingToSelect(guestData?.attending ?? null);

        for (const fld of MEAL_FIELDS_ADMIN) {
          setSelectValueSafely(node.querySelector(`select[data-field="${fld}"]`), guestData?.[fld] || '');
        }
        const dietaryInput = node.querySelector('input[data-field="dietary"]') as HTMLInputElement | null;
        if (dietaryInput) dietaryInput.value = guestData?.dietary || '';
        const songInput = node.querySelector('input[data-field="songRequest"]') as HTMLInputElement | null;
        if (songInput) songInput.value = guestData?.songRequest || '';

        wireAttendingToggle(node);
        toggleMealBlockFor(node);

        // Live update the guest legend name display
        nameInput?.addEventListener('input', updateGuestCountDisplay);

        const removeBtn = node.querySelector('[data-guest-remove]') as HTMLButtonElement | null;
        removeBtn?.addEventListener('click', () => {
          if (attendeeHasMeaningfulData(node)) {
            const guestLabel = nameInput?.value.trim() || 'this guest';
            if (!confirm(`Remove ${guestLabel}? Their answers will be discarded.`)) return;
          }
          node.remove();
          updateGuestCountDisplay();
        });

        return node;
      }

      function populateRsvpSection(payload: any) {
        const root = rsvpSection();
        if (!root) return;
        root.hidden = false;

        const p = (payload && typeof payload === 'object' && payload.primary) || {};
        const primaryRoot = primaryAttendeeRoot();
        if (primaryRoot) {
          const attendingSel = primaryRoot.querySelector('select[data-field="attending"]') as HTMLSelectElement | null;
          if (attendingSel) attendingSel.value = attendingToSelect(p.attending ?? null);
          for (const fld of MEAL_FIELDS_ADMIN) {
            setSelectValueSafely(primaryRoot.querySelector(`select[data-field="${fld}"]`), p[fld] || '');
          }
          const dietaryInput = primaryRoot.querySelector('input[data-field="dietary"]') as HTMLInputElement | null;
          if (dietaryInput) dietaryInput.value = p.dietary || '';
          const songInput = primaryRoot.querySelector('input[data-field="songRequest"]') as HTMLInputElement | null;
          if (songInput) songInput.value = p.songRequest || '';
          const notesTa = primaryRoot.querySelector('textarea[data-field="notes"]') as HTMLTextAreaElement | null;
          if (notesTa) notesTa.value = p.notes || '';
          toggleMealBlockFor(primaryRoot);
        }

        const list = guestList();
        if (list) {
          list.innerHTML = '';
          const guests = Array.isArray(payload?.additionalGuests) ? payload.additionalGuests : [];
          for (const g of guests) {
            const card = buildGuestCard(g, true);
            if (card) list.appendChild(card);
          }
        }
        updateGuestCountDisplay();
      }

      function clearRsvpSection() {
        const root = rsvpSection();
        if (!root) return;
        root.hidden = true;
        const list = guestList();
        if (list) list.innerHTML = '';
        setPrimaryNameDisplay('');
      }

      function buildAttendeeFromCard(card: HTMLElement, isPrimary: boolean): any {
        const get = (sel: string) => card.querySelector(sel) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement | null;
        const attendingSel = get('select[data-field="attending"]') as HTMLSelectElement | null;
        const attending = attendingFromSelect(attendingSel?.value || '');
        // Returns the select's value but coerces to '' if the currently
        // selected option is a legacy-unknown placeholder. The server's
        // validator only accepts the canonical choice set, so passing an
        // unknown value back would reject the save with bad_*_choice.
        const safeChoice = (fld: string): string => {
          const sel = get(`select[data-field="${fld}"]`) as HTMLSelectElement | null;
          if (!sel) return '';
          const opt = sel.selectedOptions[0];
          if (opt && (opt as HTMLOptionElement).dataset.unknownLegacy === 'true') return '';
          return sel.value || '';
        };
        const out: any = { attending };
        for (const fld of MEAL_FIELDS_ADMIN) out[fld] = safeChoice(fld);
        out.dietary = ((get('input[data-field="dietary"]') as HTMLInputElement | null)?.value || '').trim();
        out.songRequest = ((get('input[data-field="songRequest"]') as HTMLInputElement | null)?.value || '').trim();
        if (isPrimary) {
          out.notes = ((get('textarea[data-field="notes"]') as HTMLTextAreaElement | null)?.value || '').trim();
        } else {
          out.name = ((get('input[data-field="name"]') as HTMLInputElement | null)?.value || '').trim();
          const typeSel = get('select[data-field="guestType"]') as HTMLSelectElement | null;
          out.isKid = typeSel?.value === 'child';
          out.id = (get('input[data-guest-id]') as HTMLInputElement | null)?.value || randomGuestId();
        }
        // Match the server's "not attending discards meal picks" rule so the
        // diff preview shows what the server will actually store.
        if (attending !== true) {
          for (const fld of MEAL_FIELDS_ADMIN) out[fld] = '';
          out.dietary = '';
          out.songRequest = '';
        }
        return out;
      }

      function buildPayloadFromForm(): any {
        const primaryRoot = primaryAttendeeRoot();
        const primary = primaryRoot ? buildAttendeeFromCard(primaryRoot, true) : {
          attending: null, entradaChoice: '', sorbetChoice: '', mealChoice: '', postreChoice: '',
          dietary: '', songRequest: '', notes: ''
        };
        const cards = guestCards();
        const guests: any[] = [];
        for (const card of cards) {
          const g = buildAttendeeFromCard(card, false);
          const isExisting = card.dataset.existingGuest === 'true';
          const isBlank = !g.name && g.attending === null && !g.dietary && !g.songRequest
            && !MEAL_FIELDS_ADMIN.some((f) => g[f]);
          // Newly-added entirely-blank cards are silently dropped so the
          // admin can experiment with the + Add guest button without tripping
          // a server validation error. Existing guest cards are ALWAYS kept;
          // if the admin really wants to delete one, they click Remove guest
          // (which triggers a destructive-confirm + a "Removed" diff entry).
          if (!isExisting && isBlank) continue;
          guests.push(g);
        }
        return { schemaVersion: SCHEMA_VERSION, primary, additionalGuests: guests };
      }

      // Stable canonical JSON for original-vs-built equality. Sorts guest
      // array by id so reorder-only edits don't count as a change.
      function canonicalize(payload: any): string {
        if (!payload || typeof payload !== 'object') return JSON.stringify(payload);
        const p = payload.primary || {};
        const guests = Array.isArray(payload.additionalGuests) ? payload.additionalGuests.slice() : [];
        guests.sort((a: any, b: any) => String(a?.id || '').localeCompare(String(b?.id || '')));
        return JSON.stringify({
          schemaVersion: payload.schemaVersion || SCHEMA_VERSION,
          primary: {
            attending: p.attending ?? null,
            entradaChoice: p.entradaChoice || '',
            sorbetChoice: p.sorbetChoice || '',
            mealChoice: p.mealChoice || '',
            postreChoice: p.postreChoice || '',
            dietary: p.dietary || '',
            songRequest: p.songRequest || '',
            notes: p.notes || ''
          },
          additionalGuests: guests.map((g: any) => ({
            id: g?.id || '',
            name: g?.name || '',
            isKid: !!g?.isKid,
            attending: g?.attending ?? null,
            entradaChoice: g?.entradaChoice || '',
            sorbetChoice: g?.sorbetChoice || '',
            mealChoice: g?.mealChoice || '',
            postreChoice: g?.postreChoice || '',
            dietary: g?.dietary || '',
            songRequest: g?.songRequest || ''
          }))
        });
      }

      interface DiffEntry {
        scope: string;       // human label: "Primary (Jane Doe)" or "Guest: John Smith"
        kind: 'changed' | 'added' | 'removed';
        changes: string[];   // ["attending: — → Yes", "main: empty → chicken"]
        destructive: boolean;
      }

      function diffAttendee(scope: string, before: any, after: any, isPrimary: boolean): DiffEntry | null {
        const changes: string[] = [];
        let destructive = false;
        const wasAttending = before?.attending === true;
        const isAttending = after?.attending === true;

        if ((before?.attending ?? null) !== (after?.attending ?? null)) {
          changes.push(`attending: ${displayAttending(before?.attending ?? null)} → ${displayAttending(after?.attending ?? null)}`);
          if (wasAttending && !isAttending) destructive = true;
        }
        for (const fld of MEAL_FIELDS_ADMIN) {
          const b = before?.[fld] || '';
          const a = after?.[fld] || '';
          if (b !== a) {
            changes.push(`${FIELD_HUMAN_LABEL[fld]}: ${displayChoice(fld, b) || 'empty'} → ${displayChoice(fld, a) || 'empty'}`);
            if (b && !a) destructive = true;
          }
        }
        for (const fld of ['dietary', 'songRequest'] as const) {
          const b = (before?.[fld] || '').trim();
          const a = (after?.[fld] || '').trim();
          if (b !== a) {
            const bDisp = b ? `"${b}"` : 'empty';
            const aDisp = a ? `"${a}"` : 'empty';
            changes.push(`${FIELD_HUMAN_LABEL[fld]}: ${bDisp} → ${aDisp}`);
            if (b && !a) destructive = true;
          }
        }
        if (isPrimary) {
          const b = (before?.notes || '').trim();
          const a = (after?.notes || '').trim();
          if (b !== a) {
            changes.push(`notes: ${b ? `"${b.slice(0, 40)}${b.length > 40 ? '…' : ''}"` : 'empty'} → ${a ? `"${a.slice(0, 40)}${a.length > 40 ? '…' : ''}"` : 'empty'}`);
            if (b && !a) destructive = true;
          }
        } else {
          if ((before?.name || '') !== (after?.name || '')) {
            changes.push(`name: ${before?.name || 'empty'} → ${after?.name || 'empty'}`);
          }
          if (!!before?.isKid !== !!after?.isKid) {
            changes.push(`adult/child: ${before?.isKid ? 'child' : 'adult'} → ${after?.isKid ? 'child' : 'adult'}`);
          }
        }
        if (changes.length === 0) return null;
        return { scope, kind: 'changed', changes, destructive };
      }

      function attendeeSummary(a: any): string[] {
        const bits: string[] = [];
        bits.push(`attending: ${displayAttending(a?.attending ?? null)}`);
        for (const fld of MEAL_FIELDS_ADMIN) {
          if (a?.[fld]) bits.push(`${FIELD_HUMAN_LABEL[fld]}: ${displayChoice(fld, a[fld])}`);
        }
        if ((a?.dietary || '').trim()) bits.push(`dietary: "${a.dietary.trim()}"`);
        if ((a?.songRequest || '').trim()) bits.push(`song: "${a.songRequest.trim()}"`);
        return bits;
      }

      function computeDiff(before: any, after: any, primaryName: string): DiffEntry[] {
        const entries: DiffEntry[] = [];
        const primaryDiff = diffAttendee(
          `Primary (${primaryName || 'invitee'})`,
          before?.primary || {},
          after?.primary || {},
          true
        );
        if (primaryDiff) entries.push(primaryDiff);

        const beforeGuests = Array.isArray(before?.additionalGuests) ? before.additionalGuests : [];
        const afterGuests = Array.isArray(after?.additionalGuests) ? after.additionalGuests : [];
        const beforeById = new Map<string, any>();
        for (const g of beforeGuests) if (g?.id) beforeById.set(g.id, g);
        const afterById = new Map<string, any>();
        for (const g of afterGuests) if (g?.id) afterById.set(g.id, g);

        // Removed (in before, not in after) — destructive
        for (const g of beforeGuests) {
          if (g?.id && !afterById.has(g.id)) {
            const label = g.name || '(unnamed guest)';
            entries.push({
              scope: `Guest: ${label}${g.isKid ? ' (child)' : ''}`,
              kind: 'removed',
              changes: attendeeSummary(g),
              destructive: true
            });
          }
        }
        // Added (in after, not in before)
        for (const g of afterGuests) {
          if (g?.id && !beforeById.has(g.id)) {
            const label = g.name || '(unnamed guest)';
            entries.push({
              scope: `Guest: ${label}${g.isKid ? ' (child)' : ''}`,
              kind: 'added',
              changes: attendeeSummary(g),
              destructive: false
            });
          }
        }
        // Changed (in both)
        for (const g of afterGuests) {
          if (g?.id && beforeById.has(g.id)) {
            const beforeG = beforeById.get(g.id);
            const label = g.name || beforeG?.name || '(unnamed guest)';
            const d = diffAttendee(`Guest: ${label}${g.isKid ? ' (child)' : ''}`, beforeG, g, false);
            if (d) entries.push(d);
          }
        }
        return entries;
      }

      function showDiffModal(entries: DiffEntry[], onConfirm: () => void) {
        const diffModal = document.getElementById('admin-diff-modal') as HTMLDivElement | null;
        const list = document.getElementById('admin-diff-list') as HTMLUListElement | null;
        const confirmBtn = document.getElementById('admin-diff-confirm') as HTMLButtonElement | null;
        if (!diffModal || !list || !confirmBtn) {
          // Fallback: no diff UI, just confirm
          onConfirm();
          return;
        }
        // Tear down any prior session's handlers first so a stale doSave
        // closure from a previously-closed-but-not-confirmed diff can't fire.
        if (activeDiffCleanup) {
          activeDiffCleanup();
          activeDiffCleanup = null;
        }
        list.innerHTML = '';
        for (const e of entries) {
          const li = document.createElement('li');
          li.className = `admin-diff-entry admin-diff-entry--${e.kind}${e.destructive ? ' admin-diff-entry--destructive' : ''}`;
          const badge = e.kind === 'removed' ? 'REMOVED' : e.kind === 'added' ? 'NEW' : 'CHANGED';
          const ul = e.changes.map((c) => `<li>${escapeHtml(c)}</li>`).join('');
          li.innerHTML = `<div class="admin-diff-entry-head"><span class="admin-diff-badge">${badge}</span><strong>${escapeHtml(e.scope)}</strong></div><ul class="admin-diff-changes">${ul}</ul>`;
          list.appendChild(li);
        }
        diffModal.hidden = false;

        // Use .onclick (single slot) instead of addEventListener so there's
        // no chance of accumulating listeners across diff-modal cycles.
        const handleConfirm = () => {
          if (activeDiffCleanup) { activeDiffCleanup(); activeDiffCleanup = null; }
          onConfirm();
        };
        const closeAll = () => {
          if (activeDiffCleanup) { activeDiffCleanup(); activeDiffCleanup = null; }
        };
        confirmBtn.onclick = handleConfirm;
        const closeEls = Array.from(diffModal.querySelectorAll('[data-diff-close]')) as HTMLElement[];
        for (const el of closeEls) {
          (el as HTMLElement & { onclick: any }).onclick = closeAll;
        }
        activeDiffCleanup = () => {
          diffModal.hidden = true;
          confirmBtn.onclick = null;
          for (const el of closeEls) (el as HTMLElement & { onclick: any }).onclick = null;
        };
      }

      // Tracks the active diff-modal confirm handler so closeModal can clear
      // it. Without this, dismissing the parent admin modal while the diff is
      // open would leave a stale handler bound to the next opened invite's
      // doSave closure — a real data-loss path on subsequent edits.
      let activeDiffCleanup: (() => void) | null = null;

      document.getElementById('admin-add-guest')?.addEventListener('click', () => {
        if (guestCards().length >= ADMIN_MAX_GUESTS) return;
        const list = guestList();
        if (!list) return;
        const card = buildGuestCard(null, false);
        if (card) {
          list.appendChild(card);
          updateGuestCountDisplay();
          (card.querySelector('input[data-field="name"]') as HTMLInputElement | null)?.focus();
        }
      });

      // Wire the primary attendee's attending-toggle once at init so we don't
      // accumulate listeners every time openModal is called. Guest cards are
      // cloned fresh from the template, so they get wired in buildGuestCard.
      wireAttendingToggle(primaryAttendeeRoot());

      function showError(msg: string) {
        if (!errorEl) return;
        errorEl.textContent = msg;
        errorEl.hidden = false;
      }
      function clearError() {
        if (!errorEl) return;
        errorEl.textContent = '';
        errorEl.hidden = true;
      }
      function setStatus(msg: string, tone: 'ok' | 'warn' | '' = '') {
        if (!settingsStatus) return;
        settingsStatus.textContent = msg;
        settingsStatus.dataset.tone = tone;
        if (msg) {
          window.setTimeout(() => {
            if (settingsStatus.textContent === msg) {
              settingsStatus.textContent = '';
              settingsStatus.dataset.tone = '';
            }
          }, 4500);
        }
      }

      let LAST_DATA: any = null;
      let LAST_EVENTS: any[] = [];
      let EXPANDED_ID: string | null = null;

      function showGate(statusMsg?: string) {
        const app = document.getElementById('admin-app');
        const gate = document.getElementById('admin-gate');
        if (app) (app as HTMLElement).hidden = true;
        if (gate) (gate as HTMLElement).hidden = false;
        const statusEl = document.getElementById('admin-gate-status') as HTMLDivElement | null;
        if (statusEl) {
          if (statusMsg) {
            statusEl.textContent = statusMsg;
            statusEl.dataset.tone = 'error';
            statusEl.hidden = false;
          } else {
            statusEl.textContent = '';
            statusEl.hidden = true;
          }
        }
      }

      function showApp() {
        const gate = document.getElementById('admin-gate');
        const app = document.getElementById('admin-app');
        if (gate) (gate as HTMLElement).hidden = true;
        if (app) (app as HTMLElement).hidden = false;
      }

      // Read ?login=... query param (set on redirect from confirm.astro on
      // a failure path) and translate it into a human-readable message.
      function loginQueryMessage(): string {
        try {
          const params = new URLSearchParams(location.search);
          const code = (params.get('login') || '').toLowerCase();
          if (!code) return '';
          if (code === 'expired') return 'That sign-in link expired. Request a new one below.';
          if (code === 'replayed') return 'That sign-in link was already used. Request a new one below.';
          if (code === 'invalid') return 'That sign-in link is invalid. Request a new one below.';
          if (code === 'rate_limited') return 'Too many sign-in attempts. Please wait a minute and try again.';
        } catch {}
        return '';
      }

      // Wire up the email magic-link form. POSTs the address to
      // admin-login-request and surfaces a generic 200 confirmation
      // regardless of whether the address is allowlisted, so the gate
      // can't be used as an enumeration oracle.
      function wireEmailGate() {
        const form = document.getElementById('admin-email-form') as HTMLFormElement | null;
        const input = document.getElementById('admin-email-input') as HTMLInputElement | null;
        const submit = document.getElementById('admin-email-submit') as HTMLButtonElement | null;
        const status = document.getElementById('admin-email-status') as HTMLDivElement | null;
        if (!form || !input || !submit || !status) return;
        form.addEventListener('submit', async (ev) => {
          ev.preventDefault();
          const email = (input.value || '').trim();
          if (!email) {
            status.textContent = 'Enter an email address.';
            status.dataset.tone = 'error';
            return;
          }
          const submitOriginalHtml = submit.innerHTML;
          const spinnerHtml = '<span class="btn-spinner" aria-hidden="true"><span></span><span></span><span></span></span>';
          // Progressive copy so the user sees the page actively working
          // through a multi-second send, not a single frozen string.
          const stages = [
            'Sending sign-in link\u2026',
            'Reaching the email server\u2026',
            'Almost there\u2026',
            'Still working \u2014 hang tight\u2026'
          ];
          let stageIdx = 0;
          const renderStage = () => {
            submit.innerHTML = spinnerHtml + '<span>' + stages[Math.min(stageIdx, stages.length - 1)] + '</span>';
          };
          submit.disabled = true;
          submit.setAttribute('aria-busy', 'true');
          renderStage();
          const stageTimer = window.setInterval(() => {
            stageIdx += 1;
            renderStage();
          }, 2500);
          status.textContent = '';
          status.dataset.tone = '';
          try {
            const res = await fetch('/api/mgmt/admin-login-request', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              credentials: 'same-origin',
              cache: 'no-store',
              body: JSON.stringify({ email })
            });
            if (res.status === 429) {
              status.textContent = 'Too many sign-in attempts from this network. Please wait a minute and try again.';
              status.dataset.tone = 'error';
            } else if (!res.ok) {
              status.textContent = `Sign-in request failed (HTTP ${res.status}). Try again.`;
              status.dataset.tone = 'error';
            } else {
              status.textContent = 'If that address can sign in, a link is on the way. Check your inbox \u2014 and spam \u2014 within the next minute.';
              status.dataset.tone = 'ok';
            }
          } catch (err: any) {
            status.textContent = `Couldn\u2019t reach the sign-in service: ${err && err.message ? err.message : 'unknown error'}.`;
            status.dataset.tone = 'error';
          } finally {
            window.clearInterval(stageTimer);
            submit.innerHTML = submitOriginalHtml;
            submit.removeAttribute('aria-busy');
            submit.disabled = false;
          }
        });
      }
      wireEmailGate();

      async function ensureAuthed(): Promise<boolean> {
        try {
          const res = await fetch('/api/mgmt/admin-whoami', {
            credentials: 'same-origin',
            cache: 'no-store'
          });
          if (!res.ok) {
            // whoami should always 200 — if it didn't, treat as not-authed.
            showGate(loginQueryMessage() || 'Could not verify sign-in. Please sign in again.');
            return false;
          }
          const data = await res.json().catch(() => null) as any;
          if (!data || !data.authed) {
            showGate(loginQueryMessage());
            return false;
          }
          showApp();
          if (userLabel) {
            const label = typeof data.label === 'string' ? data.label : '';
            const suffix = data.mode === 'email' ? '(admin email)' : '(github)';
            userLabel.textContent = label ? `${label} ${suffix}` : suffix;
          }
          // The logout link is anchored on GitHub auth by default. For the
          // email path we override the href + intercept the click to POST to
          // admin-logout so the admin_session cookie is cleared too.
          const logoutLink = document.getElementById('admin-logout-link') as HTMLAnchorElement | null;
          if (logoutLink) {
            if (data.mode === 'email') {
              logoutLink.href = '/';
              logoutLink.addEventListener('click', async (ev) => {
                ev.preventDefault();
                try {
                  await fetch('/api/mgmt/admin-logout', {
                    method: 'POST',
                    credentials: 'same-origin',
                    cache: 'no-store'
                  });
                } catch {}
                location.replace('/');
              });
            } else {
              logoutLink.href = '/.auth/logout?post_logout_redirect_uri=/';
            }
          }
          return true;
        } catch {
          showGate('Could not contact the admin service. Please reload.');
          return false;
        }
      }

      async function loadGuests() {
        clearError();
        try {
          // cache: 'no-store' + cache-busting query param so the
          // Refresh button always hits the API. Without these, some
          // browsers will replay a stale cached fetch response even
          // though the server sets Cache-Control: no-store.
          const res = await fetch(`/api/mgmt/guests?_=${Date.now()}`, {
            credentials: 'same-origin',
            cache: 'no-store',
            headers: { 'Cache-Control': 'no-cache' },
          });
          if (res.status === 401) { showError('Session expired. Showing sign-in…'); showGate('Your session expired. Please sign in again.'); return; }
          if (res.status === 403) { showError('Your account is signed in but is not authorized.'); return; }
          if (!res.ok) { showError(`Couldn't load invites (HTTP ${res.status}).`); return; }
          const data = await res.json();
          LAST_DATA = data;
          render(data);
        } catch (e: any) {
          showError(`Couldn't load invites: ${e && e.message}`);
        }
      }

      // --- Recent activity panel -----------------------------------------
      // Builds DOM via createElement + textContent only. Event fields can
      // contain user-provided strings (invitee names, commit messages, even
      // forged values if a secret leaks), so we MUST NOT interpolate them
      // into innerHTML.

      function badgeKind(type: string): string {
        if (type.startsWith('rsvp.')) return 'rsvp';
        if (type.startsWith('admin.')) return 'admin';
        if (type.startsWith('deploy.')) return 'deploy';
        if (type.startsWith('backup.')) return 'backup';
        if (type.startsWith('cron.')) return 'cron';
        if (type.startsWith('sms.')) return 'sms';
        return 'other';
      }

      function relativeTime(d: Date): string {
        const ms = Date.now() - d.getTime();
        if (!isFinite(ms)) return '';
        if (ms < 0) return 'just now';
        const s = Math.round(ms / 1000);
        if (s < 60) return `${s}s ago`;
        const m = Math.round(s / 60);
        if (m < 60) return `${m}m ago`;
        const h = Math.round(m / 60);
        if (h < 24) return `${h}h ago`;
        const dys = Math.round(h / 24);
        if (dys < 30) return `${dys}d ago`;
        return d.toLocaleDateString();
      }

      function renderEvent(ev: any): HTMLLIElement {
        const li = document.createElement('li');
        li.className = 'admin-event';

        const time = document.createElement('time');
        time.className = 'admin-event-time';
        const d = new Date(ev.createdAt);
        if (isFinite(d.getTime())) {
          time.dateTime = ev.createdAt;
          // Show exact local timestamp (date + time) as the visible value;
          // keep the relative form as the hover title for quick scanning.
          time.textContent = d.toLocaleString(undefined, {
            year: 'numeric', month: 'short', day: '2-digit',
            hour: 'numeric', minute: '2-digit',
          });
          time.title = relativeTime(d);
        } else {
          time.textContent = String(ev.createdAt || '');
        }
        li.appendChild(time);

        const badge = document.createElement('span');
        const type = String(ev.type || '');
        badge.className = `admin-event-badge admin-event-badge--${badgeKind(type)}`;
        badge.textContent = type;
        li.appendChild(badge);

        const actor = document.createElement('span');
        actor.className = 'admin-event-actor';
        actor.textContent = String(ev.actor || '');
        li.appendChild(actor);

        const summary = document.createElement('span');
        summary.className = 'admin-event-summary';
        summary.textContent = String(ev.summary || '');
        li.appendChild(summary);

        return li;
      }

      async function loadEvents() {
        const listEl = document.getElementById('admin-events') as HTMLUListElement | null;
        const countEl = document.getElementById('events-count') as HTMLSpanElement | null;
        if (!listEl) return;
        try {
          const res = await fetch(`/api/mgmt/events?_=${Date.now()}`, {
            credentials: 'same-origin',
            cache: 'no-store',
            headers: { 'Cache-Control': 'no-cache' },
          });
          if (!res.ok) {
            LAST_EVENTS = [];
            listEl.replaceChildren();
            const li = document.createElement('li');
            li.className = 'admin-events-empty';
            li.textContent = `Could not load events (HTTP ${res.status})`;
            listEl.appendChild(li);
            if (countEl) countEl.textContent = '';
            return;
          }
          const data = await res.json();
          LAST_EVENTS = Array.isArray(data.events) ? data.events : [];
          renderEvents();
        } catch (e: any) {
          LAST_EVENTS = [];
          listEl.replaceChildren();
          const li = document.createElement('li');
          li.className = 'admin-events-empty';
          li.textContent = `Load failed: ${e && e.message}`;
          listEl.appendChild(li);
          if (countEl) countEl.textContent = '';
        }
      }

      // Reads filter state from the DOM and re-renders the events list.
      // Called by loadEvents() after fetch, and by the filter UI on every
      // checkbox / search-input change. Pure client-side filtering — no
      // network round-trip — so it can fire on every keystroke without
      // needing a debounce for the volumes we expect.
      function renderEvents() {
        const listEl = document.getElementById('admin-events') as HTMLUListElement | null;
        const countEl = document.getElementById('events-count') as HTMLSpanElement | null;
        if (!listEl) return;

        const searchEl = document.getElementById('events-search') as HTMLInputElement | null;
        const q = (searchEl?.value || '').trim().toLowerCase();

        const allowed = new Set<string>();
        const cats = document.querySelectorAll<HTMLInputElement>('.admin-events-cats input[type="checkbox"][data-cat]');
        cats.forEach((cb) => { if (cb.checked) allowed.add(cb.dataset.cat || ''); });

        const filtered = LAST_EVENTS.filter((ev) => {
          const type = String(ev.type || '');
          if (!allowed.has(badgeKind(type))) return false;
          if (!q) return true;
          const hay = (type + ' ' + String(ev.actor || '') + ' ' + String(ev.summary || '')).toLowerCase();
          return hay.includes(q);
        });

        const total = LAST_EVENTS.length;
        if (countEl) {
          if (total === 0) {
            countEl.textContent = '';
          } else if (filtered.length === total) {
            countEl.textContent = `${total} events`;
          } else {
            countEl.textContent = `${filtered.length} of ${total} events`;
          }
        }

        listEl.replaceChildren();
        if (total === 0) {
          const li = document.createElement('li');
          li.className = 'admin-events-empty';
          li.textContent = 'No activity yet.';
          listEl.appendChild(li);
          return;
        }
        if (filtered.length === 0) {
          const li = document.createElement('li');
          li.className = 'admin-events-empty';
          li.textContent = 'No events match the current filters.';
          listEl.appendChild(li);
          return;
        }
        for (const ev of filtered) {
          listEl.appendChild(renderEvent(ev));
        }
      }

      function escapeHtml(s: any): string {
        return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c] as string));
      }

      // Build an aggregate-only CSV from the admin payload. Safe to share with
      // third parties (caterer, venue) — never emits names, phones, or any
      // free-text answer. Choice labels are hardcoded; unknown payload values
      // are bucketed into a single "Invalid/unknown selection" row.
      function buildSummaryCsv(data: any): string {
        const overall = (data && data.overall) || {};
        const rows: any[] = Array.isArray(data && data.rows) ? data.rows : [];

        const ENTRADA: Record<string, string> = { salpicon: 'Salpicon', hojaldre: 'Beef puff pastry', causa: 'Causa' };
        const SORBET: Record<string, string> = { maracuya: 'Passion fruit', mandarina: 'Mandarin mint' };
        const MEAL: Record<string, string> = { chicken: 'Chicken', beef: 'Beef' };
        const POSTRE: Record<string, string> = { chocolate: 'Chocolate', cheesecake: 'Cheesecake', tiramisu: 'Tiramisu' };

        function eachAttendingGuest(cb: (a: any) => void) {
          for (const r of rows) {
            const p = (r && r.invite && r.invite.payload) || {};
            if (p.primary && p.primary.attending === true) cb(p.primary);
            if (Array.isArray(p.additionalGuests)) {
              for (const g of p.additionalGuests) {
                if (g && g.attending === true) cb(g);
              }
            }
          }
        }

        function tally(key: string, allowed: Record<string, string>) {
          const counts: Record<string, number> = {};
          for (const k of Object.keys(allowed)) counts[k] = 0;
          let missing = 0;
          let unknown = 0;
          eachAttendingGuest((a) => {
            const v = a[key];
            if (!v) { missing += 1; return; }
            if (Object.prototype.hasOwnProperty.call(allowed, v)) counts[v] += 1;
            else unknown += 1;
          });
          return { counts, missing, unknown };
        }

        let dietaryFollowup = 0;
        eachAttendingGuest((a) => {
          if (typeof a.dietary === 'string' && a.dietary.trim().length > 0) dietaryFollowup += 1;
        });

        const out: Array<[string, string, number | string]> = [];
        const now = new Date();
        const generatedAt = now.toISOString().replace('T', ' ').slice(0, 16) + ' UTC';
        out.push(['Snapshot', 'Generated at (UTC)', generatedAt]);
        out.push(['Invitations', 'Total invitations', overall.inviteCount || 0]);
        out.push(['Invitations', 'Responded', overall.respondedCount || 0]);
        out.push(['Invitations', 'Awaiting response', overall.pendingCount || 0]);
        out.push(['Guests', 'Attending (yes)', overall.totalYes || 0]);
        out.push(['Guests', 'Declined (no)', overall.totalNo || 0]);
        out.push(['Guests', 'Attendance unknown', overall.totalPending || 0]);
        out.push(['Guests', 'Adults attending', overall.totalAdults || 0]);
        out.push(['Guests', 'Kids attending', overall.totalKids || 0]);

        const courses: Array<[string, string, Record<string, string>]> = [
          ['Appetizer', 'entradaChoice', ENTRADA],
          ['Sorbet', 'sorbetChoice', SORBET],
          ['Main', 'mealChoice', MEAL],
          ['Dessert', 'postreChoice', POSTRE]
        ];
        for (const [section, key, allowed] of courses) {
          const { counts, missing, unknown } = tally(key, allowed);
          for (const k of Object.keys(allowed)) {
            out.push([section, allowed[k], counts[k]]);
          }
          out.push([section, `Attending guests missing ${section.toLowerCase()} selection`, missing]);
          if (unknown > 0) out.push([section, 'Invalid/unknown selection', unknown]);
        }

        out.push(['Dietary', 'Attending guests needing dietary follow-up', dietaryFollowup]);

        function esc(v: string): string {
          if (/[",\r\n]/.test(v)) return '"' + v.replace(/"/g, '""') + '"';
          return v;
        }
        const lines: string[] = ['Section,Option,Count'];
        for (const [s, o, c] of out) {
          lines.push([s, o, String(c)].map(esc).join(','));
        }
        // BOM + CRLF for Excel friendliness (RFC 4180).
        return '\ufeff' + lines.join('\r\n') + '\r\n';
      }

      function downloadCsv(filename: string, csv: string) {
        const blob = new Blob([csv], { type: 'text/csv;charset=utf-8' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = filename;
        a.style.display = 'none';
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        window.setTimeout(() => URL.revokeObjectURL(url), 0);
      }

      function render(data: any) {
        if (remindersChk) remindersChk.checked = !!(data.settings && data.settings.remindersEnabled);
        if (remindersStopEl && data.settings && data.settings.remindersStopOnUtc) {
          const stop = new Date(data.settings.remindersStopOnUtc);
          remindersStopEl.textContent = `Hard stop: ${isFinite(stop.getTime()) ? stop.toLocaleDateString() : data.settings.remindersStopOnUtc}`;
        }
        if (overallEl && data.overall) {
          const o = data.overall;
          overallEl.innerHTML = `
            <div><strong>${o.inviteCount}</strong> invitations</div>
            <div><strong>${o.respondedCount}</strong> responded · <strong>${o.pendingCount}</strong> pending</div>
            <div><strong>${o.totalYes}</strong> yes / <strong>${o.totalNo}</strong> no / <strong>${o.totalPending}</strong> ?</div>
            <div><strong>${o.totalAdults}</strong> adults · <strong>${o.totalKids}</strong> kids</div>
            <div><strong>${o.withPhone}</strong> with phone · <strong>${o.optedOutCount}</strong> opted out · <strong>${o.hardFailedCount}</strong> hard-fail</div>
          `;
        }
        if (exportBtn) exportBtn.disabled = false;
        if (!tbody) return;
        if (!data.rows || data.rows.length === 0) {
          tbody.innerHTML = '<tr><td colspan="6" class="admin-muted">No invitations yet. Create one with the button above, or run the seed script.</td></tr>';
          EXPANDED_ID = null;
          return;
        }
        tbody.innerHTML = data.rows.map(renderRow).join('');
        // Drop stale expanded id if the invite is gone (e.g., after delete).
        if (EXPANDED_ID && !data.rows.some((r: any) => r.invite.inviteId === EXPANDED_ID)) {
          EXPANDED_ID = null;
        }
        tbody.querySelectorAll('button[data-action]').forEach((btn) => {
          btn.addEventListener('click', onActionClick);
        });
        tbody.querySelectorAll('tr.admin-data-row').forEach((tr) => {
          tr.addEventListener('click', (ev) => {
            if ((ev.target as HTMLElement).closest('button')) return;
            toggleRow((tr as HTMLTableRowElement).dataset.inviteId || '');
          });
        });
      }

      function renderRow(row: any): string {
        const inv = row.invite;
        const s = row.summary;
        const phoneCell = inv.phone ? escapeHtml(inv.phone) : '<span class="admin-muted">—</span>';
        const optBadge = inv.optedOutOfSms ? ' <span class="admin-badge admin-badge--warn">opted out</span>' : '';
        const hardBadge = inv.smsHardFailedAt ? ' <span class="admin-badge admin-badge--warn">hard-fail</span>' : '';
        const respondedBadge = inv.responded ? '<span class="admin-badge admin-badge--ok">yes</span>' : '<span class="admin-muted">—</span>';
        const lastReminder = inv.lastReminderSentAt
          ? `${escapeHtml(new Date(inv.lastReminderSentAt).toLocaleDateString())} (#${inv.reminderCount || 0})`
          : '<span class="admin-muted">—</span>';
        const headcountBits: string[] = [];
        if (s.yes) headcountBits.push(`<strong>${s.yes}</strong> yes`);
        if (s.no) headcountBits.push(`${s.no} no`);
        if (s.pending) headcountBits.push(`<span class="admin-muted">${s.pending} ?</span>`);
        if (s.kids) headcountBits.push(`<span class="admin-muted">(${s.kids} kid${s.kids === 1 ? '' : 's'})</span>`);
        const headcount = headcountBits.length ? headcountBits.join(' · ') : '<span class="admin-muted">—</span>';
        const idLabel = `${inv.primaryFirstName} ${inv.primaryLastName}`.trim() || inv.inviteId;
        const totalOnInvite = (s.yes || 0) + (s.no || 0) + (s.pending || 0);
        const totalCard = totalOnInvite > 1 ? ` <span class="admin-muted">(${totalOnInvite} on this invite)</span>` : '';
        const sendBtn = inv.phoneNorm
          ? `<button class="btn btn--ghost btn--small" data-action="send-reminder" data-invite-id="${escapeHtml(inv.inviteId)}">Send reminder</button>`
          : '';
        const editBtn = `<button class="btn btn--ghost btn--small" data-action="edit" data-invite-id="${escapeHtml(inv.inviteId)}">Edit</button>`;
        const deleteBtn = `<button class="btn btn--ghost btn--small admin-btn-danger" data-action="delete" data-invite-id="${escapeHtml(inv.inviteId)}">Delete</button>`;
        const isExpanded = EXPANDED_ID === inv.inviteId;
        const dataRowClasses = ['admin-data-row'];
        if (inv.responded) dataRowClasses.push('is-responded');
        if (isExpanded) dataRowClasses.push('is-expanded');
        return `
          <tr data-invite-id="${escapeHtml(inv.inviteId)}" class="${dataRowClasses.join(' ')}">
            <td data-label="Primary invitee" class="admin-cell--primary"><span class="admin-chevron" aria-hidden="true">▸</span>${escapeHtml(idLabel)}${totalCard}${optBadge}${hardBadge}</td>
            <td data-label="Responded">${respondedBadge}</td>
            <td data-label="Headcount">${headcount}</td>
            <td data-label="Phone · Locale">${phoneCell}${inv.phone ? ` <span class="admin-muted">${escapeHtml(inv.locale)}</span>` : ''}</td>
            <td data-label="Last reminder">${lastReminder}</td>
            <td data-label="Actions" class="admin-cell--actions">${sendBtn} ${editBtn} ${deleteBtn}</td>
          </tr>
          <tr class="admin-detail-row" data-detail-for="${escapeHtml(inv.inviteId)}"${isExpanded ? '' : ' hidden'}>
            <td colspan="6">${buildDetailHtml(row)}</td>
          </tr>
        `;
      }

      function toggleRow(inviteId: string) {
        if (!tbody || !inviteId) return;
        const sel = (typeof CSS !== 'undefined' && CSS.escape) ? CSS.escape(inviteId) : inviteId.replace(/[^a-zA-Z0-9_-]/g, '');
        const wasOpen = EXPANDED_ID === inviteId;
        if (EXPANDED_ID) {
          const prevSel = (typeof CSS !== 'undefined' && CSS.escape) ? CSS.escape(EXPANDED_ID) : EXPANDED_ID.replace(/[^a-zA-Z0-9_-]/g, '');
          const prevData = tbody.querySelector(`tr.admin-data-row[data-invite-id="${prevSel}"]`) as HTMLTableRowElement | null;
          const prevDetail = tbody.querySelector(`tr.admin-detail-row[data-detail-for="${prevSel}"]`) as HTMLTableRowElement | null;
          if (prevData) prevData.classList.remove('is-expanded');
          if (prevDetail) prevDetail.hidden = true;
        }
        if (wasOpen) {
          EXPANDED_ID = null;
          return;
        }
        EXPANDED_ID = inviteId;
        const dataRow = tbody.querySelector(`tr.admin-data-row[data-invite-id="${sel}"]`) as HTMLTableRowElement | null;
        const detailRow = tbody.querySelector(`tr.admin-detail-row[data-detail-for="${sel}"]`) as HTMLTableRowElement | null;
        if (dataRow) dataRow.classList.add('is-expanded');
        if (detailRow) detailRow.hidden = false;
      }

      function buildDetailHtml(row: any): string {
        const inv = row.invite;
        const payload = inv.payload || { primary: {}, additionalGuests: [] };
        const courseLabel = (key: string, value: string): string => {
          const map: Record<string, Record<string, string>> = {
            entradaChoice: { salpicon: 'salpicon', hojaldre: 'beef-puff-pastry', causa: 'causa' },
            sorbetChoice: { maracuya: 'passion-fruit', mandarina: 'mandarin-mint' },
            mealChoice: { chicken: 'chicken', beef: 'beef' },
            postreChoice: { chocolate: 'chocolate', cheesecake: 'cheesecake', tiramisu: 'tiramisu' }
          };
          return (map[key] && map[key][value]) || value;
        };
        const courseName = (key: string): string => ({
          entradaChoice: 'appetizer',
          sorbetChoice: 'sorbet',
          mealChoice: 'main',
          postreChoice: 'dessert'
        } as Record<string, string>)[key] || key;
        const renderAttendee = (a: any, label: string) => {
          const courses: string[] = [];
          if (a.attending === true) {
            if (a.entradaChoice) courses.push(`${courseName('entradaChoice')}: ${escapeHtml(courseLabel('entradaChoice', a.entradaChoice))}`);
            if (a.sorbetChoice) courses.push(`${courseName('sorbetChoice')}: ${escapeHtml(courseLabel('sorbetChoice', a.sorbetChoice))}`);
            if (a.mealChoice) courses.push(`${courseName('mealChoice')}: ${escapeHtml(courseLabel('mealChoice', a.mealChoice))}`);
            if (a.postreChoice) courses.push(`${courseName('postreChoice')}: ${escapeHtml(courseLabel('postreChoice', a.postreChoice))}`);
          }
          return `
          <li>
            <strong>${escapeHtml(label)}</strong>
            — attending: <strong>${a.attending === true ? 'YES' : a.attending === false ? 'NO' : '—'}</strong>
            ${courses.length ? ` · ${courses.join(' · ')}` : ''}
            ${a.dietary ? ` · dietary: ${escapeHtml(a.dietary)}` : ''}
            ${a.songRequest ? ` · song: ${escapeHtml(a.songRequest)}` : ''}
            ${a.notes ? ` · notes: ${escapeHtml(a.notes)}` : ''}
          </li>
        `;
        };
        const primaryLabel = `${inv.primaryFirstName} ${inv.primaryLastName}`.trim();
        const primaryItem = renderAttendee(payload.primary || {}, primaryLabel + ' (primary)');
        const guestItems = (payload.additionalGuests || []).map((g: any) =>
          renderAttendee(g, `${g.name || '(no name)'}${g.isKid ? ' [child]' : ''}`)
        ).join('');
        const smsList = (row.recentSms || []).map((s: any) => `
          <li>
            <span class="admin-muted">${escapeHtml(new Date(s.sentAt).toLocaleString())}</span>
            — ${escapeHtml(s.type)} → <strong>${escapeHtml(s.deliveryStatus)}</strong>${s.errorCode ? ` (${escapeHtml(s.errorCode)})` : ''}
            ${s.bodyLen ? ` · ${s.bodyLen} chars` : ''}
          </li>
        `).join('') || '<li class="admin-muted">No SMS history.</li>';

        const metaBits: string[] = [];
        metaBits.push(`<code>${escapeHtml(inv.inviteId)}</code>`);
        if (inv.respondedAt) metaBits.push(`responded ${escapeHtml(new Date(inv.respondedAt).toLocaleString())}`);
        if (inv.respondedLate) metaBits.push('<span class="admin-badge admin-badge--warn">late</span>');
        if (inv.adminNotes) metaBits.push(`<em>note:</em> ${escapeHtml(inv.adminNotes)}`);

        return `
          <div class="admin-detail-inner">
            <p class="admin-muted admin-detail-meta">${metaBits.join(' · ')}</p>
            <ul class="admin-list">${primaryItem}${guestItems}</ul>
            <h4>Recent SMS</h4>
            <ul class="admin-list admin-list--small">${smsList}</ul>
          </div>
        `;
      }

      // ---- Modal ----
      function openModal(mode: 'create' | 'edit', invite?: any) {
        if (!modalEl || !modalForm || !modalTitleEl) return;
        clearModalError();
        modalForm.reset();
        modalForm.dataset.mode = mode;
        modalForm.dataset.inviteId = invite ? invite.inviteId : '';
        modalTitleEl.textContent = mode === 'create' ? 'New invitation' : `Edit invitation`;
        const get = (n: string) => modalForm.querySelector(`[name="${n}"]`) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
        if (invite) {
          (get('primaryFirstName') as HTMLInputElement).value = invite.primaryFirstName || '';
          (get('primaryLastName') as HTMLInputElement).value = invite.primaryLastName || '';
          (get('phone') as HTMLInputElement).value = invite.phone || '';
          (get('locale') as HTMLSelectElement).value = invite.locale === 'es' ? 'es' : 'en';
          (get('adminNotes') as HTMLTextAreaElement).value = invite.adminNotes || '';
          (get('optedOutOfSms') as HTMLInputElement).checked = !!invite.optedOutOfSms;
          (get('clearHardFail') as HTMLInputElement).checked = false;
          populateRsvpSection(invite.payload || { primary: {}, additionalGuests: [] });
          setPrimaryNameDisplay(`${invite.primaryFirstName || ''} ${invite.primaryLastName || ''}`.trim());
          // Stash a canonical snapshot of the saved payload so the submit
          // handler can diff it against whatever the admin built in the form.
          modalForm.dataset.payloadOriginal = canonicalize(invite.payload || {});
        } else {
          (get('locale') as HTMLSelectElement).value = 'en';
          clearRsvpSection();
          delete modalForm.dataset.payloadOriginal;
        }
        modalEl.hidden = false;
        document.body.style.overflow = 'hidden';
        (get('primaryFirstName') as HTMLInputElement).focus();
      }
      function closeModal() {
        if (!modalEl) return;
        modalEl.hidden = true;
        // Defensive: if the diff preview is open (e.g. user clicked the
        // backdrop while reviewing), tear it down so the confirm handler
        // can't fire later against a stale doSave closure.
        if (activeDiffCleanup) { activeDiffCleanup(); activeDiffCleanup = null; }
        document.body.style.overflow = '';
      }
      function showModalError(msg: string) {
        if (!modalErrorEl) return;
        modalErrorEl.textContent = msg;
        modalErrorEl.hidden = false;
      }
      function clearModalError() {
        if (!modalErrorEl) return;
        modalErrorEl.textContent = '';
        modalErrorEl.hidden = true;
      }

      modalEl?.querySelectorAll('[data-modal-close]').forEach((el) => {
        el.addEventListener('click', closeModal);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modalEl && !modalEl.hidden) closeModal();
      });

      modalForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearModalError();
        if (!modalSaveBtn) return;
        const mode = modalForm.dataset.mode || 'edit';
        const inviteId = modalForm.dataset.inviteId || '';
        const get = (n: string) => modalForm.querySelector(`[name="${n}"]`) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
        const primaryFirstName = (get('primaryFirstName') as HTMLInputElement).value.trim();
        const primaryLastName = (get('primaryLastName') as HTMLInputElement).value.trim();
        const phone = (get('phone') as HTMLInputElement).value.trim();
        const locale = (get('locale') as HTMLSelectElement).value;
        const adminNotes = (get('adminNotes') as HTMLTextAreaElement).value;
        const optedOutOfSms = (get('optedOutOfSms') as HTMLInputElement).checked;
        const clearHardFail = (get('clearHardFail') as HTMLInputElement).checked;
        if (!primaryFirstName || !primaryLastName) {
          showModalError('Both first and last name are required.');
          return;
        }
        modalSaveBtn.disabled = true;
        const saveLabel = modalSaveBtn.textContent;
        modalSaveBtn.textContent = 'Saving…';
        try {
          if (mode === 'create') {
            const res = await fetch('/api/mgmt/create-invite', {
              method: 'POST', credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ primaryFirstName, primaryLastName, phone, locale, adminNotes })
            });
            if (!res.ok) {
              const data = await res.json().catch(() => ({}));
              showModalError(`Create failed (${res.status}): ${data.error || ''}`);
              return;
            }
            closeModal();
            setStatus('Invitation created.', 'ok');
          } else {
            const patch: any = { primaryFirstName, primaryLastName, phone, locale, adminNotes, optedOutOfSms };
            if (clearHardFail) patch.smsHardFailedAt = '';

            // Pre-validate guest cards: the server requires every guest in
            // `additionalGuests` to have a non-empty name. Catch it here so
            // the admin gets a clear in-modal error before the diff preview
            // rather than a confusing "guest_name_required" after confirm.
            const blankNameCard = guestCards().find((card) => {
              if (card.dataset.existingGuest === 'true') return false;
              const nameInput = card.querySelector('input[data-field="name"]') as HTMLInputElement | null;
              if (nameInput?.value.trim()) return false;
              return attendeeHasMeaningfulData(card);
            });
            if (blankNameCard) {
              showModalError('Each additional guest needs a name. Fill it in or remove the card.');
              (blankNameCard.querySelector('input[data-field="name"]') as HTMLInputElement | null)?.focus();
              return;
            }

            // Only include payload in the patch if it actually changed vs.
            // the saved snapshot. The server treats payload edits as a
            // "may recompute responded" signal — sending the same payload
            // on a no-op nudge could flip an already-responded invite.
            const builtPayload = buildPayloadFromForm();
            const originalJson = modalForm.dataset.payloadOriginal || '';
            const builtJson = canonicalize(builtPayload);
            const payloadChanged = !!originalJson && builtJson !== originalJson;

            // Warn before changing the primary name — old session cookies
            // and magic links can no longer be invalidated, and would still
            // unlock this invitation under the new name. Recommended
            // workflow: delete + create instead of rename.
            const editingInvite = LAST_DATA?.rows.find((r: any) => r.invite.inviteId === inviteId)?.invite;
            if (editingInvite && (editingInvite.primaryFirstName !== primaryFirstName || editingInvite.primaryLastName !== primaryLastName)) {
              if (!confirm(`You're renaming the primary invitee.\n\nFROM: ${editingInvite.primaryFirstName} ${editingInvite.primaryLastName}\nTO:   ${primaryFirstName} ${primaryLastName}\n\nAny existing session cookie or magic link for this invitation will continue to work and would let the previous primary open the new person's RSVP. If this is a re-assignment to a different real person, click Cancel and use Delete + New invitation instead.\n\nContinue with the rename?`)) {
                return;
              }
            }

            const doSave = async () => {
              if (payloadChanged) patch.payload = builtPayload;
              modalSaveBtn.disabled = true;
              modalSaveBtn.textContent = 'Saving…';
              try {
                const res = await fetch('/api/mgmt/update-invite', {
                  method: 'POST', credentials: 'same-origin',
                  headers: { 'Content-Type': 'application/json' },
                  body: JSON.stringify({ inviteId, patch })
                });
                if (!res.ok) {
                  const data = await res.json().catch(() => ({}));
                  showModalError(`Update failed (${res.status}): ${data.error || ''}${data.detail ? ' · ' + data.detail : ''}`);
                  return;
                }
                closeModal();
                setStatus('Invitation updated.', 'ok');
                await loadGuests();
              } catch (err: any) {
                showModalError(`Request failed: ${err && err.message}`);
              } finally {
                modalSaveBtn.disabled = false;
                if (saveLabel) modalSaveBtn.textContent = saveLabel;
              }
            };

            if (payloadChanged) {
              const originalPayload = JSON.parse(originalJson || '{}');
              const primaryName = `${primaryFirstName} ${primaryLastName}`.trim();
              const diffEntries = computeDiff(originalPayload, builtPayload, primaryName);
              if (diffEntries.length === 0) {
                // Canonical form differs but no human-visible changes
                // (e.g. blank-field normalization). Skip the preview.
                await doSave();
              } else {
                showDiffModal(diffEntries, doSave);
              }
              return; // doSave handles save-button state itself
            }
            await doSave();
            return;
          }
          await loadGuests();
        } catch (err: any) {
          showModalError(`Request failed: ${err && err.message}`);
        } finally {
          modalSaveBtn.disabled = false;
          if (saveLabel) modalSaveBtn.textContent = saveLabel;
        }
      });

      async function onActionClick(ev: Event) {
        const btn = ev.currentTarget as HTMLButtonElement;
        const action = btn.dataset.action || '';
        const inviteId = btn.dataset.inviteId || '';
        const inviteRow = LAST_DATA?.rows.find((r: any) => r.invite.inviteId === inviteId);
        const invite = inviteRow ? inviteRow.invite : null;
        if (action === 'edit') {
          if (invite) openModal('edit', invite);
          return;
        }
        if (action === 'delete') {
          const name = invite ? `${invite.primaryFirstName} ${invite.primaryLastName}`.trim() : inviteId;
          if (!confirm(`Permanently delete the invitation for "${name}"? This also deletes the SMS log for this invite.`)) return;
          const original = btn.textContent;
          btn.disabled = true; btn.textContent = '…';
          try {
            const res = await fetch('/api/mgmt/delete-invite', {
              method: 'POST', credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ inviteId })
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) { setStatus(`Delete failed (${res.status}): ${data.error || ''}`, 'warn'); }
            else { setStatus(`Deleted (${data.smsRowsDeleted || 0} SMS rows removed).`, 'ok'); }
          } catch (e: any) {
            setStatus(`Delete failed: ${e && e.message}`, 'warn');
          } finally {
            btn.disabled = false; btn.textContent = original;
            await loadGuests();
          }
          return;
        }
        if (action === 'send-reminder') {
          if (!confirm('Send an SMS reminder to this invite now (bypasses 30-day cadence)?')) return;
          const original = btn.textContent;
          btn.disabled = true; btn.textContent = '…';
          try {
            const res = await fetch('/api/mgmt/send-reminder', {
              method: 'POST', credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ inviteId, force: true })
            });
            const data = await res.json().catch(() => ({}));
            if (res.ok && data.sent) {
              setStatus(`Sent (${data.segmentCount || '?'} segments, ${data.bodyLen || '?'} chars).`, 'ok');
            } else {
              const reason = (data && (data.reason || data.skipped || data.errorCode)) || `HTTP ${res.status}`;
              setStatus(`Skipped: ${reason}`, 'warn');
            }
          } catch (e: any) {
            setStatus(`Send failed: ${e && e.message}`, 'warn');
          } finally {
            btn.disabled = false; btn.textContent = original;
            await loadGuests();
          }
        }
      }

      document.getElementById('btn-refresh')?.addEventListener('click', async (ev) => {
        const btn = ev.currentTarget as HTMLButtonElement;
        const orig = btn.textContent || 'Refresh';
        btn.disabled = true;
        btn.textContent = 'Refreshing…';
        await Promise.all([loadGuests(), loadEvents()]);
        btn.textContent = '✓ Updated';
        window.setTimeout(() => {
          if (btn.textContent === '✓ Updated') {
            btn.textContent = orig;
            btn.disabled = false;
          }
        }, 1200);
      });
      document.getElementById('btn-create-invite')?.addEventListener('click', () => openModal('create'));

      exportBtn?.addEventListener('click', () => {
        if (!LAST_DATA) return;
        try {
          const csv = buildSummaryCsv(LAST_DATA);
          const today = new Date().toISOString().slice(0, 10);
          downloadCsv(`rsvp-summary-${today}.csv`, csv);
          setStatus('Summary CSV downloaded.', 'ok');
        } catch (e: any) {
          setStatus(`Export failed: ${e && e.message}`, 'warn');
        }
      });

      const sendTestBtn = document.getElementById('btn-send-test');
      sendTestBtn?.addEventListener('click', async () => {
        const phone = window.prompt('Phone number to text (E.164 or 10 digits US):');
        if (!phone) return;
        const locale = window.prompt('Locale? "en" or "es" (default en):', 'en') || 'en';
        try {
          const res = await fetch('/api/mgmt/send-test', {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ phone, locale })
          });
          const data = await res.json();
          if (data.successful) {
            setStatus(`Test SMS sent (id=${data.messageId}, ${data.segmentCount} seg, ${data.bodyLen} chars).`, 'ok');
          } else {
            setStatus(`Test SMS failed: ${data.errorCode || data.error || 'unknown'} ${data.errorMessage || ''}`, 'warn');
          }
        } catch (e: any) {
          setStatus(`Test SMS failed: ${e && e.message}`, 'warn');
        }
      });

      if (remindersChk) {
        remindersChk.addEventListener('change', async () => {
          const next = remindersChk.checked;
          remindersChk.disabled = true;
          try {
            const res = await fetch('/api/mgmt/toggle-reminders', {
              method: 'POST', credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ enabled: next })
            });
            if (!res.ok) {
              setStatus(`Toggle failed (HTTP ${res.status})`, 'warn');
              remindersChk.checked = !next;
            } else {
              setStatus(next ? 'Reminders enabled.' : 'Reminders disabled.', 'ok');
            }
          } catch (e: any) {
            setStatus(`Toggle failed: ${e && e.message}`, 'warn');
            remindersChk.checked = !next;
          } finally {
            remindersChk.disabled = false;
          }
        });
      }

      (async () => {
        const ok = await ensureAuthed();
        if (!ok) return;
        await Promise.all([loadGuests(), loadEvents()]);
      })();

      // Filter wiring for the Recent activity panel. These listeners drive
      // a pure client-side filter over LAST_EVENTS — no network calls.
      const eventsSearch = document.getElementById('events-search') as HTMLInputElement | null;
      eventsSearch?.addEventListener('input', () => renderEvents());
      document.querySelectorAll<HTMLInputElement>('.admin-events-cats input[type="checkbox"][data-cat]')
        .forEach((cb) => cb.addEventListener('change', () => renderEvents()));
      const eventsReset = document.getElementById('events-reset') as HTMLButtonElement | null;
      eventsReset?.addEventListener('click', () => {
        if (eventsSearch) eventsSearch.value = '';
        document.querySelectorAll<HTMLInputElement>('.admin-events-cats input[type="checkbox"][data-cat]')
          .forEach((cb) => { cb.checked = true; });
        renderEvents();
      });

      // -----------------------------------------------------------------
      // Bulk import (CSV → bulk-upsert-invites)
      //
      // Two-step flow so the admin sees real backend decisions before any
      // writes: pick file → local parse + table → "Preview against server"
      // (dryRun:true) fills in the action column → "Apply changes" commits.
      // Existing RSVP responses are preserved server-side: matched rows get
      // ONLY phone/locale patched, payload/responded/etc. are untouched.
      // -----------------------------------------------------------------

      type BulkParsedRow = {
        rowNum: number;
        primaryFirstName: string;
        primaryLastName: string;
        phone: string;
        locale: string;
        localError: string;
      };
      type BulkServerResult = {
        row: number;
        action: 'create' | 'update' | 'skip' | 'error';
        inviteId?: string;
        existingResponded?: boolean;
        reason?: string;
      };

      function parseCsv(text: string): string[][] {
        if (text.charCodeAt(0) === 0xFEFF) text = text.slice(1);
        const rows: string[][] = [];
        let row: string[] = [];
        let field = '';
        let inQuotes = false;
        for (let i = 0; i < text.length; i++) {
          const c = text[i];
          if (inQuotes) {
            if (c === '"') {
              if (text[i + 1] === '"') { field += '"'; i++; }
              else { inQuotes = false; }
            } else {
              field += c;
            }
          } else if (c === '"') {
            inQuotes = true;
          } else if (c === ',') {
            row.push(field); field = '';
          } else if (c === '\n') {
            row.push(field); field = '';
            rows.push(row); row = [];
          } else if (c === '\r') {
            // CRLF handled by the next \n
          } else {
            field += c;
          }
        }
        if (field.length || row.length) { row.push(field); rows.push(row); }
        while (rows.length && rows[rows.length - 1].every((c) => c === '')) rows.pop();
        return rows;
      }

      const BULK_HEADER_ALIASES: Record<string, string[]> = {
        firstName: ['first', 'first name', 'firstname', 'given', 'given name'],
        lastName:  ['last', 'last name', 'lastname', 'surname', 'family name', 'family'],
        phone:     ['phone', 'phone number', 'mobile', 'cell', 'tel', 'telephone', 'number'],
        locale:    ['locale', 'language', 'lang']
      };

      function detectColumns(headerRow: string[]) {
        const map: Record<string, number> = { firstName: -1, lastName: -1, phone: -1, locale: -1 };
        let hits = 0;
        for (let i = 0; i < headerRow.length; i++) {
          const h = (headerRow[i] || '').trim().toLowerCase();
          for (const field of Object.keys(BULK_HEADER_ALIASES)) {
            if (map[field] === -1 && BULK_HEADER_ALIASES[field].indexOf(h) !== -1) {
              map[field] = i; hits++; break;
            }
          }
        }
        return { map, hits };
      }

      function rowsFromCsv(rawRows: string[][]): BulkParsedRow[] {
        if (rawRows.length === 0) return [];
        const { map, hits } = detectColumns(rawRows[0]);
        // Need at least 2 recognized headers to trust a header row.
        // Otherwise treat row 1 as data and use positional columns.
        const useHeader = hits >= 2;
        const dataRows = useHeader ? rawRows.slice(1) : rawRows;
        const cols = useHeader ? map : { firstName: 0, lastName: 1, phone: 2, locale: 3 };
        const out: BulkParsedRow[] = [];
        let i = useHeader ? 2 : 1; // human-facing row numbers match the CSV
        for (const r of dataRows) {
          const cell = (idx: number) => (idx < 0 || idx >= r.length ? '' : (r[idx] || '').trim());
          const primaryFirstName = cell(cols.firstName);
          const primaryLastName = cell(cols.lastName);
          const phone = cell(cols.phone);
          const locale = cell(cols.locale);
          if (!primaryFirstName && !primaryLastName && !phone && !locale) { i++; continue; }
          let localError = '';
          if (!primaryFirstName || !primaryLastName) localError = 'missing first or last name';
          out.push({ rowNum: i, primaryFirstName, primaryLastName, phone, locale, localError });
          i++;
        }
        return out;
      }

      function escapeHtml(s: string): string {
        return String(s)
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      let BULK_ROWS: BulkParsedRow[] = [];
      let BULK_SERVER_RESULTS: BulkServerResult[] = [];

      const bulkFile = document.getElementById('bulk-file') as HTMLInputElement | null;
      const bulkPreviewBtn = document.getElementById('bulk-preview-btn') as HTMLButtonElement | null;
      const bulkApplyBtn = document.getElementById('bulk-apply-btn') as HTMLButtonElement | null;
      const bulkClearBtn = document.getElementById('bulk-clear-btn') as HTMLButtonElement | null;
      const bulkStatusEl = document.getElementById('bulk-status') as HTMLDivElement | null;
      const bulkPreviewWrap = document.getElementById('bulk-preview-wrap') as HTMLDivElement | null;
      const bulkSummary = document.getElementById('bulk-summary') as HTMLDivElement | null;
      const bulkTbody = document.getElementById('bulk-preview-tbody') as HTMLTableSectionElement | null;

      function setBulkStatus(msg: string, tone: 'ok' | 'warn' | '' = '') {
        if (!bulkStatusEl) return;
        bulkStatusEl.textContent = msg;
        bulkStatusEl.dataset.tone = tone;
      }

      function renderBulkPreview() {
        if (!bulkTbody || !bulkSummary || !bulkPreviewWrap) return;
        bulkTbody.innerHTML = '';
        if (BULK_ROWS.length === 0) {
          bulkPreviewWrap.hidden = true;
          return;
        }
        bulkPreviewWrap.hidden = false;

        // Server results carry 'row' = position within the server payload (1-based,
        // skipping locally-invalid rows). Build a map back to BULK_ROWS' rowNum so
        // we can show the server's action on the right CSV row.
        const validRows = BULK_ROWS.filter((r) => !r.localError);
        const byOriginalRow: Record<number, BulkServerResult> = {};
        for (let k = 0; k < BULK_SERVER_RESULTS.length; k++) {
          const sr = BULK_SERVER_RESULTS[k];
          const target = validRows[sr.row - 1];
          if (target) byOriginalRow[target.rowNum] = sr;
        }

        let willCreate = 0, willUpdate = 0, willSkip = 0, willError = 0;

        for (const r of BULK_ROWS) {
          const tr = document.createElement('tr');
          const sr = byOriginalRow[r.rowNum];
          let actionHtml = '<span class="bulk-action bulk-action--pending">— ready —</span>';
          if (r.localError) {
            actionHtml = `<span class="bulk-action bulk-action--error">✗ ${escapeHtml(r.localError)}</span>`;
            willError++;
          } else if (sr) {
            const reason = sr.reason ? ` (${escapeHtml(sr.reason)})` : '';
            if (sr.action === 'create') {
              actionHtml = '<span class="bulk-action bulk-action--create">＋ Create new invitation</span>';
              willCreate++;
            } else if (sr.action === 'update') {
              const presv = sr.existingResponded
                ? ' <em class="bulk-rsvp-note">existing RSVP preserved</em>'
                : '';
              actionHtml = `<span class="bulk-action bulk-action--update">↻ Update existing</span>${presv}`;
              willUpdate++;
            } else if (sr.action === 'skip') {
              actionHtml = `<span class="bulk-action bulk-action--skip">⊘ Skip${reason}</span>`;
              willSkip++;
            } else {
              actionHtml = `<span class="bulk-action bulk-action--error">✗ Error${reason}</span>`;
              willError++;
            }
          }
          tr.innerHTML =
            `<td>${r.rowNum}</td>` +
            `<td>${escapeHtml(r.primaryFirstName)}</td>` +
            `<td>${escapeHtml(r.primaryLastName)}</td>` +
            `<td>${escapeHtml(r.phone)}</td>` +
            `<td>${escapeHtml(r.locale)}</td>` +
            `<td>${actionHtml}</td>`;
          bulkTbody.appendChild(tr);
        }

        if (BULK_SERVER_RESULTS.length === 0) {
          bulkSummary.textContent =
            `${BULK_ROWS.length} row${BULK_ROWS.length === 1 ? '' : 's'} parsed. ` +
            `Click "Preview against server" to see create/update decisions.`;
          if (bulkApplyBtn) { bulkApplyBtn.disabled = true; bulkApplyBtn.textContent = 'Apply changes'; }
        } else {
          bulkSummary.innerHTML =
            `<span class="bulk-stat bulk-stat--create">${willCreate} create</span>` +
            `<span class="bulk-stat bulk-stat--update">${willUpdate} update</span>` +
            `<span class="bulk-stat bulk-stat--skip">${willSkip} skip</span>` +
            (willError ? `<span class="bulk-stat bulk-stat--error">${willError} error</span>` : '');
          const actionable = willCreate + willUpdate;
          if (bulkApplyBtn) {
            bulkApplyBtn.disabled = actionable === 0;
            bulkApplyBtn.textContent = actionable > 0
              ? `Apply ${actionable} change${actionable === 1 ? '' : 's'}`
              : 'Apply changes';
          }
        }
      }

      function resetBulkState() {
        BULK_ROWS = [];
        BULK_SERVER_RESULTS = [];
        if (bulkFile) bulkFile.value = '';
        if (bulkPreviewBtn) bulkPreviewBtn.disabled = true;
        if (bulkApplyBtn) { bulkApplyBtn.disabled = true; bulkApplyBtn.textContent = 'Apply changes'; }
        if (bulkClearBtn) bulkClearBtn.hidden = true;
        setBulkStatus('', '');
        renderBulkPreview();
      }

      function buildBulkPayload(dryRun: boolean) {
        return {
          dryRun,
          rows: BULK_ROWS.filter((r) => !r.localError).map((r) => ({
            primaryFirstName: r.primaryFirstName,
            primaryLastName: r.primaryLastName,
            phone: r.phone,
            locale: r.locale,
          })),
        };
      }

      bulkFile?.addEventListener('change', async () => {
        BULK_SERVER_RESULTS = [];
        const file = bulkFile.files && bulkFile.files[0];
        if (!file) { resetBulkState(); return; }
        try {
          const text = await file.text();
          const parsed = parseCsv(text);
          BULK_ROWS = rowsFromCsv(parsed);
          if (BULK_ROWS.length === 0) {
            setBulkStatus('CSV had no data rows.', 'warn');
            if (bulkPreviewBtn) bulkPreviewBtn.disabled = true;
            if (bulkClearBtn) bulkClearBtn.hidden = false;
            renderBulkPreview();
            return;
          }
          setBulkStatus(
            `Parsed ${BULK_ROWS.length} row${BULK_ROWS.length === 1 ? '' : 's'} from ${file.name}.`,
            'ok'
          );
          if (bulkPreviewBtn) bulkPreviewBtn.disabled = false;
          if (bulkApplyBtn) { bulkApplyBtn.disabled = true; bulkApplyBtn.textContent = 'Apply changes'; }
          if (bulkClearBtn) bulkClearBtn.hidden = false;
          renderBulkPreview();
        } catch (err: any) {
          setBulkStatus(`Could not read CSV: ${err && err.message}`, 'warn');
        }
      });

      bulkPreviewBtn?.addEventListener('click', async () => {
        if (BULK_ROWS.length === 0) return;
        bulkPreviewBtn.disabled = true;
        if (bulkApplyBtn) bulkApplyBtn.disabled = true;
        setBulkStatus('Running dry-run preview…', '');
        try {
          const payload = buildBulkPayload(true);
          if (payload.rows.length === 0) {
            setBulkStatus('No valid rows to preview (all rows missing a name).', 'warn');
            bulkPreviewBtn.disabled = false;
            return;
          }
          const res = await fetch('/api/mgmt/bulk-upsert-invites', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });
          const data = await res.json();
          if (!res.ok) {
            setBulkStatus(
              `Preview failed (${res.status}): ${data.error || ''} ${data.message || ''}`.trim(),
              'warn'
            );
            bulkPreviewBtn.disabled = false;
            return;
          }
          BULK_SERVER_RESULTS = data.results || [];
          setBulkStatus(
            `Preview ready: ${data.summary.created} new, ${data.summary.updated} updates, ` +
              `${data.summary.skipped} skipped, ${data.summary.errors} errors.`,
            'ok'
          );
          bulkPreviewBtn.disabled = false;
          renderBulkPreview();
        } catch (err: any) {
          setBulkStatus(`Preview failed: ${err && err.message}`, 'warn');
          bulkPreviewBtn.disabled = false;
        }
      });

      bulkApplyBtn?.addEventListener('click', async () => {
        if (BULK_ROWS.length === 0 || BULK_SERVER_RESULTS.length === 0) return;
        const willChange = BULK_SERVER_RESULTS.filter(
          (r) => r.action === 'create' || r.action === 'update'
        ).length;
        if (willChange === 0) return;
        if (!confirm(
          `Apply ${willChange} change${willChange === 1 ? '' : 's'} to the invitations table?\n\n` +
            `Existing RSVP responses will be preserved.`
        )) return;
        bulkApplyBtn.disabled = true;
        if (bulkPreviewBtn) bulkPreviewBtn.disabled = true;
        setBulkStatus('Applying changes…', '');
        try {
          const res = await fetch('/api/mgmt/bulk-upsert-invites', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(buildBulkPayload(false)),
          });
          const data = await res.json();
          if (!res.ok) {
            setBulkStatus(
              `Apply failed (${res.status}): ${data.error || ''} ${data.message || ''}`.trim(),
              'warn'
            );
            bulkApplyBtn.disabled = false;
            if (bulkPreviewBtn) bulkPreviewBtn.disabled = false;
            return;
          }
          BULK_SERVER_RESULTS = data.results || [];
          setBulkStatus(
            `Done: ${data.summary.created} created, ${data.summary.updated} updated, ` +
              `${data.summary.skipped} skipped, ${data.summary.errors} errors.`,
            'ok'
          );
          renderBulkPreview();
          // Refresh the main tables so the new/updated rows are visible.
          await loadGuests();
          await loadEvents();
          if (bulkApplyBtn) {
            // After a successful apply the dry-run results no longer reflect server
            // state — re-previewing or clearing is the next sensible action.
            bulkApplyBtn.disabled = true;
            bulkApplyBtn.textContent = 'Apply changes';
          }
          if (bulkPreviewBtn) bulkPreviewBtn.disabled = false;
        } catch (err: any) {
          setBulkStatus(`Apply failed: ${err && err.message}`, 'warn');
          bulkApplyBtn.disabled = false;
          if (bulkPreviewBtn) bulkPreviewBtn.disabled = false;
        }
      });

      bulkClearBtn?.addEventListener('click', () => resetBulkState());
    })();
  </script>

