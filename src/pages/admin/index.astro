---
import Base from '../../layouts/Base.astro';
const locale = 'en';
---

<Base title="RSVP Admin · John & Diana" description="RSVP administration dashboard" lang={locale}>
  <main class="admin">
    <section class="container">
      <header class="admin-header">
        <h1>RSVP Admin</h1>
        <div class="admin-user">
          <span id="admin-user-label">…</span>
          <a href="/.auth/logout?post_logout_redirect_uri=/" class="rsvp-link">Log out</a>
        </div>
      </header>

      <div id="admin-error" class="admin-error" role="alert" hidden></div>

      <section class="admin-card admin-controls">
        <h2>Reminders</h2>
        <div class="admin-row">
          <label class="admin-toggle">
            <input type="checkbox" id="reminders-enabled" />
            <span>Monthly reminder texts enabled</span>
          </label>
          <span id="reminders-stop" class="admin-muted"></span>
        </div>
        <div class="admin-row admin-row--actions">
          <button id="btn-send-test" class="btn btn--ghost">Send test SMS</button>
          <span class="admin-muted">Sends a test message to a phone you specify. Useful to verify ACS provisioning.</span>
        </div>
        <div id="settings-status" class="admin-status"></div>
      </section>

      <section class="admin-card">
        <h2>Overall</h2>
        <div id="admin-overall" class="admin-stats">…</div>
      </section>

      <section class="admin-card">
        <div class="admin-card-header">
          <h2>Invitations</h2>
          <div class="admin-card-actions">
            <button id="btn-create-invite" class="btn btn--gold btn--small">+ New invitation</button>
            <button id="btn-refresh" class="btn btn--ghost btn--small">Refresh</button>
          </div>
        </div>
        <div class="admin-table-wrap">
          <table id="admin-table" class="admin-table">
            <thead>
              <tr>
                <th>Primary invitee</th>
                <th>Responded</th>
                <th>Headcount</th>
                <th>Phone · Locale</th>
                <th>Last reminder</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="admin-tbody">
              <tr><td colspan="6" class="admin-loading">Loading…</td></tr>
            </tbody>
          </table>
        </div>
      </section>

      <section class="admin-card">
        <div class="admin-card-header">
          <h2>Recent activity</h2>
          <span id="events-count" class="admin-muted"></span>
        </div>
        <div class="admin-events-wrap">
          <ul id="admin-events" class="admin-events">
            <li class="admin-events-empty">Loading…</li>
          </ul>
        </div>
      </section>

    </section>
  </main>

  <!-- Edit / create modal -->
  <div id="admin-modal" class="admin-modal" hidden>
    <div class="admin-modal-backdrop" data-modal-close></div>
    <div class="admin-modal-panel" role="dialog" aria-modal="true" aria-labelledby="admin-modal-title">
      <header class="admin-modal-header">
        <h3 id="admin-modal-title">Invitation</h3>
        <button type="button" class="admin-modal-close" data-modal-close aria-label="Close">×</button>
      </header>
      <form id="admin-modal-form" class="admin-modal-body" novalidate>
        <div class="admin-form-row admin-form-row--two">
          <label>
            <span class="admin-label">First name</span>
            <input type="text" name="primaryFirstName" maxlength="80" required />
          </label>
          <label>
            <span class="admin-label">Last name</span>
            <input type="text" name="primaryLastName" maxlength="80" required />
          </label>
        </div>
        <div class="admin-form-row admin-form-row--two">
          <label>
            <span class="admin-label">Phone (E.164 or 10-digit US)</span>
            <input type="text" name="phone" maxlength="32" />
          </label>
          <label>
            <span class="admin-label">Locale</span>
            <select name="locale">
              <option value="en">English (en)</option>
              <option value="es">Español (es)</option>
            </select>
          </label>
        </div>
        <label class="admin-form-row">
          <span class="admin-label">Admin notes (internal)</span>
          <textarea name="adminNotes" maxlength="500" rows="2"></textarea>
        </label>
        <fieldset class="admin-form-row admin-form-row--checks">
          <label class="admin-inline"><input type="checkbox" name="optedOutOfSms" /> <span>Opted out of SMS</span></label>
          <label class="admin-inline"><input type="checkbox" name="clearHardFail" /> <span>Clear SMS hard-fail flag</span></label>
        </fieldset>
        <label class="admin-form-row" id="admin-payload-row" hidden>
          <span class="admin-label">RSVP payload (JSON) — leave alone unless you know what you're doing</span>
          <textarea name="payload" rows="10" class="admin-payload-json"></textarea>
          <small class="admin-muted">Must validate against schemaVersion=1. Saving partial state (attending: null) is allowed.</small>
        </label>
        <div id="admin-modal-error" class="admin-error" role="alert" hidden></div>
        <div class="admin-modal-actions">
          <button type="button" class="btn btn--ghost" data-modal-close>Cancel</button>
          <button type="submit" class="btn btn--gold" id="admin-modal-save">Save</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    (() => {
      const errorEl = document.getElementById('admin-error') as HTMLDivElement | null;
      const userLabel = document.getElementById('admin-user-label') as HTMLSpanElement | null;
      const remindersChk = document.getElementById('reminders-enabled') as HTMLInputElement | null;
      const settingsStatus = document.getElementById('settings-status') as HTMLDivElement | null;
      const overallEl = document.getElementById('admin-overall') as HTMLDivElement | null;
      const tbody = document.getElementById('admin-tbody') as HTMLTableSectionElement | null;
      const remindersStopEl = document.getElementById('reminders-stop') as HTMLSpanElement | null;
      const modalEl = document.getElementById('admin-modal') as HTMLDivElement | null;
      const modalTitleEl = document.getElementById('admin-modal-title') as HTMLHeadingElement | null;
      const modalForm = document.getElementById('admin-modal-form') as HTMLFormElement | null;
      const modalErrorEl = document.getElementById('admin-modal-error') as HTMLDivElement | null;
      const modalSaveBtn = document.getElementById('admin-modal-save') as HTMLButtonElement | null;
      const payloadRow = document.getElementById('admin-payload-row') as HTMLLabelElement | null;

      function showError(msg: string) {
        if (!errorEl) return;
        errorEl.textContent = msg;
        errorEl.hidden = false;
      }
      function clearError() {
        if (!errorEl) return;
        errorEl.textContent = '';
        errorEl.hidden = true;
      }
      function setStatus(msg: string, tone: 'ok' | 'warn' | '' = '') {
        if (!settingsStatus) return;
        settingsStatus.textContent = msg;
        settingsStatus.dataset.tone = tone;
        if (msg) {
          window.setTimeout(() => {
            if (settingsStatus.textContent === msg) {
              settingsStatus.textContent = '';
              settingsStatus.dataset.tone = '';
            }
          }, 4500);
        }
      }

      let LAST_DATA: any = null;
      let EXPANDED_ID: string | null = null;

      function loginRedirect() {
        const target = location.pathname + location.search;
        location.href = '/.auth/login/github?post_login_redirect_uri=' + encodeURIComponent(target);
      }

      async function ensureAuthed(): Promise<boolean> {
        try {
          const res = await fetch('/.auth/me', { credentials: 'same-origin' });
          if (!res.ok) { loginRedirect(); return false; }
          const data = await res.json();
          const principal = data && data.clientPrincipal;
          if (!principal) { loginRedirect(); return false; }
          if (userLabel) userLabel.textContent = `${principal.userDetails || principal.userId} (${principal.identityProvider})`;
          return true;
        } catch {
          showError('Could not contact /.auth/me. Try reloading.');
          return false;
        }
      }

      async function loadGuests() {
        clearError();
        try {
          // cache: 'no-store' + cache-busting query param so the
          // Refresh button always hits the API. Without these, some
          // browsers will replay a stale cached fetch response even
          // though the server sets Cache-Control: no-store.
          const res = await fetch(`/api/mgmt/guests?_=${Date.now()}`, {
            credentials: 'same-origin',
            cache: 'no-store',
            headers: { 'Cache-Control': 'no-cache' },
          });
          if (res.status === 401) { showError('Session expired. Redirecting to login…'); loginRedirect(); return; }
          if (res.status === 403) { showError('Your account is signed in but is not authorized. Only the configured admin GitHub user can use this page.'); return; }
          if (!res.ok) { showError(`Couldn't load invites (HTTP ${res.status}).`); return; }
          const data = await res.json();
          LAST_DATA = data;
          render(data);
        } catch (e: any) {
          showError(`Couldn't load invites: ${e && e.message}`);
        }
      }

      // --- Recent activity panel -----------------------------------------
      // Builds DOM via createElement + textContent only. Event fields can
      // contain user-provided strings (invitee names, commit messages, even
      // forged values if a secret leaks), so we MUST NOT interpolate them
      // into innerHTML.

      function badgeKind(type: string): string {
        if (type.startsWith('rsvp.')) return 'rsvp';
        if (type.startsWith('admin.')) return 'admin';
        if (type.startsWith('deploy.')) return 'deploy';
        if (type.startsWith('backup.')) return 'backup';
        if (type.startsWith('cron.')) return 'cron';
        if (type.startsWith('sms.')) return 'sms';
        return 'other';
      }

      function relativeTime(d: Date): string {
        const ms = Date.now() - d.getTime();
        if (!isFinite(ms)) return '';
        if (ms < 0) return 'just now';
        const s = Math.round(ms / 1000);
        if (s < 60) return `${s}s ago`;
        const m = Math.round(s / 60);
        if (m < 60) return `${m}m ago`;
        const h = Math.round(m / 60);
        if (h < 24) return `${h}h ago`;
        const dys = Math.round(h / 24);
        if (dys < 30) return `${dys}d ago`;
        return d.toLocaleDateString();
      }

      function renderEvent(ev: any): HTMLLIElement {
        const li = document.createElement('li');
        li.className = 'admin-event';

        const time = document.createElement('time');
        time.className = 'admin-event-time';
        const d = new Date(ev.createdAt);
        if (isFinite(d.getTime())) {
          time.dateTime = ev.createdAt;
          time.title = d.toLocaleString();
          time.textContent = relativeTime(d);
        } else {
          time.textContent = String(ev.createdAt || '');
        }
        li.appendChild(time);

        const badge = document.createElement('span');
        const type = String(ev.type || '');
        badge.className = `admin-event-badge admin-event-badge--${badgeKind(type)}`;
        badge.textContent = type;
        li.appendChild(badge);

        const actor = document.createElement('span');
        actor.className = 'admin-event-actor';
        actor.textContent = String(ev.actor || '');
        li.appendChild(actor);

        const summary = document.createElement('span');
        summary.className = 'admin-event-summary';
        summary.textContent = String(ev.summary || '');
        li.appendChild(summary);

        return li;
      }

      async function loadEvents() {
        const listEl = document.getElementById('admin-events') as HTMLUListElement | null;
        const countEl = document.getElementById('events-count') as HTMLSpanElement | null;
        if (!listEl) return;
        try {
          const res = await fetch(`/api/mgmt/events?_=${Date.now()}`, {
            credentials: 'same-origin',
            cache: 'no-store',
            headers: { 'Cache-Control': 'no-cache' },
          });
          if (!res.ok) {
            listEl.replaceChildren();
            const li = document.createElement('li');
            li.className = 'admin-events-empty';
            li.textContent = `Could not load events (HTTP ${res.status})`;
            listEl.appendChild(li);
            if (countEl) countEl.textContent = '';
            return;
          }
          const data = await res.json();
          const events = Array.isArray(data.events) ? data.events : [];
          if (countEl) countEl.textContent = events.length ? `${events.length} events` : '';
          listEl.replaceChildren();
          if (events.length === 0) {
            const li = document.createElement('li');
            li.className = 'admin-events-empty';
            li.textContent = 'No activity yet.';
            listEl.appendChild(li);
            return;
          }
          for (const ev of events) {
            listEl.appendChild(renderEvent(ev));
          }
        } catch (e: any) {
          listEl.replaceChildren();
          const li = document.createElement('li');
          li.className = 'admin-events-empty';
          li.textContent = `Load failed: ${e && e.message}`;
          listEl.appendChild(li);
          if (countEl) countEl.textContent = '';
        }
      }

      function escapeHtml(s: any): string {
        return String(s == null ? '' : s).replace(/[&<>"']/g, (c) => ({ '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c] as string));
      }

      function render(data: any) {
        if (remindersChk) remindersChk.checked = !!(data.settings && data.settings.remindersEnabled);
        if (remindersStopEl && data.settings && data.settings.remindersStopOnUtc) {
          const stop = new Date(data.settings.remindersStopOnUtc);
          remindersStopEl.textContent = `Hard stop: ${isFinite(stop.getTime()) ? stop.toLocaleDateString() : data.settings.remindersStopOnUtc}`;
        }
        if (overallEl && data.overall) {
          const o = data.overall;
          overallEl.innerHTML = `
            <div><strong>${o.inviteCount}</strong> invitations</div>
            <div><strong>${o.respondedCount}</strong> responded · <strong>${o.pendingCount}</strong> pending</div>
            <div><strong>${o.totalYes}</strong> yes / <strong>${o.totalNo}</strong> no / <strong>${o.totalPending}</strong> ?</div>
            <div><strong>${o.totalAdults}</strong> adults · <strong>${o.totalKids}</strong> kids</div>
            <div><strong>${o.withPhone}</strong> with phone · <strong>${o.optedOutCount}</strong> opted out · <strong>${o.hardFailedCount}</strong> hard-fail</div>
          `;
        }
        if (!tbody) return;
        if (!data.rows || data.rows.length === 0) {
          tbody.innerHTML = '<tr><td colspan="6" class="admin-muted">No invitations yet. Create one with the button above, or run the seed script.</td></tr>';
          EXPANDED_ID = null;
          return;
        }
        tbody.innerHTML = data.rows.map(renderRow).join('');
        // Drop stale expanded id if the invite is gone (e.g., after delete).
        if (EXPANDED_ID && !data.rows.some((r: any) => r.invite.inviteId === EXPANDED_ID)) {
          EXPANDED_ID = null;
        }
        tbody.querySelectorAll('button[data-action]').forEach((btn) => {
          btn.addEventListener('click', onActionClick);
        });
        tbody.querySelectorAll('tr.admin-data-row').forEach((tr) => {
          tr.addEventListener('click', (ev) => {
            if ((ev.target as HTMLElement).closest('button')) return;
            toggleRow((tr as HTMLTableRowElement).dataset.inviteId || '');
          });
        });
      }

      function renderRow(row: any): string {
        const inv = row.invite;
        const s = row.summary;
        const phoneCell = inv.phone ? escapeHtml(inv.phone) : '<span class="admin-muted">—</span>';
        const optBadge = inv.optedOutOfSms ? ' <span class="admin-badge admin-badge--warn">opted out</span>' : '';
        const hardBadge = inv.smsHardFailedAt ? ' <span class="admin-badge admin-badge--warn">hard-fail</span>' : '';
        const respondedBadge = inv.responded ? '<span class="admin-badge admin-badge--ok">yes</span>' : '<span class="admin-muted">—</span>';
        const lastReminder = inv.lastReminderSentAt
          ? `${escapeHtml(new Date(inv.lastReminderSentAt).toLocaleDateString())} (#${inv.reminderCount || 0})`
          : '<span class="admin-muted">—</span>';
        const headcountBits: string[] = [];
        if (s.yes) headcountBits.push(`<strong>${s.yes}</strong> yes`);
        if (s.no) headcountBits.push(`${s.no} no`);
        if (s.pending) headcountBits.push(`<span class="admin-muted">${s.pending} ?</span>`);
        if (s.kids) headcountBits.push(`<span class="admin-muted">(${s.kids} kid${s.kids === 1 ? '' : 's'})</span>`);
        const headcount = headcountBits.length ? headcountBits.join(' · ') : '<span class="admin-muted">—</span>';
        const idLabel = `${inv.primaryFirstName} ${inv.primaryLastName}`.trim() || inv.inviteId;
        const totalOnInvite = (s.yes || 0) + (s.no || 0) + (s.pending || 0);
        const totalCard = totalOnInvite > 1 ? ` <span class="admin-muted">(${totalOnInvite} on this invite)</span>` : '';
        const sendBtn = inv.phoneNorm
          ? `<button class="btn btn--ghost btn--small" data-action="send-reminder" data-invite-id="${escapeHtml(inv.inviteId)}">Send reminder</button>`
          : '';
        const editBtn = `<button class="btn btn--ghost btn--small" data-action="edit" data-invite-id="${escapeHtml(inv.inviteId)}">Edit</button>`;
        const deleteBtn = `<button class="btn btn--ghost btn--small admin-btn-danger" data-action="delete" data-invite-id="${escapeHtml(inv.inviteId)}">Delete</button>`;
        const isExpanded = EXPANDED_ID === inv.inviteId;
        const dataRowClasses = ['admin-data-row'];
        if (inv.responded) dataRowClasses.push('is-responded');
        if (isExpanded) dataRowClasses.push('is-expanded');
        return `
          <tr data-invite-id="${escapeHtml(inv.inviteId)}" class="${dataRowClasses.join(' ')}">
            <td><span class="admin-chevron" aria-hidden="true">▸</span>${escapeHtml(idLabel)}${totalCard}${optBadge}${hardBadge}</td>
            <td>${respondedBadge}</td>
            <td>${headcount}</td>
            <td>${phoneCell}${inv.phone ? ` <span class="admin-muted">${escapeHtml(inv.locale)}</span>` : ''}</td>
            <td>${lastReminder}</td>
            <td>${sendBtn} ${editBtn} ${deleteBtn}</td>
          </tr>
          <tr class="admin-detail-row" data-detail-for="${escapeHtml(inv.inviteId)}"${isExpanded ? '' : ' hidden'}>
            <td colspan="6">${buildDetailHtml(row)}</td>
          </tr>
        `;
      }

      function toggleRow(inviteId: string) {
        if (!tbody || !inviteId) return;
        const sel = (typeof CSS !== 'undefined' && CSS.escape) ? CSS.escape(inviteId) : inviteId.replace(/[^a-zA-Z0-9_-]/g, '');
        const wasOpen = EXPANDED_ID === inviteId;
        if (EXPANDED_ID) {
          const prevSel = (typeof CSS !== 'undefined' && CSS.escape) ? CSS.escape(EXPANDED_ID) : EXPANDED_ID.replace(/[^a-zA-Z0-9_-]/g, '');
          const prevData = tbody.querySelector(`tr.admin-data-row[data-invite-id="${prevSel}"]`) as HTMLTableRowElement | null;
          const prevDetail = tbody.querySelector(`tr.admin-detail-row[data-detail-for="${prevSel}"]`) as HTMLTableRowElement | null;
          if (prevData) prevData.classList.remove('is-expanded');
          if (prevDetail) prevDetail.hidden = true;
        }
        if (wasOpen) {
          EXPANDED_ID = null;
          return;
        }
        EXPANDED_ID = inviteId;
        const dataRow = tbody.querySelector(`tr.admin-data-row[data-invite-id="${sel}"]`) as HTMLTableRowElement | null;
        const detailRow = tbody.querySelector(`tr.admin-detail-row[data-detail-for="${sel}"]`) as HTMLTableRowElement | null;
        if (dataRow) dataRow.classList.add('is-expanded');
        if (detailRow) detailRow.hidden = false;
      }

      function buildDetailHtml(row: any): string {
        const inv = row.invite;
        const payload = inv.payload || { primary: {}, additionalGuests: [] };
        const courseLabel = (key: string, value: string): string => {
          const map: Record<string, Record<string, string>> = {
            entradaChoice: { salpicon: 'salpicón', hojaldre: 'hojaldre', causa: 'causa' },
            sorbetChoice: { maracuya: 'maracuyá', mandarina: 'mandarina' },
            mealChoice: { chicken: 'chicken', beef: 'beef' },
            postreChoice: { chocolate: 'chocolate', cheesecake: 'cheesecake', tiramisu: 'tiramisu' }
          };
          return (map[key] && map[key][value]) || value;
        };
        const renderAttendee = (a: any, label: string) => {
          const courses: string[] = [];
          if (a.attending === true) {
            if (a.entradaChoice) courses.push(`entrada: ${escapeHtml(courseLabel('entradaChoice', a.entradaChoice))}`);
            if (a.sorbetChoice) courses.push(`sorbet: ${escapeHtml(courseLabel('sorbetChoice', a.sorbetChoice))}`);
            if (a.mealChoice) courses.push(`meal: ${escapeHtml(courseLabel('mealChoice', a.mealChoice))}`);
            if (a.postreChoice) courses.push(`postre: ${escapeHtml(courseLabel('postreChoice', a.postreChoice))}`);
          }
          return `
          <li>
            <strong>${escapeHtml(label)}</strong>
            — attending: <strong>${a.attending === true ? 'YES' : a.attending === false ? 'NO' : '—'}</strong>
            ${courses.length ? ` · ${courses.join(' · ')}` : ''}
            ${a.dietary ? ` · dietary: ${escapeHtml(a.dietary)}` : ''}
            ${a.songRequest ? ` · song: ${escapeHtml(a.songRequest)}` : ''}
            ${a.notes ? ` · notes: ${escapeHtml(a.notes)}` : ''}
          </li>
        `;
        };
        const primaryLabel = `${inv.primaryFirstName} ${inv.primaryLastName}`.trim();
        const primaryItem = renderAttendee(payload.primary || {}, primaryLabel + ' (primary)');
        const guestItems = (payload.additionalGuests || []).map((g: any) =>
          renderAttendee(g, `${g.name || '(no name)'}${g.isKid ? ' [child]' : ''}`)
        ).join('');
        const smsList = (row.recentSms || []).map((s: any) => `
          <li>
            <span class="admin-muted">${escapeHtml(new Date(s.sentAt).toLocaleString())}</span>
            — ${escapeHtml(s.type)} → <strong>${escapeHtml(s.deliveryStatus)}</strong>${s.errorCode ? ` (${escapeHtml(s.errorCode)})` : ''}
            ${s.bodyLen ? ` · ${s.bodyLen} chars` : ''}
          </li>
        `).join('') || '<li class="admin-muted">No SMS history.</li>';

        const metaBits: string[] = [];
        metaBits.push(`<code>${escapeHtml(inv.inviteId)}</code>`);
        if (inv.respondedAt) metaBits.push(`responded ${escapeHtml(new Date(inv.respondedAt).toLocaleString())}`);
        if (inv.respondedLate) metaBits.push('<span class="admin-badge admin-badge--warn">late</span>');
        if (inv.adminNotes) metaBits.push(`<em>note:</em> ${escapeHtml(inv.adminNotes)}`);

        return `
          <div class="admin-detail-inner">
            <p class="admin-muted admin-detail-meta">${metaBits.join(' · ')}</p>
            <ul class="admin-list">${primaryItem}${guestItems}</ul>
            <h4>Recent SMS</h4>
            <ul class="admin-list admin-list--small">${smsList}</ul>
          </div>
        `;
      }

      // ---- Modal ----
      function openModal(mode: 'create' | 'edit', invite?: any) {
        if (!modalEl || !modalForm || !modalTitleEl) return;
        clearModalError();
        modalForm.reset();
        modalForm.dataset.mode = mode;
        modalForm.dataset.inviteId = invite ? invite.inviteId : '';
        modalTitleEl.textContent = mode === 'create' ? 'New invitation' : `Edit invitation`;
        const get = (n: string) => modalForm.querySelector(`[name="${n}"]`) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
        if (invite) {
          (get('primaryFirstName') as HTMLInputElement).value = invite.primaryFirstName || '';
          (get('primaryLastName') as HTMLInputElement).value = invite.primaryLastName || '';
          (get('phone') as HTMLInputElement).value = invite.phone || '';
          (get('locale') as HTMLSelectElement).value = invite.locale === 'es' ? 'es' : 'en';
          (get('adminNotes') as HTMLTextAreaElement).value = invite.adminNotes || '';
          (get('optedOutOfSms') as HTMLInputElement).checked = !!invite.optedOutOfSms;
          (get('clearHardFail') as HTMLInputElement).checked = false;
          const payloadField = get('payload') as HTMLTextAreaElement;
          payloadField.value = JSON.stringify(invite.payload || {}, null, 2);
          // Stash so the submit handler can detect a real change vs no-op.
          payloadField.dataset.original = payloadField.value;
          if (payloadRow) payloadRow.hidden = false;
        } else {
          (get('locale') as HTMLSelectElement).value = 'en';
          if (payloadRow) payloadRow.hidden = true;
        }
        modalEl.hidden = false;
        document.body.style.overflow = 'hidden';
        (get('primaryFirstName') as HTMLInputElement).focus();
      }
      function closeModal() {
        if (!modalEl) return;
        modalEl.hidden = true;
        document.body.style.overflow = '';
      }
      function showModalError(msg: string) {
        if (!modalErrorEl) return;
        modalErrorEl.textContent = msg;
        modalErrorEl.hidden = false;
      }
      function clearModalError() {
        if (!modalErrorEl) return;
        modalErrorEl.textContent = '';
        modalErrorEl.hidden = true;
      }

      modalEl?.querySelectorAll('[data-modal-close]').forEach((el) => {
        el.addEventListener('click', closeModal);
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && modalEl && !modalEl.hidden) closeModal();
      });

      modalForm?.addEventListener('submit', async (e) => {
        e.preventDefault();
        clearModalError();
        if (!modalSaveBtn) return;
        const mode = modalForm.dataset.mode || 'edit';
        const inviteId = modalForm.dataset.inviteId || '';
        const get = (n: string) => modalForm.querySelector(`[name="${n}"]`) as HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement | null;
        const primaryFirstName = (get('primaryFirstName') as HTMLInputElement).value.trim();
        const primaryLastName = (get('primaryLastName') as HTMLInputElement).value.trim();
        const phone = (get('phone') as HTMLInputElement).value.trim();
        const locale = (get('locale') as HTMLSelectElement).value;
        const adminNotes = (get('adminNotes') as HTMLTextAreaElement).value;
        const optedOutOfSms = (get('optedOutOfSms') as HTMLInputElement).checked;
        const clearHardFail = (get('clearHardFail') as HTMLInputElement).checked;
        if (!primaryFirstName || !primaryLastName) {
          showModalError('Both first and last name are required.');
          return;
        }
        modalSaveBtn.disabled = true;
        const saveLabel = modalSaveBtn.textContent;
        modalSaveBtn.textContent = 'Saving…';
        try {
          if (mode === 'create') {
            const res = await fetch('/api/mgmt/create-invite', {
              method: 'POST', credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ primaryFirstName, primaryLastName, phone, locale, adminNotes })
            });
            if (!res.ok) {
              const data = await res.json().catch(() => ({}));
              showModalError(`Create failed (${res.status}): ${data.error || ''}`);
              return;
            }
            closeModal();
            setStatus('Invitation created.', 'ok');
          } else {
            const patch: any = { primaryFirstName, primaryLastName, phone, locale, adminNotes, optedOutOfSms };
            if (clearHardFail) patch.smsHardFailedAt = '';
            // Only include payload in the patch if it actually changed vs.
            // the in-form snapshot. The server treats payload edits as a
            // "may recompute responded" signal — sending the same payload
            // on a no-op nudge could flip an already-responded invite.
            const payloadField = get('payload') as HTMLTextAreaElement;
            const raw = (payloadField.value || '').trim();
            const original = (payloadField.dataset.original || '').trim();
            if (raw && raw !== original) {
              try {
                patch.payload = JSON.parse(raw);
              } catch {
                showModalError('Payload JSON is not valid. Fix or clear the field to skip the payload update.');
                return;
              }
            }
            // Warn before changing the primary name — old session cookies
            // and magic links can no longer be invalidated, and would still
            // unlock this invitation under the new name. Recommended
            // workflow: delete + create instead of rename.
            const editingInvite = LAST_DATA?.rows.find((r: any) => r.invite.inviteId === inviteId)?.invite;
            if (editingInvite && (editingInvite.primaryFirstName !== primaryFirstName || editingInvite.primaryLastName !== primaryLastName)) {
              if (!confirm(`You're renaming the primary invitee.\n\nFROM: ${editingInvite.primaryFirstName} ${editingInvite.primaryLastName}\nTO:   ${primaryFirstName} ${primaryLastName}\n\nAny existing session cookie or magic link for this invitation will continue to work and would let the previous primary open the new person's RSVP. If this is a re-assignment to a different real person, click Cancel and use Delete + New invitation instead.\n\nContinue with the rename?`)) {
                return;
              }
            }
            const res = await fetch('/api/mgmt/update-invite', {
              method: 'POST', credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ inviteId, patch })
            });
            if (!res.ok) {
              const data = await res.json().catch(() => ({}));
              showModalError(`Update failed (${res.status}): ${data.error || ''}${data.detail ? ' · ' + data.detail : ''}`);
              return;
            }
            closeModal();
            setStatus('Invitation updated.', 'ok');
          }
          await loadGuests();
        } catch (err: any) {
          showModalError(`Request failed: ${err && err.message}`);
        } finally {
          modalSaveBtn.disabled = false;
          if (saveLabel) modalSaveBtn.textContent = saveLabel;
        }
      });

      async function onActionClick(ev: Event) {
        const btn = ev.currentTarget as HTMLButtonElement;
        const action = btn.dataset.action || '';
        const inviteId = btn.dataset.inviteId || '';
        const inviteRow = LAST_DATA?.rows.find((r: any) => r.invite.inviteId === inviteId);
        const invite = inviteRow ? inviteRow.invite : null;
        if (action === 'edit') {
          if (invite) openModal('edit', invite);
          return;
        }
        if (action === 'delete') {
          const name = invite ? `${invite.primaryFirstName} ${invite.primaryLastName}`.trim() : inviteId;
          if (!confirm(`Permanently delete the invitation for "${name}"? This also deletes the SMS log for this invite.`)) return;
          const original = btn.textContent;
          btn.disabled = true; btn.textContent = '…';
          try {
            const res = await fetch('/api/mgmt/delete-invite', {
              method: 'POST', credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ inviteId })
            });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) { setStatus(`Delete failed (${res.status}): ${data.error || ''}`, 'warn'); }
            else { setStatus(`Deleted (${data.smsRowsDeleted || 0} SMS rows removed).`, 'ok'); }
          } catch (e: any) {
            setStatus(`Delete failed: ${e && e.message}`, 'warn');
          } finally {
            btn.disabled = false; btn.textContent = original;
            await loadGuests();
          }
          return;
        }
        if (action === 'send-reminder') {
          if (!confirm('Send an SMS reminder to this invite now (bypasses 30-day cadence)?')) return;
          const original = btn.textContent;
          btn.disabled = true; btn.textContent = '…';
          try {
            const res = await fetch('/api/mgmt/send-reminder', {
              method: 'POST', credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ inviteId, force: true })
            });
            const data = await res.json().catch(() => ({}));
            if (res.ok && data.sent) {
              setStatus(`Sent (${data.segmentCount || '?'} segments, ${data.bodyLen || '?'} chars).`, 'ok');
            } else {
              const reason = (data && (data.reason || data.skipped || data.errorCode)) || `HTTP ${res.status}`;
              setStatus(`Skipped: ${reason}`, 'warn');
            }
          } catch (e: any) {
            setStatus(`Send failed: ${e && e.message}`, 'warn');
          } finally {
            btn.disabled = false; btn.textContent = original;
            await loadGuests();
          }
        }
      }

      document.getElementById('btn-refresh')?.addEventListener('click', async (ev) => {
        const btn = ev.currentTarget as HTMLButtonElement;
        const orig = btn.textContent || 'Refresh';
        btn.disabled = true;
        btn.textContent = 'Refreshing…';
        await Promise.all([loadGuests(), loadEvents()]);
        btn.textContent = '✓ Updated';
        window.setTimeout(() => {
          if (btn.textContent === '✓ Updated') {
            btn.textContent = orig;
            btn.disabled = false;
          }
        }, 1200);
      });
      document.getElementById('btn-create-invite')?.addEventListener('click', () => openModal('create'));

      const sendTestBtn = document.getElementById('btn-send-test');
      sendTestBtn?.addEventListener('click', async () => {
        const phone = window.prompt('Phone number to text (E.164 or 10 digits US):');
        if (!phone) return;
        const locale = window.prompt('Locale? "en" or "es" (default en):', 'en') || 'en';
        try {
          const res = await fetch('/api/mgmt/send-test', {
            method: 'POST', credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ phone, locale })
          });
          const data = await res.json();
          if (data.successful) {
            setStatus(`Test SMS sent (id=${data.messageId}, ${data.segmentCount} seg, ${data.bodyLen} chars).`, 'ok');
          } else {
            setStatus(`Test SMS failed: ${data.errorCode || data.error || 'unknown'} ${data.errorMessage || ''}`, 'warn');
          }
        } catch (e: any) {
          setStatus(`Test SMS failed: ${e && e.message}`, 'warn');
        }
      });

      if (remindersChk) {
        remindersChk.addEventListener('change', async () => {
          const next = remindersChk.checked;
          remindersChk.disabled = true;
          try {
            const res = await fetch('/api/mgmt/toggle-reminders', {
              method: 'POST', credentials: 'same-origin',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ enabled: next })
            });
            if (!res.ok) {
              setStatus(`Toggle failed (HTTP ${res.status})`, 'warn');
              remindersChk.checked = !next;
            } else {
              setStatus(next ? 'Reminders enabled.' : 'Reminders disabled.', 'ok');
            }
          } catch (e: any) {
            setStatus(`Toggle failed: ${e && e.message}`, 'warn');
            remindersChk.checked = !next;
          } finally {
            remindersChk.disabled = false;
          }
        });
      }

      (async () => {
        const ok = await ensureAuthed();
        if (!ok) return;
        await Promise.all([loadGuests(), loadEvents()]);
      })();
    })();
  </script>

  <style is:global>
