    .admin-diff-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.6rem; }
    .admin-diff-entry {
      border: 1px solid var(--color-rule, #e3dccb);
      border-left-width: 4px;
      border-radius: var(--radius-sm, 4px);
      padding: 0.55rem 0.7rem;
      background: #fcfbf6;
    }
    .admin-diff-entry--added { border-left-color: #4a7d4a; }
    .admin-diff-entry--changed { border-left-color: #8a6a2c; }
    .admin-diff-entry--removed { border-left-color: #b04848; background: #faf0f0; }
    .admin-diff-entry--destructive { background: #faf0f0; }
    .admin-diff-entry-head {
      display: flex; align-items: center; gap: 0.5rem;
      margin-bottom: 0.3rem; font-size: 0.95rem;
    }
    .admin-diff-badge {
      display: inline-block;
      font-size: 0.7rem; font-weight: 700; letter-spacing: 0.05em;
      padding: 0.1rem 0.4rem; border-radius: 999px;
      background: rgba(0,0,0,0.06); color: #555;
    }
    .admin-diff-entry--added .admin-diff-badge { background: #e2efe2; color: #366336; }
    .admin-diff-entry--changed .admin-diff-badge { background: #f3eacb; color: #6a5212; }
    .admin-diff-entry--removed .admin-diff-badge { background: #f3d6d6; color: #7e2929; }
    .admin-diff-changes { margin: 0 0 0 1.1rem; padding: 0; font-size: 0.88rem; line-height: 1.45; }
    .admin-diff-changes li { margin: 0.1rem 0; }

    /* Bulk-import card */
    .bulk-help { margin-top: 0.4rem; margin-bottom: 0.6rem; }
    .bulk-help code {
      background: rgba(201, 169, 97, 0.12);
      padding: 0 0.25rem;
      border-radius: 2px;
      font-size: 0.9em;
      font-family: ui-monospace, Menlo, Consolas, monospace;
    }
    .bulk-controls { align-items: center; gap: 0.6rem; }
    .bulk-controls input[type="file"] { font-size: 0.9rem; }
    .bulk-summary {
      display: flex;
      gap: 0.4rem;
      flex-wrap: wrap;
      margin: 0.6rem 0;
      align-items: center;
      color: var(--color-text-muted, #888);
      font-size: 0.85rem;
    }
    .bulk-stat {
      display: inline-block;
      padding: 0.15rem 0.55rem;
      border-radius: 999px;
      font-size: 0.8rem;
      font-weight: 600;
      background: rgba(0, 0, 0, 0.06);
      color: var(--color-text);
    }
    .bulk-stat--create { background: rgba(80, 160, 80, 0.18); color: #2a6a2a; }
    .bulk-stat--update { background: rgba(201, 169, 97, 0.22); color: var(--color-gold-deep, #8a6a2c); }
    .bulk-stat--skip { background: rgba(160, 160, 160, 0.2); color: #555; }
    .bulk-stat--error { background: rgba(200, 60, 60, 0.16); color: #8a2c2c; }
    .bulk-preview-table { font-size: 0.88rem; }
    .bulk-preview-table th, .bulk-preview-table td { padding: 0.35rem 0.5rem; }
    .bulk-action { font-size: 0.85rem; }
    .bulk-action--create { color: #2a6a2a; font-weight: 600; }
    .bulk-action--update { color: var(--color-gold-deep, #8a6a2c); font-weight: 600; }
    .bulk-action--skip { color: #888; }
    .bulk-action--error { color: #8a2c2c; font-weight: 600; }
    .bulk-action--pending { color: #999; font-style: italic; }
    .bulk-rsvp-note { color: #2a6a2a; font-style: italic; font-size: 0.8rem; margin-left: 0.3rem; }

    /* ============================================================
       Mobile responsive layer (admin)
       ============================================================
       Two-tier approach:
       - Tier 1 polish: tighten card headers, action button rows,
         events feed, and modal margins for narrow viewports.
       - Tier 2 cards: collapse the Invitations table into a
         card-per-invite layout below 720px so it reads naturally
         on phones without horizontal scrolling. The expand /
         collapse + detail-row logic stays untouched -- only the
         visual layout changes via display:block + ::before labels.
       The bulk-preview table intentionally stays as horizontal
       scroll: it is a one-time-glance flow, not a primary surface.
    */
    @media (max-width: 48rem) {
      /* Tier 1 polish */
      .admin { padding: var(--space-3) 0; }
      .admin .container { padding-left: 1rem; padding-right: 1rem; }
      .admin-header { flex-direction: column; align-items: stretch; gap: 0.5rem; }
      .admin-card { padding: var(--space-2); }
      .admin-card-header {
        flex-direction: column;
        align-items: stretch;
        gap: 0.6rem;
      }
      .admin-card-actions {
        flex-wrap: wrap;
        gap: 0.4rem;
      }
      .admin-card-actions .btn { flex: 1 1 auto; justify-content: center; min-height: 40px; }
      .admin-row.bulk-controls { gap: 0.4rem; }
      .admin-row.bulk-controls .btn { flex: 1 1 auto; justify-content: center; min-height: 40px; }
      .admin-row.bulk-controls input[type="file"] { width: 100%; }

      /* Events feed: keep our existing breakpoint working but make
         the badges + actor wrap a bit tighter at very small widths. */
      .admin-event { padding: 0.6rem 0.7rem; }

      /* Modal: respect iOS safe-area + give a bit more breathing room. */
      .admin-modal {
        padding: var(--space-2);
        padding-bottom: calc(var(--space-2) + env(safe-area-inset-bottom, 0px));
      }
      .admin-modal-panel { max-height: calc(100dvh - 2rem); }
      .admin-modal-actions { flex-wrap: wrap; justify-content: stretch; }
      .admin-modal-actions .btn { flex: 1 1 auto; min-height: 40px; }
    }

    /* Tier 2: card-per-invite layout for the main Invitations table. */
    @media (max-width: 45rem) {
      .admin-table-wrap { overflow-x: visible; }
      #admin-table { display: block; width: 100%; }
      #admin-table thead { display: none; }
      #admin-table tbody { display: block; }
      #admin-table tbody > tr { display: block; }

      #admin-table tr.admin-data-row {
        position: relative;
        background: #fff;
        border: 1px solid var(--color-rule, #e8e0c8);
        border-radius: var(--radius-md, 8px);
        padding: 0.65rem 0.85rem 0.55rem;
        margin: 0 0 0.6rem;
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.03);
      }
      #admin-table tr.admin-data-row.is-responded {
        background: rgba(80, 160, 80, 0.04);
        border-color: rgba(80, 160, 80, 0.35);
      }
      #admin-table tr.admin-data-row.is-expanded {
        background: rgba(201, 169, 97, 0.10);
        border-color: var(--color-gold-deep, #8a6a2c);
        box-shadow: 0 2px 6px rgba(138, 106, 44, 0.18);
      }
      #admin-table tr.admin-data-row.is-expanded > td:first-child {
        box-shadow: none; /* the inset gold stripe doesn't apply in card mode */
      }

      #admin-table tr.admin-data-row > td {
        display: flex;
        justify-content: space-between;
        align-items: baseline;
        gap: 0.75rem;
        padding: 0.32rem 0;
        border-bottom: 1px dashed rgba(0, 0, 0, 0.06);
        text-align: right;
      }
      #admin-table tr.admin-data-row > td:last-child { border-bottom: 0; }
      #admin-table tr.admin-data-row > td::before {
        content: attr(data-label);
        flex: 0 0 auto;
        font-size: 0.72rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--color-text-muted, #888);
        text-align: left;
      }

      /* Primary cell: act as a card header -- name large, label hidden,
         chevron pinned right so the whole "card top" reads as a tappable
         row. */
      #admin-table tr.admin-data-row > td.admin-cell--primary {
        flex-direction: row-reverse;
        justify-content: flex-end;
        gap: 0.5rem;
        align-items: center;
        padding: 0.1rem 0 0.55rem;
        margin-bottom: 0.15rem;
        border-bottom: 1px solid var(--color-rule, #e8e0c8);
        font-size: 1rem;
        font-weight: 600;
        text-align: left;
      }
      #admin-table tr.admin-data-row > td.admin-cell--primary::before {
        content: ""; /* drop the "Primary invitee" label -- the name itself is the header */
        display: none;
      }
      #admin-table tr.admin-data-row > td.admin-cell--primary .admin-chevron {
        margin-left: auto;
        margin-right: 0;
        font-size: 1rem;
      }

      /* Actions cell: full-width row of buttons, stretched + tappable. */
      #admin-table tr.admin-data-row > td.admin-cell--actions {
        flex-direction: column;
        align-items: stretch;
        gap: 0.4rem;
        padding-top: 0.55rem;
        margin-top: 0.15rem;
        border-top: 1px solid var(--color-rule, #e8e0c8);
      }
      #admin-table tr.admin-data-row > td.admin-cell--actions::before {
        align-self: flex-start;
      }
      #admin-table tr.admin-data-row > td.admin-cell--actions .btn {
        margin: 0;
        flex: 1 1 auto;
        justify-content: center;
        min-height: 40px;
      }

      /* Detail row: detach from the data-row card and present as its own
         pad below. The grid system gives us colspan=6 here; force the
         single td to fill the block. */
      #admin-table tr.admin-detail-row { margin: -0.6rem 0 0.7rem; }
      #admin-table tr.admin-detail-row > td {
        display: block;
        padding: 0;
        box-shadow: none;
        background: #faf3e0;
        border: 1px solid var(--color-gold-deep, #8a6a2c);
        border-top: 0;
        border-radius: 0 0 var(--radius-md, 8px) var(--radius-md, 8px);
      }
      #admin-table tr.admin-detail-row > td .admin-detail-inner {
        padding: 0.85rem 0.95rem 0.9rem;
      }

      /* Loading and empty-state pseudo-rows: keep them simple, no card chrome. */
      #admin-table tbody > tr:not(.admin-data-row):not(.admin-detail-row) {
        display: block;
        text-align: center;
        padding: 0.85rem 0;
      }
      #admin-table tbody > tr:not(.admin-data-row):not(.admin-detail-row) > td {
        display: block;
        border: 0;
        padding: 0;
      }
    }
  </style>
</Base>
