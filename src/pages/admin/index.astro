    @media (min-width: 32rem) { .admin-form-row--two { grid-template-columns: 1fr 1fr; } }
    .admin-form-row--checks { display:flex; gap: 1rem; flex-wrap: wrap; border: 0; padding: 0; margin: 0; }
    .admin-inline { display:inline-flex; align-items: center; gap: 0.4rem; font-size: 0.95rem; }
