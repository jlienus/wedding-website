    .admin-list { padding-left: 1.25rem; }
    .admin-list li { margin-bottom: 0.4rem; }
    .admin-list--small li { margin-bottom: 0.2rem; font-size: 0.9rem; }
    code { background: rgba(0,0,0,0.04); padding: 1px 4px; border-radius: 3px; }

    /* Recent activity panel */
    .admin-events-wrap {
      max-height: 360px;
      overflow-y: auto;
      border: 1px solid var(--color-rule, #e8e0c8);
      border-radius: var(--radius-sm, 4px);
      background: rgba(252, 251, 247, 0.6);
    }
    .admin-events { list-style: none; padding: 0; margin: 0; font-size: 0.9rem; }
