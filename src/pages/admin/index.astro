    .admin-muted { color: var(--color-text-muted, #888); font-size: 0.85rem; }
    .admin-loading { text-align:center; padding: var(--space-3); color: var(--color-text-muted, #888); }
    .admin-badge { display:inline-block; padding: 0.1rem 0.4rem; border-radius: 999px; font-size: 0.75rem; }
    .admin-badge--warn { background: rgba(200,60,60,0.12); color: #8a2c2c; }
    .admin-badge--ok { background: rgba(80, 160, 80, 0.12); color: #2a6a2c; }
    .admin-error {
      margin: var(--space-2) 0;
      padding: 0.5rem 0.75rem;
