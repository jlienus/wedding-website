---
import Base from '../../../layouts/Base.astro';
import type { Locale } from '../../../lib/i18n';
const locale: Locale = 'en';
---

<Base title="Admin sign-in · John & Diana" description="Admin sign-in confirmation" lang={locale}>
  <main class="admin admin-confirm">
    <section class="container container--narrow">
      <header class="admin-confirm-header">
        <h1>Admin sign-in</h1>
      </header>

      <article class="admin-card admin-confirm-card">
        <p id="login-instructions" class="admin-confirm-instructions">
          Click <strong>Sign in</strong> to finish signing in.
        </p>

        <div class="admin-confirm-actions">
          <button id="confirm-btn" class="btn btn--gold">Sign in</button>
          <a href="/admin" class="admin-confirm-cancel rsvp-link">Cancel</a>
        </div>

        <div id="login-status" class="admin-status admin-confirm-status" role="status" aria-live="polite"></div>
      </article>
    </section>
  </main>

  <style>
    .admin-confirm .container { max-width: 26rem; }
    .admin-confirm-header { text-align: center; margin-bottom: var(--space-3); }
    .admin-confirm-header h1 { margin: 0; }
    .admin-confirm-card {
      background: #fff;
      border: 1px solid var(--color-rule, #e8e0c8);
      border-radius: var(--radius-md, 8px);
      padding: var(--space-3);
      display: flex;
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }
    .admin-confirm-instructions { margin: 0; }
    .admin-confirm-actions {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0.6rem;
    }
    .admin-confirm-actions .btn { width: 100%; justify-content: center; }
    .admin-confirm-cancel { align-self: center; font-size: 0.85rem; }
    .admin-confirm-status:empty { display: none; }
    .admin-confirm-status { margin: 0; }
    .admin-confirm-status[data-tone="error"] { color: #8a2c2c; }
    .admin-confirm-status[data-tone="ok"] { color: #2a6a2c; }

    /* In-button activity indicator (3 bouncing dots) -- matches the gate. */
    .btn-spinner {
      display: inline-flex;
      gap: 0.28em;
      align-items: center;
      line-height: 1;
      vertical-align: -0.1em;
    }
    .btn-spinner > span {
      width: 0.42em;
      height: 0.42em;
      border-radius: 50%;
      background: currentColor;
      animation: btn-spinner-pulse 1.1s ease-in-out infinite both;
    }
    .btn-spinner > span:nth-child(2) { animation-delay: 0.18s; }
    .btn-spinner > span:nth-child(3) { animation-delay: 0.36s; }
    @keyframes btn-spinner-pulse {
      0%, 80%, 100% { transform: scale(0.55); opacity: 0.5; }
      40% { transform: scale(1); opacity: 1; }
    }
    @media (prefers-reduced-motion: reduce) {
      .btn-spinner > span { animation-duration: 2.4s; }
    }
  </style>

  <script>
    (function () {
      const btn = document.getElementById('confirm-btn') as HTMLButtonElement | null;
      const status = document.getElementById('login-status') as HTMLDivElement | null;
      const instructions = document.getElementById('login-instructions') as HTMLParagraphElement | null;
      if (!btn || !status || !instructions) return;

      const params = new URLSearchParams(location.search);
      const token = params.get('t') || '';

      if (!token) {
        instructions.hidden = true;
        btn.disabled = true;
        status.textContent = 'This link is missing its token. Request a new sign-in email from the admin page.';
        status.dataset.tone = 'error';
        return;
      }

      btn.addEventListener('click', async () => {
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.setAttribute('aria-busy', 'true');
        btn.innerHTML = '<span class="btn-spinner" aria-hidden="true"><span></span><span></span><span></span></span><span>Signing you in\u2026</span>';
        status.textContent = '';
        status.dataset.tone = '';
        try {
          const res = await fetch('/api/mgmt/admin-login-verify', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin',
            cache: 'no-store',
            body: JSON.stringify({ t: token })
          });
          let data: any = null;
          try { data = await res.json(); } catch {}
          if (res.ok && data && data.ok) {
            status.textContent = 'Signed in. Redirecting\u2026';
            status.dataset.tone = 'ok';
            const target = (data && typeof data.redirect === 'string') ? data.redirect : '/admin';
            // Use replace so the spent magic-link URL never lands in browser history.
            location.replace(target);
            return;
          }
          const code = (data && typeof data.error === 'string') ? data.error : '';
          let msg = 'That sign-in link couldn\u2019t be used.';
          if (code === 'replayed') msg = 'That sign-in link was already used. Request a new one from the admin page.';
          else if (code === 'expired') msg = 'That sign-in link expired. Request a new one from the admin page.';
          else if (code === 'rate_limited') msg = 'Too many sign-in attempts. Try again in a minute.';
          else if (code === 'invalid') msg = 'That sign-in link is invalid or expired. Request a new one from the admin page.';
          status.textContent = msg;
          status.dataset.tone = 'error';
          btn.innerHTML = originalHtml;
          btn.removeAttribute('aria-busy');
          // Token is spent/invalid on the server side — keep the button disabled
          // so the user can't burn rate-limit budget retrying a dead token.
          btn.disabled = true;
        } catch (err: any) {
          status.textContent = `Couldn\u2019t reach the sign-in service: ${err && err.message ? err.message : 'unknown error'}.`;
          status.dataset.tone = 'error';
          btn.innerHTML = originalHtml;
          btn.removeAttribute('aria-busy');
          // Network error — token may still be usable, allow retry.
          btn.disabled = false;
        }
      });
    })();
  </script>
</Base>
