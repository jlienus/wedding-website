---
import Base from '../layouts/Base.astro';
import VenueCard from '../components/VenueCard.astro';
import PhotoPair from '../components/PhotoPair.astro';
import MenuSection from '../components/MenuSection.astro';
import CocktailMenu from '../components/CocktailMenu.astro';
import SectionDivider from '../components/SectionDivider.astro';
import { t, type Locale } from '../lib/i18n';
import venues from '../data/venues.json';
import config from '../data/wedding.config.json';

const locale: Locale = 'en';
const hashtag = config.social.hashtag;

const ceremonyPhotos = [
  {
    src: '/images/basilica-aisle.jpg',
    altEn: t(locale, 'venues.aisleAlt'),
    altEs: t('es', 'venues.aisleAlt'),
    captionEn: t(locale, 'venues.aisleCaption'),
    captionEs: t('es', 'venues.aisleCaption'),
  },
  {
    src: '/images/basilica-nave.jpg',
    altEn: t(locale, 'venues.naveAlt'),
    altEs: t('es', 'venues.naveAlt'),
    captionEn: t(locale, 'venues.naveCaption'),
    captionEs: t('es', 'venues.naveCaption'),
  },
  {
    src: '/images/basilica-rose-window.jpg',
    altEn: t(locale, 'venues.roseWindowAlt'),
    altEs: t('es', 'venues.roseWindowAlt'),
    captionEn: t(locale, 'venues.roseWindowCaption'),
    captionEs: t('es', 'venues.roseWindowCaption'),
  },
];

const receptionPhotos = [
  {
    src: '/images/reception-ballroom.jpg',
    altEn: t(locale, 'venues.ballroomAlt'),
    altEs: t('es', 'venues.ballroomAlt'),
    captionEn: t(locale, 'venues.ballroomCaption'),
    captionEs: t('es', 'venues.ballroomCaption'),
  },
  {
    src: '/images/reception-table.jpg',
    altEn: t(locale, 'venues.tableAlt'),
    altEs: t('es', 'venues.tableAlt'),
    captionEn: t(locale, 'venues.tableCaption'),
    captionEs: t('es', 'venues.tableCaption'),
  },
];
---

<Base title={t(locale, 'venues.heading') + ' · John & Diana'} description={t(locale, 'venues.walkingText')} lang={locale}>
  <main>
    <section class="section container container--narrow reveal" style="text-align:center;">
      <p class="eyebrow">{t(locale, 'home.detailsEyebrow')}</p>
      <h1>{t(locale, 'venues.heading')}</h1>
      <p>{t(locale, 'venues.walkingText')}</p>
      <nav class="page-anchors" aria-label={t(locale, 'venues.onThisPage')}>
        <a href="#ceremony">{t(locale, 'venues.ceremonyHeading')}</a>
        <span class="page-anchors__sep" aria-hidden="true">·</span>
        <a href="#reception">{t(locale, 'venues.receptionHeading')}</a>
        <span class="page-anchors__sep" aria-hidden="true">·</span>
        <a href="#dining">{t(locale, 'venues.anchorDining')}</a>
      </nav>
    </section>
    <section id="ceremony" class="section container reveal">
      <h2>{t(locale, 'venues.ceremonyHeading')}</h2>
      <VenueCard venue={venues.ceremony} locale={locale} />
      <PhotoPair photos={ceremonyPhotos} locale={locale} />
    </section>
    <SectionDivider />
    <section id="reception" class="section container reveal">
      <h2>{t(locale, 'venues.receptionHeading')}</h2>
      <VenueCard venue={venues.reception} locale={locale} />
      <PhotoPair photos={receptionPhotos} locale={locale} />
      <div id="dining">
        <CocktailMenu locale={locale} />
        <MenuSection locale={locale} />
      </div>
    </section>
    <section class="section container container--narrow reveal">
      <aside class="hashtag-callout">
        <p class="hashtag-label">📸 {t(locale, 'venues.hashtagCalloutHeading')}</p>
        <p class="hashtag-tag">{hashtag}</p>
        <p class="hashtag-body">{t(locale, 'venues.hashtagCalloutBody')}</p>
      </aside>
    </section>
    <p class="container container--narrow reveal" style="text-align:center; color: var(--color-text-muted);"><em>{t(locale, 'venues.shuttleDisclaimer')}</em></p>
  </main>
</Base>

<style>
  .hashtag-callout {
    margin: 0 auto;
    padding: var(--space-4) var(--space-3);
    text-align: center;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: var(--gradient-surface);
    box-shadow: var(--shadow-sm);
  }
  .hashtag-label { font-size: var(--fs-tiny); letter-spacing: 0.18em; text-transform: uppercase; color: var(--color-gold-deep); margin: 0; }
  .hashtag-tag { font-family: var(--font-display); font-size: clamp(1.5rem, 3.5vw, 2.25rem); color: var(--color-gold-deep); margin: var(--space-2) 0; letter-spacing: 0.02em; }
  .hashtag-body { color: var(--color-text-muted); margin: 0; font-style: italic; }

  .page-anchors {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.65rem;
    margin: var(--space-3) auto 0;
    padding: 0.65rem 1.25rem;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }
  .page-anchors a {
    border: 0;
    font-size: var(--fs-tiny);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-text);
    padding: 0.1rem 0;
    transition: color var(--transition);
  }
  .page-anchors a:hover, .page-anchors a:focus-visible { color: var(--color-gold-deep); }
  .page-anchors__sep { color: var(--color-gold); opacity: 0.7; font-size: var(--fs-tiny); }

  /* Anchor targets — leave room for the sticky header on jump */
  #ceremony, #reception, #dining { scroll-margin-top: 5.5rem; }
</style>


