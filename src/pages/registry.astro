---
import Base from '../layouts/Base.astro';
import RegistryCard from '../components/RegistryCard.astro';
import PageHero from '../components/PageHero.astro';
import { t, type Locale } from '../lib/i18n';

const locale: Locale = 'en';
---

<Base title={t(locale, 'registry.heading') + ' · John & Diana'} description={t(locale, 'registry.intro')} lang={locale}>
  <main>
    <PageHero photoSlot="registry-hero.jpg" imageAlt={t(locale, 'registry.heroAlt')}>
      <p class="eyebrow">{t(locale, 'nav.registry')}</p>
      <h1>{t(locale, 'registry.heading')}</h1>
      <p>{t(locale, 'registry.intro')}</p>
    </PageHero>
    <section class="section section--tight container reveal">
      <RegistryCard locale={locale} />
    </section>
    <section class="section section--tight container container--narrow reveal">
      <aside class="dev-callout-card">
        <p class="eyebrow">{t(locale, 'registry.developerCallout.eyebrow')}</p>
        <h2>{t(locale, 'registry.developerCallout.heading')}</h2>
        <p>{t(locale, 'registry.developerCallout.body')}</p>
        <p>
          <a class="dev-callout-cta" href="https://github.com/jlienus/wedding-website" target="_blank" rel="noopener noreferrer">
            <svg class="dev-callout-cta__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
            </svg>
            {t(locale, 'registry.developerCallout.cta')}
          </a>
        </p>
      </aside>
    </section>
  </main>
</Base>

<style>
  .dev-callout-card {
    padding: var(--space-3);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, rgba(201,169,97,0.06) 0%, rgba(247,244,237,0.6) 100%);
    box-shadow: var(--shadow-sm);
  }
  .dev-callout-card .eyebrow {
    font-size: var(--fs-tiny);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-gold-deep);
    margin-bottom: 0.5rem;
  }
  .dev-callout-card h2 { margin-top: 0; margin-bottom: var(--space-2); font-size: 1.4rem; }
  .dev-callout-card p { color: var(--color-text-muted); }
  .dev-callout-cta {
    color: var(--color-gold-deep);
    font-weight: 600;
    border-bottom: 1px solid currentColor;
    text-decoration: none;
  }
  .dev-callout-cta__icon {
    display: inline-block;
    width: 1em;
    height: 1em;
    vertical-align: -0.18em;
    margin-right: 0.4em;
  }
  .dev-callout-cta:hover { color: var(--color-text); }
</style>

